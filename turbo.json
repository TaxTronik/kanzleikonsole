{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_APP_URL",
    "DATABASE_CONNECTION_LIMIT",
    "REDIS_URL",
    "AUTH_SECRET",
    "SECRET_BOX_KEY",
    "NEXTAUTH_URL",
    "NEXTAUTH_TRUST_HOST",
    "TRUST_PROXY_REQUIRED",
    "PORTAL_PUBLIC_URL",
    "STAFF_COOKIE_DOMAIN",
    "PORTAL_COOKIE_DOMAIN",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_REGION",
    "S3_BUCKET_GOBD",
    "S3_BUCKET_GWG",
    "S3_BUCKET_GENERAL",
    "S3_BUCKET_STAFF_PRIVATE",
    "S3_BUCKET_BACKUPS",
    "CLAMAV_HOST",
    "CLAMAV_PORT",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM",
    "OPS_ALERT_EMAIL",
    "N8N_WEBHOOK_BASE_URL",
    "N8N_HMAC_SECRET",
    "N8N_DELIVERY_MODE",
    "RISK_LAYER_URL",
    "RISK_LAYER_TOKEN",
    "ELSTER_BRIDGE_URL",
    "ELSTER_BRIDGE_TOKEN",
    "INTERNAL_FETCH_HOSTS",
    "TIMESTAMP_AUTHORITY_URL",
    "LICENSE_KEY",
    "LICENSE_PUBLIC_KEY",
    "UPDATE_MANIFEST_URL",
    "UPDATE_PUBLIC_KEY",
    "LOG_LEVEL",
    "DEV_SKIP_TOTP",
    "APP_VERSION",
    "GIT_SHA",
    "BACKUP_LOCAL_DIR",
    "BACKUP_OUT_FILE",
    "PG_DUMP_PATH",
    "PG_RESTORE_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
