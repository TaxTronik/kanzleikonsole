# =============================================================================
# Beispiel-NGINX-Konfiguration für taxtronik
#
# Annahmen:
#   - taxtronik-app läuft auf 127.0.0.1:3000 (Default seit P-4)
#   - optional: n8n-UI läuft auf 127.0.0.1:5678
#   - TLS-Zertifikat in /etc/letsencrypt/live/<domain>/...
#   - Single-Host-Setup (kein Multi-Subdomain) — für Subdomain-Trennung siehe
#     docs/operations/subdomain-trennung.md
#
# Diese Datei beantwortet die Findings aus dem Pen-Test-Skelett:
#  - H-2: korrektes X-Forwarded-For (Client-supplied Header wird gestrippt)
#  - R-2: NEXTAUTH_TRUST_HOST + Host-Header-Filterung
#  - K-2: Security-Header (HSTS, XFO, XCTO, Referrer-Policy) setzt die APP —
#    nginx reicht sie nur durch (siehe Kommentar im vhost unten)
#  - V-2: Rate-Limit auf /api/health gegen DoS-Polling
# =============================================================================

upstream taxtronik_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

# Optional, wenn die n8n-UI über einen eigenen VHost veröffentlicht werden soll.
# App/Worker erreichen n8n im Compose-Netz üblicherweise direkt über
# http://n8n:5678/webhook; dieser Upstream ist nur für Browser-Zugriff auf die
# n8n-Oberfläche gedacht.
upstream taxtronik_n8n {
    server 127.0.0.1:5678;
    keepalive 16;
}

# -----------------------------------------------------------------------------
# Rate-Limit-Zones — vor dem virtual host definiert.
# -----------------------------------------------------------------------------
limit_req_zone $binary_remote_addr zone=taxtronik_health:1m rate=20r/s;
limit_req_zone $binary_remote_addr zone=taxtronik_login:1m rate=5r/s;
limit_req_zone $binary_remote_addr zone=taxtronik_api:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=taxtronik_upload_per_ip:10m;
# Konstanter VHost-Key: schützt den einzelnen 2-GiB-App-Container zusätzlich
# vor vielen parallelen Quell-IPs.
limit_conn_zone $server_name zone=taxtronik_upload_global:1m;

# -----------------------------------------------------------------------------
# HTTP → HTTPS-Redirect
# -----------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name kanzlei.example.com;

    # ACME-Challenge für Let's Encrypt durchlassen
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        # Kein client-kontrolliertes $host in Redirects verwenden.
        return 301 https://$server_name$request_uri;
    }
}

# -----------------------------------------------------------------------------
# Haupt-Vhost (HTTPS)
# -----------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kanzlei.example.com;

    # ---- TLS ----
    ssl_certificate     /etc/letsencrypt/live/kanzlei.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kanzlei.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # OCSP-Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 9.9.9.9 valid=60s;

    # ---- Body-Limit (25 MiB Nutzlast + Multipart-Overhead) ----
    client_max_body_size 26M;
    # Vorab-Buffer für Form-Submits klein halten, damit kleine Requests
    # nicht auf die Disk gehen.
    client_body_buffer_size 16k;

    # ---- H-2/R-2: X-Forwarded-For sauber befüllen ----
    # client-supplied XFF-Header IGNORIEREN — Node-App liest x-forwarded-for
    # via getClientIp und vertraut dem nur wenn TRUST_PROXY_REQUIRED=true.
    # NGINX überschreibt den Header und hängt nur $remote_addr an.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP       $remote_addr;
    # Auth.js benötigt trustHost=true. Deshalb Host und X-Forwarded-Host auf
    # den konfigurierten VHost pinnen, nie den client-kontrollierten $host
    # weiterreichen (sonst Callback-Umleitung/Host-Smuggling, S-9).
    proxy_set_header Host $server_name;
    proxy_set_header X-Forwarded-Host $server_name;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Body-Streaming
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # ---- Security-Header: setzt die APP, nicht der Reverse-Proxy ----
    # Sämtliche Security-Header (HSTS, X-Frame-Options, X-Content-Type-Options,
    # Referrer-Policy, Permissions-Policy, CSP) kommen aus der App
    # (apps/web/next.config.mjs) und werden hier nur durchgereicht. KEINE
    # add_header-Duplikate setzen: nginx ADDIERT zu den Upstream-Headern,
    # der Browser sieht dann zwei Werte und nimmt bei Referrer-Policy den
    # LETZTEN — die App setzt für Token-URLs (/portal/login/verify, /poa/sign,
    # /gwg-onboarding) gezielt `Referrer-Policy: no-referrer`, ein hier
    # gesetztes add_header Referrer-Policy würde das überschreiben und die
    # Tokens via Referer leaken. Hier nur ergänzen, wenn die App-Header in
    # next.config.mjs entfernt werden — Achtung: dann pfad-spezifische
    # Policies (no-referrer auf Token-URLs) per location-Block nachbauen.

    # ---- V-2: Rate-Limit auf /api/health gegen DoS-Polling ----
    location = /api/health {
        limit_req zone=taxtronik_health burst=10 nodelay;
        proxy_pass http://taxtronik_app;
    }

    # ---- Login-Endpoints stärker raten ----
    # Sowohl der no-JS-Passwortpfad als auch Next-Server-Actions posten auf
    # Login-Routen. Die kleine harte Body-Grenze greift vor dem 26-MiB-
    # App-Limit und verhindert, dass Next den Login-Body erst gross puffert.
    location ~ ^/staff/login(?:/password)?$ {
        client_max_body_size 64k;
        limit_req zone=taxtronik_login burst=10 nodelay;
        proxy_pass http://taxtronik_app;
    }

    location ~ ^/api/auth/(staff|portal)/callback/ {
        limit_req zone=taxtronik_login burst=10 nodelay;
        proxy_pass http://taxtronik_app;
    }

    # ---- Allgemeine API-Endpoints ----
    # n8n -> App: signierte Inbound-API. Im getrennten Staff-/Portal-Setup gehört
    # dieser Pfad auf den Staff/API-VHost oder eine interne App-URL; das
    # Mandantenportal braucht /api/n8n/* nicht. Die App prüft HMAC + Replay-Nonce.
    location ^~ /api/n8n/ {
        limit_req zone=taxtronik_api burst=20 nodelay;
        proxy_pass http://taxtronik_app;
        proxy_read_timeout 120s;
    }

    # Multipart wird in der App derzeit gepuffert. Begrenze deshalb parallel
    # aktive Uploads pro Quell-IP und über den gesamten VHost. nginx puffert den
    # Request-Body standardmäßig vor dem Proxying auf Disk; maximal sechs
    # 25-MiB-Dateien gelangen gleichzeitig in den Node-Prozess.
    location ~ ^/api/(staff/documents(?:/[^/]+/new-version)?|portal/documents)/commit$ {
        limit_conn taxtronik_upload_per_ip 2;
        limit_conn taxtronik_upload_global 6;
        limit_req zone=taxtronik_api burst=6 nodelay;
        proxy_pass http://taxtronik_app;
        proxy_read_timeout 300s;
    }

    location /api/ {
        limit_req zone=taxtronik_api burst=20 nodelay;
        proxy_pass http://taxtronik_app;
        # WebSocket / SSE support (Notification-Stream falls genutzt)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }

    # ---- Statische Assets: hohe Cache-Lebenszeit ----
    location /_next/static/ {
        proxy_pass http://taxtronik_app;
        proxy_cache_valid 200 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ---- Alles andere → App ----
    location / {
        proxy_pass http://taxtronik_app;
        proxy_read_timeout 60s;
    }

    # ---- Server-Identification raus ----
    server_tokens off;
}

# -----------------------------------------------------------------------------
# Optional: n8n-UI hinter eigenem TLS-VHost
# -----------------------------------------------------------------------------
# n8n ist ein eigener Dienst. Wenn die UI öffentlich erreichbar sein muss,
# dann nur über TLS und n8n-Login, idealerweise zusätzlich per IP-Allowlist,
# VPN oder Basic Auth. Ohne externen UI-Zugriff diesen kompletten Block
# weglassen; die App/Worker sprechen n8n intern.
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name n8n.example.com;
#
#     ssl_certificate     /etc/letsencrypt/live/n8n.example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/n8n.example.com/privkey.pem;
#
#     client_max_body_size 25M;
#
#     proxy_set_header Host $host;
#     proxy_set_header X-Forwarded-Host $host;
#     proxy_set_header X-Forwarded-Proto $scheme;
#     proxy_set_header X-Forwarded-For $remote_addr;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_http_version 1.1;
#     proxy_set_header Upgrade $http_upgrade;
#     proxy_set_header Connection "upgrade";
#
#     location / {
#         proxy_pass http://taxtronik_n8n;
#         proxy_read_timeout 3600s;
#     }
# }

# -----------------------------------------------------------------------------
# Optional: getrennte Staff- und Mandantenportal-VHosts
# -----------------------------------------------------------------------------
# Für produktive Kanzleien ist meist sinnvoll:
#   NEXTAUTH_URL=https://staff.kanzlei.example.de
#   PORTAL_PUBLIC_URL=https://portal.kanzlei.example.de
#   STAFF_COOKIE_DOMAIN=staff.kanzlei.example.de
#   PORTAL_COOKIE_DOMAIN=portal.kanzlei.example.de
#
# Staff/API-VHost: /staff/*, /api/staff/*, /api/auth/staff/* und /api/n8n/*
# Portal-VHost:   /portal/*, /api/portal/*, /api/auth/portal/*, /poa/sign,
#                 /gwg-onboarding sowie gemeinsame Assets (_next/static).
#
# Vollständige Pfadliste und Caddy-Variante:
# docs/operations/subdomain-trennung.md
