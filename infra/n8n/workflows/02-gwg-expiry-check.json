{
  "name": "02 — GwG-Ablauf-Warnung (täglich)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }] }
      },
      "id": "cron-trigger",
      "name": "Täglich 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "__TAXTRONIK_API_URL__/api/integrations/n8n/v1/expiring-gwg-checks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-taxtronik-key-id", "value": "__TAXTRONIK_CALLBACK_KEY_ID__" },
            { "name": "x-taxtronik-request-id", "value": "={{ 'gwg-expiry-' + $execution.id }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "withinDays", "value": "30" }] },
        "options": {}
      },
      "id": "fetch-expiring",
      "name": "Tenantgebundene GwG-Prüfungen abrufen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-data",
              "leftValue": "={{ $json.checks.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-empty",
      "name": "Nur wenn etwas zu melden",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fromEmail": "__SMTP_FROM__",
        "toEmail": "__GWG_OFFICER_EMAIL__",
        "subject": "{{ $json.checks.length }} GwG-Prüfungen laufen in <30 Tagen ab",
        "text": "Folgende GwG-Prüfungen laufen demnächst ab und müssen erneuert werden:\n\n{{ $json.checks.map(c => '- ' + c.clientName + ': gültig bis ' + c.validUntil).join('\\n') }}\n\nBitte öffnen Sie die GwG-Übersicht über Ihren gewohnten TaxTronik-Zugang.\n\n— TaxTronik",
        "options": {}
      },
      "id": "send-warning-mail",
      "name": "Warn-Mail an GwG-Beauftragten",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 200]
    }
  ],
  "connections": {
    "Täglich 08:00": {
      "main": [[{ "node": "Tenantgebundene GwG-Prüfungen abrufen", "type": "main", "index": 0 }]]
    },
    "Tenantgebundene GwG-Prüfungen abrufen": {
      "main": [[{ "node": "Nur wenn etwas zu melden", "type": "main", "index": 0 }]]
    },
    "Nur wenn etwas zu melden": {
      "main": [[{ "node": "Warn-Mail an GwG-Beauftragten", "type": "main", "index": 0 }], []]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false,
    "saveManualExecutions": false
  },
  "versionId": "2.0"
}
