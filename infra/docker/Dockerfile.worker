# syntax=docker/dockerfile:1.7
# =============================================================================
# Worker-Dockerfile (BullMQ-Worker)
#
# Build: docker build -f infra/docker/Dockerfile.worker -t taxtronik/worker:latest .
#
# Wie Dockerfile.web: im Builder ZUERST die Quelle kopieren, DANN installieren —
# so entstehen die pnpm-Workspace-Symlinks gegen vorhandene Quellen (deps-first
# erzeugt Symlinks auf quell-lose Pakete; siehe Dockerfile.web).
# =============================================================================

FROM node:24-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS builder
RUN apk add --no-cache libc6-compat openssl
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

# Quelle zuerst (node_modules via .dockerignore ausgeschlossen), dann install.
COPY . .
# Defense-in-depth gegen restriktive Host-Modi nach einem Operator-Update:
# Runtime-COPYs muessen fuer den non-root-User `node` les- und traversierbar sein.
RUN chmod -R a+rX /repo

# --ignore-scripts (pnpm 11 blockt Build-Scripts) → postinstall-Hooks holt rebuild
# nach. `--filter @taxtronik/db`, damit dessen devDep prisma (+ transitiv dotenv)
# für den Migrate-Service (prisma.config.ts) von packages/db auflösbar ist.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts --filter @taxtronik/worker... --filter @taxtronik/db

RUN pnpm rebuild -r --filter @taxtronik/worker... \
      @prisma/client @prisma/engines esbuild prisma sharp unrs-resolver

# pnpm 11 umgehen — siehe Dockerfile.web. cd packages/db: @prisma/client
# (Generate-Ziel) + prisma/config (für prisma.config.ts) dort auflösbar.
# Dummy-DATABASE_URL, weil der Config-Load datasource.url=env('DATABASE_URL')
# auswertet (generate verbindet nicht).
RUN cd packages/db && \
    PRISMA=$(find /repo -path "*/prisma/build/index.js" -not -path "*/cache/*" 2>/dev/null | head -1) && \
    test -n "$PRISMA" && \
    DATABASE_URL=postgresql://build:build@build/build node "$PRISMA" generate

# ----- Runtime ---------------------------------------------------------------
# P-10: Kein corepack/pnpm in der Runtime-Stage. Reduziert Image-Größe und
# verkleinert den Angriffsvektor. tsx wird zur Laufzeit per find lokalisiert
# (pnpm-Store-Layout legt es nicht unter node_modules/.bin/ ab).
# Runner explizit auf Alpine 3.23 gepinnt: postgresql18-client liegt erst ab
# 3.23 in main (v3.22 hat nur 17) — ein floatendes node:24-alpine könnte je
# nach Upstream-Stand ohne pg18 dastehen und der apk add unten bräche.
FROM node:24-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS runner
# Versions-Metadaten — siehe Dockerfile.web (Release-Workflow setzt Tag + Commit).
ARG APP_VERSION=dev
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="taxtronik-worker" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"
# postgresql18-client: pg_restore für den monatlichen Restore-Drill
# (jobs/backup-drill.ts). Client-Major MUSS >= Server-Major (18) sein —
# ein älterer pg_restore kann 18er-Dumps nicht lesen.
RUN apk add --no-cache openssl postgresql18-client tzdata && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app

ENV NODE_ENV=production \
    TZ=Europe/Berlin \
    APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA}

COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/apps/worker ./apps/worker
COPY --from=builder /repo/packages ./packages
COPY --from=builder /repo/package.json ./

USER node
WORKDIR /app/apps/worker

# Laufzeit-Invarianten bereits im Build unter dem echten Runtime-User pruefen.
# Dadurch braucht die Build-only-CI keinen fehleranfaelligen lokalen Image-Export.
RUN test "$(id -u)" = "1000" && \
    test -r /app/packages/db/scripts/migrate-deploy.sh && \
    test -r /app/packages/db/scripts/migrate-deploy.mjs && \
    test -r /app/packages/db/scripts/check-migration-line-endings.mjs && \
    test -r /app/packages/db/scripts/inspect-migration-recovery.mjs && \
    test -r /app/packages/db/scripts/verify-migration-ledger.mjs && \
    test -r /app/packages/db/prisma/migrations/20260801003400_gwg_fail_closed_and_destruction/migration.sql && \
    test ! -w /app/packages/db/scripts/migrate-deploy.sh && \
    test ! -w /app/packages/db/scripts/migrate-deploy.mjs && \
    test ! -w /app/packages/db/scripts/check-migration-line-endings.mjs && \
    test ! -w /app/packages/db/scripts/inspect-migration-recovery.mjs && \
    test ! -w /app/packages/db/scripts/verify-migration-ledger.mjs && \
    test ! -w /app/packages/db/prisma/migrations/20260801003400_gwg_fail_closed_and_destruction/migration.sql && \
    sh -n /app/packages/db/scripts/migrate-deploy.sh

# Q-9: HEALTHCHECK auf den Heartbeat-File-Touch (siehe apps/worker/src/index.ts).
# Worker schreibt alle 30 s nach /tmp/worker-alive; HEALTHCHECK schlägt fehl,
# wenn die Datei älter als 90 s ist → Docker restartet den Container.
# Vorher: kein Healthcheck → Worker konnte deadlock'en, ohne dass Restart-Policy
# greift.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "const s=require('node:fs').statSync('/tmp/worker-alive'); if (Date.now()-s.mtimeMs > 90000) process.exit(1)" || exit 1

# tsx-CLI im pnpm-Store lokalisieren (Pfad enthält Versions-Hash, daher
# find statt hardcoded). WORKDIR ist /app/apps/worker, src/index.ts relativ.
CMD ["sh", "-c", "TSX=$(find /app -path '*/tsx/dist/cli.mjs' -not -path '*/cache/*' 2>/dev/null | head -1); test -n \"$TSX\" || { echo 'FATAL: tsx CLI nicht im Image gefunden'; exit 1; }; exec node \"$TSX\" src/index.ts"]
