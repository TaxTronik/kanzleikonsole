# syntax=docker/dockerfile:1.7
# =============================================================================
# Worker-Dockerfile (BullMQ-Worker)
#
# Build: docker build -f infra/docker/Dockerfile.worker -t taxtronik/worker:latest .
#
# Der Builder laedt die Pakete zuerst nur anhand von Lockfile, Workspace-
# Konfiguration und Patches (`pnpm fetch`); Quell- und Doku-Aenderungen
# invalidieren diese Schicht nicht. Danach Quelle kopieren, offline
# installieren, den Worker nach dist buendeln (apps/worker/scripts/build.mjs)
# und die Laufzeit per `pnpm deploy --prod` befuellen. Das Runtime-Image
# enthaelt weder Quellbaum noch devDependencies und startet ohne tsx.
# =============================================================================

# Gemeinsame, digest-gepinnte Basis fuer Builder und Runtime von Web UND
# Worker; der Wert muss in Dockerfile.web identisch sein (Guard:
# scripts/check-docker-bases-pinned.mjs). Alpine 3.23, weil
# postgresql18-client erst ab 3.23 in main liegt.
ARG NODE_BASE_IMAGE=node:24-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436

FROM ${NODE_BASE_IMAGE} AS builder
RUN apk add --no-cache libc6-compat openssl
WORKDIR /repo
# pnpm-Version ausschliesslich aus packageManager in package.json (Corepack).
COPY package.json ./
RUN corepack enable && corepack install && pnpm --version

# Paket-Store als eigene Schicht (statt Cache-Mount), damit auch ein
# exportierter Layer-Cache die Downloads enthaelt. fetch prueft den Lockfile
# bereits gegen die Supply-Chain-Regeln aus pnpm-workspace.yaml.
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm fetch --store-dir /pnpm-store

# Quelle (node_modules, Doku, E2E und Tests via .dockerignore ausgeschlossen).
COPY . .
# Defense-in-depth gegen abweichende Host-Modi nach einem Operator-Update:
# Runtime-COPYs muessen fuer `node` lesbar, aber nie gruppen-/welt-schreibbar sein.
RUN chmod -R u=rwX,go=rX /repo

# Install mit Hooks: nur die in allowBuilds freigegebenen Install-Skripte
# laufen, strictDepBuilds bricht bei ungeprueften Hooks ab (wie Quality-Job und
# Host-Setup, siehe Dockerfile.web).
RUN pnpm install --frozen-lockfile --offline --store-dir /pnpm-store \
      --filter @taxtronik/worker...

# Bundle: Workspace-Pakete eingebunden, Drittpakete extern, Source Maps.
RUN pnpm --filter @taxtronik/worker build

# Laufzeitbaum: nur Produktionsabhaengigkeiten, flach (nodeLinker=hoisted),
# mit denselben Install-Hooks. Prisma-CLI und Schema-Engine kommen als Peer
# von @prisma/client mit; der migrate-Service (docker-compose.app.yml) nutzt
# sie. Den Prisma-Client fuer genau diesen Baum generieren (Dummy-URL: der
# Config-Load wertet datasource.url=env('DATABASE_URL') aus, generate
# verbindet nicht). Danach entfallen die Workspace-Kopien (im Bundle
# enthalten) und der optionale typescript-Peer von Prisma (nur fuer dessen
# Versionsanzeige); verify-runtime.mjs prueft die externen Importe des
# Bundles gegen diesen Baum.
RUN pnpm --filter @taxtronik/worker deploy --prod --offline --store-dir /pnpm-store /deploy && \
    cd /deploy/node_modules/@taxtronik/db && \
    DATABASE_URL=postgresql://build:build@build/build node /deploy/node_modules/prisma/build/index.js generate && \
    rm -rf /deploy/node_modules/@taxtronik /deploy/node_modules/typescript \
      /deploy/node_modules/.bin/tsc /deploy/node_modules/.bin/tsserver && \
    chmod -R u=rwX,go=rX /deploy/node_modules && \
    node /repo/apps/worker/scripts/verify-runtime.mjs /deploy

# ----- Runtime ---------------------------------------------------------------
# P-10: Kein corepack/pnpm in der Runtime-Stage. Reduziert Image-Größe und
# verkleinert den Angriffsvektor.
# Runner explizit auf Alpine 3.23 gepinnt (NODE_BASE_IMAGE oben):
# postgresql18-client liegt erst ab 3.23 in main (v3.22 hat nur 17) — ein
# floatendes node:24-alpine könnte je nach Upstream-Stand ohne pg18 dastehen
# und der apk add unten bräche.
FROM ${NODE_BASE_IMAGE} AS runner
# Versions-Metadaten — siehe Dockerfile.web (Release-Workflow setzt Tag + Commit).
ARG APP_VERSION=dev
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="taxtronik-worker" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"
# postgresql18-client: pg_restore für den monatlichen Restore-Drill
# (jobs/backup-drill.ts). Client-Major MUSS >= Server-Major (18) sein —
# ein älterer pg_restore kann 18er-Dumps nicht lesen.
RUN apk add --no-cache openssl postgresql18-client tzdata && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app

ENV NODE_ENV=production \
    TZ=Europe/Berlin \
    APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA}

COPY --from=builder /deploy/node_modules ./node_modules
# package.json traegt "type": "module" fuer das ESM-Bundle.
COPY --from=builder /repo/apps/worker/package.json ./apps/worker/
COPY --from=builder /repo/apps/worker/dist/index.js /repo/apps/worker/dist/index.js.map ./apps/worker/dist/
# Konfigurationspruefung (B-05): ./taxtronik deploy|update fuehrt sie vor Backup
# und Migration im Ziel-Image aus (node dist/env-check.js --profile web|worker).
COPY --from=builder /repo/apps/worker/dist/env-check.js ./apps/worker/dist/
# Migrate-Service: Prisma-Konfiguration, Schema, Migrationen und Skripte.
COPY --from=builder /repo/packages/db/package.json /repo/packages/db/prisma.config.ts ./packages/db/
COPY --from=builder /repo/packages/db/prisma ./packages/db/prisma
COPY --from=builder /repo/packages/db/scripts ./packages/db/scripts

USER node
WORKDIR /app/apps/worker

# Laufzeit-Invarianten bereits im Build unter dem echten Runtime-User pruefen.
# Dadurch braucht die Build-only-CI keinen fehleranfaelligen lokalen Image-Export.
RUN set -eux; \
    test "$(id -u)" = "1000"; \
    test -r /app/packages/db/scripts/migrate-deploy.sh && \
    test -r /app/packages/db/scripts/migrate-deploy.mjs && \
    test -r /app/packages/db/scripts/check-migration-line-endings.mjs && \
    test -r /app/packages/db/scripts/inspect-migration-recovery.mjs && \
    test -r /app/packages/db/scripts/verify-migration-ledger.mjs && \
    test -r /app/packages/db/prisma/migrations/20260801003400_gwg_fail_closed_and_destruction/migration.sql && \
    test ! -w /app/packages/db/scripts/migrate-deploy.sh && \
    test ! -w /app/packages/db/scripts/migrate-deploy.mjs && \
    test ! -w /app/packages/db/scripts/check-migration-line-endings.mjs && \
    test ! -w /app/packages/db/scripts/inspect-migration-recovery.mjs && \
    test ! -w /app/packages/db/scripts/verify-migration-ledger.mjs && \
    test ! -w /app/packages/db/prisma/migrations/20260801003400_gwg_fail_closed_and_destruction/migration.sql && \
    sh -n /app/packages/db/scripts/migrate-deploy.sh && \
    test -r /app/node_modules/prisma/build/index.js && \
    test -r dist/index.js && test -r dist/env-check.js && test ! -e /app/node_modules/typescript; \
    rc=0; node dist/env-check.js --profile image-build-probe >/dev/null || rc=$?; \
    test "$rc" -eq 2

# Q-9: HEALTHCHECK auf den Heartbeat-File-Touch (siehe apps/worker/src/index.ts).
# Worker schreibt alle 30 s nach /tmp/worker-alive; HEALTHCHECK schlägt fehl,
# wenn die Datei älter als 90 s ist → Docker meldet den Container unhealthy.
# Ein Neustart braucht den externen Ops-Pfad aus day-2-operations.md;
# die Docker-Restart-Policy selbst reagiert nur auf ein Prozessende.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "const s=require('node:fs').statSync('/tmp/worker-alive'); if (Date.now()-s.mtimeMs > 90000) process.exit(1)" || exit 1

# Gebuendelter Worker; Source Maps halten Stack-Traces auf die TS-Quellen lesbar.
CMD ["node", "--enable-source-maps", "dist/index.js"]
