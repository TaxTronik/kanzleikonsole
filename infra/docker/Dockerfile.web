# syntax=docker/dockerfile:1.7
# =============================================================================
# Multi-Stage Dockerfile für apps/web (Next.js standalone)
#
# Build: docker build -f infra/docker/Dockerfile.web -t taxtronik/web:latest .
#   (vom Repo-Root!)
#
# WICHTIG (gelernt 2026-06-07): im Builder ZUERST die Quelle kopieren, DANN
# `pnpm install` — so entstehen die Workspace-Symlinks gegen VORHANDENE Quellen.
# Der frühere „deps-first" (nur package.json kopieren, installieren, dann Quelle
# nachkopieren) erzeugte Symlinks auf quell-lose Pakete; im Builder fand Turbopack
# dann @taxtronik/* (und transitiv zod) nicht („Module not found"). .npmrc liefert
# node-linker=hoisted + shamefully-hoist=true für die flache Auflösung.
# =============================================================================

FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat openssl
WORKDIR /repo
# pnpm 11 — Lockfile-Format ab Round 11 enthält settings.injectWorkspacePackages,
# das pnpm 10 unter --frozen-lockfile ablehnt.
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

# Build-Time-Dummies für ENV-Validierung (@taxtronik/config wirft beim Modul-Load,
# wenn ENV-Vars fehlen — Next evaluiert Server-Components bei der Page-Data-
# Collection; prisma generate wertet datasource.url=env('DATABASE_URL') aus).
# Im Runtime-Container überschreibt docker-compose alle Werte mit den echten.
ENV NEXT_TELEMETRY_DISABLED=1 \
    DATABASE_URL=postgresql://build:build@build/build \
    DATABASE_APP_URL=postgresql://build:build@build/build \
    REDIS_URL=redis://build:6379 \
    NEXTAUTH_URL=https://build.local \
    NEXTAUTH_TRUST_HOST=true \
    S3_ENDPOINT=https://build.local \
    SMTP_HOST=build.local \
    SMTP_PORT=587 \
    SMTP_FROM=build@build.local

# Quelle zuerst (node_modules via .dockerignore ausgeschlossen), dann install.
COPY . .

# pnpm 11 blockt Build-Scripts (interaktive Approval) → --ignore-scripts; die
# nötigen postinstall-Hooks (Prisma-Engine, sharp libvips, esbuild) holt rebuild
# nach. --filter @taxtronik/db, damit dessen devDep prisma (+ transitiv dotenv)
# für prisma generate/migrate von packages/db auflösbar ist.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts \
      --filter @taxtronik/web... --filter @taxtronik/web --filter @taxtronik/db

RUN pnpm rebuild -r --filter @taxtronik/web... --filter @taxtronik/web \
      @prisma/client @prisma/engines esbuild prisma sharp unrs-resolver \
    || true

# pnpm 11 löst bei JEDEM Aufruf einen impliziten Deps-Status-Check aus
# (ERR_PNPM_IGNORED_BUILDS, nicht abschaltbar) → pnpm umgehen, Binaries direkt mit
# node. cd packages/db: @prisma/client (Generate-Ziel) + prisma/config (für die
# prisma.config.ts) sind dort auflösbar; ENV-Dummy-DATABASE_URL fürs Config-Load.
RUN cd packages/db && \
    PRISMA=$(find /repo -path "*/prisma/build/index.js" -not -path "*/cache/*" 2>/dev/null | head -1) && \
    test -n "$PRISMA" && node "$PRISMA" generate

# Safety-Net: leeres public/ anlegen, damit COPY in der runner-Stage nicht knallt.
RUN mkdir -p apps/web/public

RUN --mount=type=cache,target=/repo/apps/web/.next/cache \
    cd apps/web && \
    NEXT=$(find /repo -path "*/next/dist/bin/next" -not -path "*/cache/*" 2>/dev/null | head -1) && \
    test -n "$NEXT" && \
    AUTH_SECRET=build-time-dummy-not-used-at-runtime-padding-padding \
    N8N_HMAC_SECRET=build-time-hmac-secret-padding-padding-padding-padding \
    S3_ACCESS_KEY=build-time-access-key \
    S3_SECRET_KEY=build-time-s3-secret-padding-padding-padding \
    node "$NEXT" build

# ----- Runtime ---------------------------------------------------------------
FROM node:22-alpine AS runner
# Versions-Metadaten: setzt der Release-Workflow (release.yml) aus Tag + Commit,
# lokale Builds lassen die Defaults stehen. Landen als ENV im Container —
# Admin-Seite und /api/health/detail zeigen sie an; Compose darf APP_VERSION
# zur Laufzeit mit TAXTRONIK_VERSION überschreiben.
ARG APP_VERSION=dev
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="taxtronik-web" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"
# T-3: wget für den HEALTHCHECK. node:alpine bringt es nicht standardmäßig
# mit; ~270 KB Overhead sind gegenüber dem Operability-Gewinn vernachlässigbar.
RUN apk add --no-cache openssl wget postgresql18-client
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA}

# Standalone-Output enthält dank `outputFileTracingRoot` in next.config.mjs
# alle Workspace-Dateien + getracten node_modules (inkl. Prisma-Engine).
# Die Verzeichnisstruktur unter standalone/ spiegelt /repo wider.
COPY --from=builder /repo/apps/web/.next/standalone ./
COPY --from=builder /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /repo/apps/web/public ./apps/web/public

EXPOSE 3000
USER node

# T-3: HEALTHCHECK über den /api/health-Endpoint. Erkennt hängende
# Next.js-Prozesse (Prisma-Pool-Exhaust, deadlocked Server-Action) — Docker
# restartet dann automatisch, statt den Container in "running but unresponsive"
# zu belassen. start-period großzügig, weil Next.js + Prisma einige Sekunden
# zum initial-bind brauchen.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "apps/web/server.js"]
