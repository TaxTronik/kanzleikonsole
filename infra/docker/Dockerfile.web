# syntax=docker/dockerfile:1.7
# =============================================================================
# Multi-Stage Dockerfile für apps/web (Next.js standalone)
#
# Build: docker build -f infra/docker/Dockerfile.web -t taxtronik/web:latest .
#   (vom Repo-Root!)
#
# Reihenfolge im Builder: `pnpm fetch` laedt die Pakete nur anhand von
# Lockfile, Workspace-Konfiguration und Patches in den Store (eigene Schicht;
# Quell- und Doku-Aenderungen invalidieren sie nicht). Erst danach die Quelle
# kopieren und offline installieren: die Workspace-Symlinks entstehen so gegen
# VORHANDENE Quellen (gelernt 2026-06-07: ein Install vor dem Quell-COPY liess
# Turbopack @taxtronik/* und transitiv zod nicht finden).
# pnpm-workspace.yaml liefert nodeLinker=hoisted; Workspace-Pakete sind Symlinks.
# =============================================================================

# Gemeinsame, digest-gepinnte Basis fuer Builder und Runtime von Web UND
# Worker; der Wert muss in Dockerfile.worker identisch sein (Guard:
# scripts/check-docker-bases-pinned.mjs). Alpine 3.23, weil
# postgresql18-client erst ab 3.23 in main liegt.
ARG NODE_BASE_IMAGE=node:24-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436

FROM ${NODE_BASE_IMAGE} AS builder
RUN apk add --no-cache libc6-compat openssl
WORKDIR /repo
# pnpm-Version ausschliesslich aus packageManager in package.json (Corepack);
# --version laedt bereits hier die pnpm-Binary in diesen Layer.
COPY package.json ./
RUN corepack enable && corepack install && pnpm --version

# Paket-Store als eigene Schicht (statt Cache-Mount), damit auch ein
# exportierter Layer-Cache die Downloads enthaelt. fetch prueft den Lockfile
# bereits gegen die Supply-Chain-Regeln aus pnpm-workspace.yaml.
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm fetch --store-dir /pnpm-store

# Build-Time-Dummies für ENV-Validierung (@taxtronik/config wirft beim Modul-Load,
# wenn ENV-Vars fehlen — Next evaluiert Server-Components bei der Page-Data-
# Collection; prisma generate wertet datasource.url=env('DATABASE_URL') aus).
# Im Runtime-Container überschreibt docker-compose alle Werte mit den echten.
ENV NEXT_TELEMETRY_DISABLED=1 \
    DATABASE_URL=postgresql://build:build@build/build \
    DATABASE_APP_URL=postgresql://build:build@build/build \
    REDIS_URL=redis://build:6379 \
    NEXTAUTH_URL=https://build.local \
    NEXTAUTH_TRUST_HOST=true \
    S3_ENDPOINT=https://build.local \
    SMTP_HOST=build.local \
    SMTP_PORT=587 \
    SMTP_FROM=build@build.local

# Quelle (node_modules, Doku, E2E und Tests via .dockerignore ausgeschlossen).
COPY . .
# Die Operator-CLI schuetzt Secrets mit umask 077. Falls ein Git-Update dadurch
# getrackte Quellen als 0600/Verzeichnisse als 0700 anlegt oder der Checkout
# Schreibrechte fuer Gruppe/Welt mitbringt, darf COPY diese Host-Modi nicht bis
# in den spaeteren non-root-Runner tragen.
RUN chmod -R u=rwX,go=rX /repo

# Install mit Hooks: pnpm fuehrt genau die in allowBuilds (pnpm-workspace.yaml)
# freigegebenen Install-Skripte aus und bricht wegen strictDepBuilds bei jedem
# ungeprueften Hook ab - derselbe Installationsfall wie im Quality-Job und beim
# Host-Setup, ohne zweite, handgepflegte rebuild-Liste. --filter @taxtronik/db,
# damit dessen devDep prisma (+ transitiv dotenv)
# für prisma generate/migrate von packages/db auflösbar ist.
RUN pnpm install --frozen-lockfile --offline --store-dir /pnpm-store \
      --filter @taxtronik/web... --filter @taxtronik/web --filter @taxtronik/db

# Prisma direkt aus dem gefilterten Build-Workspace aufrufen.
# cd packages/db: @prisma/client (Generate-Ziel) + prisma/config (für die
# prisma.config.ts) sind dort auflösbar; ENV-Dummy-DATABASE_URL fürs Config-Load.
RUN cd packages/db && \
    PRISMA=$(find /repo -path "*/prisma/build/index.js" -not -path "*/cache/*" 2>/dev/null | head -1) && \
    test -n "$PRISMA" && node "$PRISMA" generate

# Der direkte Next-Aufruf unten umgeht package.json-Buildskripte. Deshalb
# OCR-/PDF-Worker und Sprachmodelle hier explizit fuer das Runtime-public kopieren.
RUN node apps/web/scripts/prepare-identity-assets.mjs

# NODE_OPTIONS begrenzt Hauptprozess und TypeScript-Worker zusaetzlich. 2 GiB
# reichen fuer die Typpruefung des Workspaces nicht mehr aus. Der Host-
# Schutz liegt im cgroup-Limit von build_images: Next/Turbopack kann weitere
# Prozesse und nativen Speicher ausserhalb dieses V8-Heaps belegen.
RUN --mount=type=cache,target=/repo/apps/web/.next/cache \
    cd apps/web && \
    NEXT=$(find /repo -path "*/next/dist/bin/next" -not -path "*/cache/*" 2>/dev/null | head -1) && \
    test -n "$NEXT" && \
    NODE_OPTIONS="--max-old-space-size=4096" \
    AUTH_SECRET=build-time-dummy-not-used-at-runtime-padding-padding \
    N8N_HMAC_SECRET=build-time-hmac-secret-padding-padding-padding-padding \
    S3_ACCESS_KEY=build-time-access-key \
    S3_SECRET_KEY=build-time-s3-secret-padding-padding-padding \
    node "$NEXT" build

# ----- Runtime ---------------------------------------------------------------
FROM ${NODE_BASE_IMAGE} AS runner
# Versions-Metadaten: setzt der Release-Workflow (release.yml) aus Tag + Commit,
# lokale Builds lassen die Defaults stehen. Landen als ENV im Container —
# Admin-Seite und /api/health/detail zeigen sie an; Compose darf APP_VERSION
# zur Laufzeit mit TAXTRONIK_VERSION überschreiben.
ARG APP_VERSION=dev
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="taxtronik-web" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"
# T-3: wget für den HEALTHCHECK. node:alpine bringt es nicht standardmäßig
# mit; ~270 KB Overhead sind gegenüber dem Operability-Gewinn vernachlässigbar.
# tzdata: ohne zoneinfo kann musl libc TZ=Europe/Berlin nicht auflösen, Date-
# Lokalzeit bliebe UTC (Intl funktioniert dank Node-ICU unabhängig davon).
RUN apk add --no-cache openssl wget postgresql18-client tzdata && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    TZ=Europe/Berlin \
    APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA}

# Standalone-Output enthält dank `outputFileTracingRoot` in next.config.mjs
# alle Workspace-Dateien + getracten node_modules (inkl. Prisma-Engine).
# Die Verzeichnisstruktur unter standalone/ spiegelt /repo wider.
COPY --from=builder /repo/apps/web/.next/standalone ./
COPY --from=builder /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /repo/apps/web/public ./apps/web/public
# S-10: Die PDF-Schriften kommen nur über das Standalone-Paket (Tracing) ins
# Image und dürfen nicht öffentlich unter /fonts liegen. Prüfsummen prüft die
# App vor der ersten Einbettung.
RUN set -eu; \
    for file in NotoSans-Regular.ttf NotoSans-Bold.ttf NotoSansSC-Regular.otf \
      NotoSansSC-Bold.otf manifest.json OFL.txt OFL-NotoSans.txt; do \
      test -r "/app/apps/web/assets/fonts/noto/$file"; \
    done; \
    test ! -e /app/apps/web/public/fonts

EXPOSE 3000
USER node

# Docker prüft ausschließlich die Prozess-Liveness. Abhängigkeiten werden über
# /api/health als Readiness geprüft; ein DB-/Redis-/S3-Ausfall darf keinen
# Restart-Loop des ansonsten gesunden Web-Prozesses auslösen.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/live || exit 1

CMD ["node", "apps/web/server.js"]
