# Shell-Scripts und die Operator-CLI MÜSSEN LF behalten — sonst scheitert
# der Linux-Server mit „bad interpreter: /usr/bin/env bash^M".
/.gitattributes  text eol=lf
taxtronik         text eol=lf
*.sh              text eol=lf
infra/scripts/*   text eol=lf

# Normale Quelltexte: LF im Repo, lokale Working-Copy nach Plattform.
#
# Gegenstueck dazu ist `endOfLine: "auto"` in .prettierrc. Ohne das prueft
# Prettier gegen LF und meldet unter Windows JEDE frisch ausgecheckte Datei als
# Formatverstoss — `pnpm format:check` waere dort nach einem Clone flaechendeckend
# rot. Die Garantie "LF im Repo" haengt an dieser Datei, nicht an Prettier: git
# normalisiert beim Commit, unabhaengig davon, was in der Working-Copy steht.
*.ts              text
*.tsx             text
*.js              text
*.mjs             text
*.json            text
*.yml             text eol=lf
*.yaml            text eol=lf
*.conf            text eol=lf
*.md              text

# Binär — nie anfassen.
*.png             binary
*.jpg             binary
*.pdf             binary
*.ico             binary
*.bin             binary
*.tsr             binary
