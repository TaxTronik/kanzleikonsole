# =============================================================================
# taxtronik — Beispiel-Umgebungsvariablen
#
# In der Regel sollten Sie .env NICHT von Hand füllen. Stattdessen einmalig:
#     ./scripts/setup.sh        (Linux / macOS / Git-Bash)
#     .\scripts\setup.ps1       (Windows)
#
# Das Skript erzeugt alle leeren Secret-Felder automatisch mit kryptographisch
# zufälligen Werten und persistiert sie in `.env`. Vorhandene Werte werden
# nicht überschrieben.
#
# Das ENV-Schema in packages/config/src/env.ts validiert beim Start.
# =============================================================================

NODE_ENV=development

# --- Deployment / Versionierung ------------------------------------------------
# Bezugsweg fuer Anwendungscode und Images: `source` baut den ausgecheckten
# Git-Commit lokal; `release` zieht signierte Release-Artefakte.
TAXTRONIK_DEPLOY_CHANNEL=source
# Initialer Betriebsweg: `standard` nutzt einen vorhandenen Reverse-Proxy und
# exponiert die App nur auf 127.0.0.1. `traefik` ist der ausdrücklich
# bestätigte 1-Klick-Pfad für eine komplett leere Docker-Maschine.
DEPLOYMENT_METHOD=standard
TRAEFIK_ACME_EMAIL=
# Deploy-Identifier (wird vom Operator-Assistenten gepflegt; niemals `latest`).
# Im Source-Kanal identifiziert er den exakten Git-Commit, im Release-Kanal den
# veröffentlichten SemVer-Tag. Siehe docs/operations/release.md.
# TAXTRONIK_VERSION wird im Source-Kanal automatisch als source-<Commit>
# gepflegt. Im Release-Kanal setzt der Assistent eine veroeffentlichte SemVer.
TAXTRONIK_VERSION=
#
# Der Assistent setzt hierzu passend `taxtronik` für lokale Source-Builds oder
# den Registry-Pfad für veröffentlichte, CI-getestete Release-Images.
TAXTRONIK_IMAGE_PREFIX=taxtronik
# Lokale Builds laufen mit einem harten cgroup-Limit ohne Build-Swap. Vor dem
# Start muessen Limit + Systemreserve als MemAvailable frei sein; sonst bricht
# deploy/update sicher ab. Nur Werte mit m/g-Suffix verwenden.
# TAXTRONIK_BUILD_MEMORY_LIMIT=6g
# TAXTRONIK_BUILD_MEMORY_RESERVE=1g
# Von `./taxtronik deploy|update|rollback` aus dem signierten Manifest
# verwaltet; im Registry-Modus nicht manuell setzen/aendern:
# TAXTRONIK_WEB_DIGEST_SUFFIX=@sha256:...
# TAXTRONIK_WORKER_DIGEST_SUFFIX=@sha256:...
# TAXTRONIK_RELEASE_COMMIT=<voller Git-SHA>
# TAXTRONIK_RELEASE_MIGRATIONS_REQUIRED=true

# DEV-ONLY: TOTP beim Staff-Login überspringen (nur Passwort). Spart in der
# lokalen Entwicklung das Authenticator-Gefummel. Greift NUR, wenn NODE_ENV
# ungleich production ist — in Produktion ignoriert der Code das Flag
# vollständig. NIEMALS produktiv setzen.
# DEV_SKIP_TOTP=true

# --- Postgres -----------------------------------------------------------------
# Owner-Verbindung (für Migrationen). Passwort wird beim Setup generiert.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://taxtronik:${POSTGRES_PASSWORD}@localhost:5432/taxtronik?schema=public
# Optional: pg-Pool-Obergrenze pro Prozess. Ungesetzt = pg-Default (~10). Jede
# Anfrage haelt eine Connection fuer die volle Transaktion (<=15 s) — bei hoher
# Staff-Concurrency + Worker hochsetzen (z. B. App 20, Worker 5). Sehr hohe Last
# → PgBouncer davor statt sehr grosse Werte.
# DATABASE_CONNECTION_LIMIT=20

# Application-Role mit eingeschränkten Rechten (RLS-Backstop). Passwort
# ebenfalls auto-generiert. Wird in postgres-init.sh als Rolle angelegt.
TAXTRONIK_APP_PASSWORD=
DATABASE_APP_URL=postgresql://taxtronik_app:${TAXTRONIK_APP_PASSWORD}@localhost:5432/taxtronik?schema=public

# --- Redis (BullMQ + Sessions) ------------------------------------------------
# Compose mappt Redis auf Host-Port 6380 (siehe docker-compose.yml: oft läuft
# schon ein lokales Redis auf 6379). Container-intern bleibt 6379.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Auth.js v5 ---------------------------------------------------------------
# Wird vom Setup-Skript erzeugt (32 zufällige Bytes, base64).
AUTH_SECRET=
# Eigener Schlüssel für verschlüsselte Tenant-/Integrations-Secrets. Bei einer
# FRISCHEN Installation erzeugen Setup/Bootstrap diesen Wert. Bei bestehenden
# Installationen nicht nachträglich blind setzen: zuerst die mit AUTH_SECRET
# verschlüsselten Bestandswerte migrieren (siehe Secret-Rotation-Runbook).
SECRET_BOX_KEY=
# Public-URL der STAFF-Surface (Mitarbeiter-Login).
NEXTAUTH_URL=http://localhost:3000
# Kommagetrennte, vor dem Rollout fachlich/operativ geprüfte FIDO-MDS-AAGUIDs
# zugelassener Sicherheitsschlüssel-Modellfamilien. Leer = Hardware-Enrollment
# und jede Hardware-Assertion gesperrt; Passwort/TOTP-Installationen starten weiter.
# Keine Hersteller-ID raten: aus der verifizierten FIDO-Metadatenquelle übernehmen.
# Beispielsyntax: WEBAUTHN_HARDWARE_AAGUID_ALLOWLIST=uuid-1,uuid-2
WEBAUTHN_HARDWARE_AAGUID_ALLOWLIST=
# Bei jeder Aenderung der Allowlist oder Hardware-Vertrauenspolicy monoton
# erhoehen. Alle Replicas eines Deployments muessen denselben Wert verwenden.
WEBAUTHN_HARDWARE_POLICY_REVISION=1
# Public-URL der MANDANTEN-Surface. Alle an Mandanten versendeten Links
# (Magic-Link, GwG-Onboarding, Portal-Formular, Vollmacht-Signatur) zeigen
# auf diese Domain. Bei getrennten Subdomains zwingend setzen, sonst landet
# der Mandant auf der Staff-Domain und das Portal-Cookie greift nicht.
# Leer = Fallback auf NEXTAUTH_URL (Single-Host-Deploy).
# Beispiel: PORTAL_PUBLIC_URL=https://mandanten.kanzlei.example.de
PORTAL_PUBLIC_URL=
# Optional, aber fuer Subdomain-Trennung empfohlen: reine Hostnames, keine URLs.
# Beispiel:
#   STAFF_COOKIE_DOMAIN=staff.kanzlei.example.de
#   PORTAL_COOKIE_DOMAIN=mandanten.kanzlei.example.de
# Leer = host-only Cookies auf demselben Host (Single-Host-Deploy).
STAFF_COOKIE_DOMAIN=
PORTAL_COOKIE_DOMAIN=
# In Produktion Pflicht: Auth.js benötigt `true`. Deshalb muss der Reverse-
# Proxy Host und X-Forwarded-Host auf den kanonischen VHost pinnen (wie im
# mitgelieferten nginx-Beispiel), sonst ist Host-Header-Smuggling möglich (S9).
NEXTAUTH_TRUST_HOST=true

# H2/R2: Vertraue den X-Forwarded-For / X-Real-IP / CF-Connecting-IP-Headern.
# `true` nur, wenn der Reverse-Proxy diese Header korrekt setzt UND
# client-supplied Werte stripped. Sonst lassen sich Rate-Limits,
# Account-Lockouts und Audit-IPs (eIDAS-PoA-Beweis!) durch Header-Spoofing
# verfälschen. Sicherer Default ist `false`; für den mitgelieferten, korrekt
# konfigurierten nginx-Proxy bewusst auf `true` umstellen.
TRUST_PROXY_REQUIRED=false

# --- Object-Store (SeaweedFS, S3-API) ----------------------------------------
# SeaweedFS S3-Gateway lauscht standardmäßig auf 8333. Access-Key ist ein
# stabiler Identifier (kein Geheimnis); Secret-Key wird beim Setup generiert.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=taxtronik
S3_SECRET_KEY=
# Host-Port-Mappings; Default passt für Linux. Auf Windows liegt 9333
# im Hyper-V/WSL-reservierten Bereich (9167–9766) — dann z. B.:
#   SEAWEED_MASTER_PORT=19333
# SEAWEED_S3_PORT muss zu S3_ENDPOINT oben passen.
# SEAWEED_S3_PORT=8333
# SEAWEED_MASTER_PORT=9333
# SEAWEED_FILER_PORT=8888
S3_BUCKET_GOBD=gobd
S3_BUCKET_GENERAL=general
S3_BUCKET_STAFF_PRIVATE=staff-private
S3_BUCKET_BACKUPS=backups
# Browser-/CLI-Backups: Host-Pfad fuer Compose-Mount und Zielpfad im Container.
# BACKUP_LOCAL_DIR ist fuer Production-Webprozesse verpflichtend; Compose setzt
# den Default /app/backups. Nur Development nutzt statisch ../../backups.
# BACKUP_HOST_DIR=../../backups
# BACKUP_LOCAL_DIR=/app/backups
# Optional: Buckets fuer `./taxtronik backup-files` (Kanzleidateien-Byte-Export).
# Default: gobd gwg general staff-private
# BACKUP_OBJECT_BUCKETS="gobd gwg general staff-private"
# Optional: AWS-CLI-Image fuer den Bucket-Export ueberschreiben.
# TAXTRONIK_AWS_CLI_IMAGE=amazon/aws-cli:latest@sha256:c95ab0642137f55a12b95b6956dd03cefdbd73e760e0e7b870afc9b47f9c8150

# Versiegeltes Full-Backup (`./taxtronik backup-full`):
# - `age` muss auf dem Host installiert sein. Nur der OEFFENTLICHE Empfaenger
#   kommt auf den Server; die Identity zur Entschluesselung bleibt offline.
# - Ed25519-Schluessel einmalig offline erzeugen:
#     node scripts/backup/manifest.mjs generate-key --out-dir /sicher/offline
#   Private Signing-Key-Datei moeglichst auf einem separaten, nur zum Backup
#   gemounteten Datentraeger; Public Key getrennt/offline spiegeln.
# BACKUP_AGE_RECIPIENT=age1...
# Restore-only auf dem isolierten Zielsystem (NICHT dauerhaft auf Produktion):
# BACKUP_AGE_IDENTITY_FILE=/run/secrets/taxtronik-backup-age-identity.txt
# BACKUP_MANIFEST_PRIVATE_KEY_FILE=/run/secrets/backup-manifest-private.pem
# BACKUP_MANIFEST_PUBLIC_KEY_FILE=/etc/taxtronik/backup-manifest-public.pem
# TAXTRONIK_ALPINE_BACKUP_IMAGE=alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

# Optionales, administrativ getrenntes Offsite-S3-Ziel. `backup-full` laedt
# automatisch hoch, sobald alle vier Pflichtwerte gesetzt sind, und verweigert
# Ziele ohne Bucket-Versioning + Default Object Lock. Das Ziel MUSS HTTPS sein
# und darf nicht der lokale SeaweedFS-Store sein. Zugang nur write/list/head;
# Delete/Retention-Bypass fuer diese Credentials verweigern.
# BACKUP_OFFSITE_ENDPOINT=https://s3.eu-central-1.example.invalid
# BACKUP_OFFSITE_BUCKET=taxtronik-vault
# BACKUP_OFFSITE_ACCESS_KEY=
# BACKUP_OFFSITE_SECRET_KEY=
# BACKUP_OFFSITE_REGION=eu-central-1
# BACKUP_OFFSITE_PREFIX=taxtronik/full
# true = ein lokales Full-Backup ohne erfolgreichen Offsite-Upload gilt als Fehler.
# BACKUP_OFFSITE_REQUIRED=true

# --- ClamAV -------------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- SMTP-Relay ---------------------------------------------------------------
# Dev-Default nutzt Mailhog aus docker-compose.dev.yml. Produktion muss ein
# echtes SMTP-Relay setzen; ./taxtronik doctor blockt mailhog/localhost:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="taxtronik <noreply@example.local>"
# Betriebs-Alarme: der Worker prüft alle 5 Minuten Postgres/Redis/Object-Store/
# ClamAV und mailt bei Ausfall (nach ~10 min) + Entwarnung an diese Adresse.
# Bewusst E-Mail statt In-App: wenn die App down ist, sieht niemand In-App-
# Hinweise. Leer = Alerting aus.
# OPS_ALERT_EMAIL=admin@kanzlei.example.de

# --- SSRF-Guard: Trusted-Internal-Hosts ---------------------------------------
# Der SSRF-Guard (`@taxtronik/http-utils`) verweigert allgemeine Fetches an
# private/Loopback-Adressen UND an direkte IP-Literale. Hosts/IPs hier
# eingetragen umgehen diesen Check — gedacht für Docker-Compose-Service-DNS
# (n8n, seaweedfs, host.docker.internal) und RSS-/TSA-Proxies im internen Netz.
#
# RISK_LAYER_URL ist davon ausgenommen: Die Risk-Engine ist ein explizit
# konfiguriertes Operator-Backend-Ziel und darf Docker-Service-DNS, Loopback
# oder interne IPs verwenden, ohne INTERNAL_FETCH_HOSTS zu erweitern.
#
# Im Dev-Mode (NODE_ENV != production) sind localhost, 127.0.0.1, ::1 ohnehin
# automatisch erlaubt — diese Variable nur für Docker-Compose-Production setzen.
# INTERNAL_FETCH_HOSTS=n8n,seaweedfs,host.docker.internal

# --- Signal (historisch Risk-Layer / TCMS-Engine, §4) -------------------------
# Besitzvertrag: managed = TaxTronik baut oder bezieht, startet und aktualisiert
# den Container; external = natives/externes Signal nur anbinden und niemals
# verändern; disabled = inaktiv. `./taxtronik deploy` fragt ab.
SIGNAL_DEPLOYMENT=
# Bezugsweg für managed: source baut den gewählten Git-Stand lokal; image
# bezieht ein bereits veröffentlichtes Registry-Image. Bestehende Installationen
# ohne Wert bleiben aus Kompatibilitätsgründen auf image.
SIGNAL_DEPLOY_CHANNEL=
# Source-Build: TaxTronik besitzt diesen Checkout und aktualisiert ihn auf den
# gewählten Branch, Tag oder Commit. Keine Zugangsdaten in die URL schreiben;
# private Repositories über Git-Credential-Helper oder SSH-Key freischalten.
# Der portable Managed-/1-Klick-Pfad enthält Signal-Kern, BGE-M3-Embeddings,
# Quantenextras und die lokale generative LLM-Vertiefung. Das revisions- und
# SHA-256-gepinnte Granite-8B-GGUF (~6,25 GB) wird einmalig außerhalb des OCI-
# Images provisioniert und danach read-only eingebunden. Ohne GPU läuft es
# vollständig auf CPU, ist dort aber ein deutlicher Performance-Bottleneck.
SIGNAL_GIT_URL=https://git.hirschmann-koxha.de/TaxTronik/signal.git
SIGNAL_GIT_REF=main
# Leer = Schwesterverzeichnis `signal` neben dem TaxTronik-Checkout (/opt/signal
# bei /opt/kanzleikonsole). Muss ein eigener absoluter Pfad sein.
SIGNAL_GIT_DIR=
# Source-Build-Grenzen. Der Build installiert Runtime/Modell einschließlich der
# hash-gepinnten Quantenlos-Extras, berechnet aber KEINEN Index; dieser bleibt
# hinter der Bestätigung in den Einstellungen.
SIGNAL_BUILD_MEMORY_LIMIT=3g
SIGNAL_BUILD_MEMORY_RESERVE=1g
SIGNAL_BUILD_CPUS=2
# Source-Updates erkennen den Commit am lokalen Image-Tag und ueberspringen
# identische Builds. Einmalig mit `SIGNAL_FORCE_REBUILD=1 ./taxtronik update`
# erzwingen; dauerhaft normalerweise leer lassen.
# SIGNAL_FORCE_REBUILD=1
# Image-Weg: `auto` folgt dem getesteten Signal-Pin. Ein eigener Wert muss ein
# vX.Y.Z-Tag oder sha256-Digest sein, nie `latest`.
SIGNAL_IMAGE=auto
# Verwaltetes CPU-LLM. Leer = <TaxTronik-Checkout>/.taxtronik/signal-llm.
# Der Pfad enthält nur regenerierbare, öffentlich bezogene Modell-/Engine-
# Artefakte; er muss absolut sein und wird im Signal-Container read-only gemountet.
SIGNAL_LLM_DIR=
# HTTP-Vertrag heißt aus Rückwärtskompatibilität weiterhin RISK_LAYER_*.
RISK_LAYER_URL=
RISK_LAYER_TOKEN=
# Separates Operator-Secret für Embedding-Refresh, Abbruch und Zeitplanverwaltung.
# Nur bei aktivem Risk-Layer setzen; mindestens 32 zufällige Zeichen und nicht
# denselben Wert wie RISK_LAYER_TOKEN verwenden.
# Das Provisionieren dieses Tokens startet weder einen Build noch einen Zeitplan.
RISK_LAYER_OPERATOR_TOKEN=
# Windows-Dev (Nachbarcheckout ..\signal): scripts\win\Start-SignalDev.ps1
# richtet beide Tokens sowie den hash-gepinnten CPU-Embedder ein und startet Signal.
# Verwalteter Signal-Container: CPU ist der portable Standard.
RISK_LAYER_EMB_DEVICE=cpu
# Managed/One-Click setzt cpu. Externes GPU-Signal kann gpu/auto melden.
RISK_LAYER_LLM_BACKEND=auto
# Generative CPU-Inferenz kann mehrere Minuten dauern. Managed setzt 900 s.
RISK_LAYER_LLM_TIMEOUT=
# Legacy-only: verwaltete Self-contained-Images brauchen keinen Host-Mount mehr.
RISK_LAYER_FESTWISSEN_DIR=

# --- ELSTER / eric-bridge ------------------------------------------------------
# Netzinterner Dienst um die native ERiC-Bibliothek (privates Repo
# taxtronik-eric-bridge, eigener Debian-Container — Service `eric-bridge` in
# docker-compose.app.yml). OPT-IN: leer lassen → ELSTER-Modul inaktiv.
# Aktivieren:
#   1. ERiC-Distribution auf dem Server entpacken (z. B.
#      /opt/taxtronik/eric/44.1.6.0 mit lib/ darin) und ERIC_DIST_DIR darauf
#      zeigen lassen. Die Distribution ist vertraulich — nie in ein Repo.
#   2. Bridge-Image bereitstellen: auf dem Server aus dem privaten
#      Bridge-Checkout bauen (docker build -t taxtronik/eric-bridge:<version> .)
#      oder ERIC_BRIDGE_IMAGE auf die private Registry setzen.
#   3. ELSTER_BRIDGE_TOKEN auf ein zufälliges Secret (min 16 Zeichen) setzen —
#      App UND Bridge teilen dasselbe Token (Bearer-Auth).
#   4. ELSTER_BRIDGE_URL=http://eric-bridge:8085 (Compose-DNS).
#   5. ERIC_HERSTELLER_ID setzen (Geheimnis der ELSTER-Lizenzvereinbarung;
#      liest NUR der Bridge-Container — nie in Code oder Beispieldaten).
#   6. Für Stufe 2 (Kontoabfrage/Versand): ERIC_CERT_FILE auf das
#      Portalzertifikat (.pfx) der Kanzlei zeigen lassen. Ohne Zertifikat
#      bleiben die authentifizierten Endpunkte deaktiviert (503).
#   7. Stack mit Profil starten:
#      docker compose --profile elster -f docker-compose.yml -f docker-compose.app.yml up -d
ELSTER_BRIDGE_URL=
ELSTER_BRIDGE_TOKEN=
# ERIC_BRIDGE_IMAGE=taxtronik/eric-bridge:latest
# ERIC_DIST_DIR=/opt/taxtronik/eric/current
# ERIC_CERT_FILE=/opt/taxtronik/eric/cert/kanzlei.pfx
# ERIC_HERSTELLER_ID=

# --- n8n ----------------------------------------------------------------------
# Default-leerer Legacy-Fallback für bestehende Installationen. Nur während
# einer kontrollierten Migration setzen. Neue Installationen pflegen pro
# Workflow die exakte Produktions-/Test-URL interaktiv unter Administration →
# Einstellungen → Automatisierungen mit n8n.
N8N_WEBHOOK_BASE_URL=
# Liefer-Modus für ausgehende Webhooks. Leer = Default aus NODE_ENV:
#   dev  -> test  (nur n8n-Test-Hooks /webhook-test, trifft NIE die Produktiv-
#                  Workflows; in n8n "Listen for test event" aktivieren)
#   prod -> production (regulärer Versand an /webhook)
# Werte: production | test | log   ('log' = Dry-Run, nur ins Worker-Log, kein Versand)
N8N_DELIVERY_MODE=
# Globale n8n → TaxTronik-Callbacks unter /api/n8n/* sind standardmäßig als
# 404 verborgen. Nur für eine kontrollierte Migration bestehender Workflows
# exakt auf true setzen (keine Werte wie 1/yes/TRUE). In Produktion ist ein
# starkes N8N_HMAC_SECRET (mind. 32 Zeichen) Pflicht, sobald dieses Flag oder
# der Outbound-Legacy-Fallback N8N_WEBHOOK_BASE_URL aktiviert ist.
N8N_LEGACY_CALLBACKS_ENABLED=false
# Optionaler globaler Legacy-Fallback. Tenantgebundene Outbound-Secrets werden
# interaktiv verschlüsselt gespeichert; neue Callbacks nutzen scoped Bearer.
N8N_HMAC_SECRET=
# n8n-INTERNER Encryption-Key für dort gespeicherte Credentials (auto-generiert).
# Wird NIRGENDS in TaxTronik-Workflows oder im ACP eingetragen — nicht mit dem
# Outbound-Signatur-Secret (HMAC) oder dem Callback-Token verwechseln.
N8N_ENCRYPTION_KEY=
# Postgres-Passwort für n8n-DB (nur produktiv aktiv — Dev nutzt SQLite).
N8N_DB_PASSWORD=
#
# --- n8n hinter Reverse-Proxy --------------------------------------------------
# Der n8n-Port wird bewusst nur auf Loopback veröffentlicht (Hardening):
#   ports: ${N8N_BIND:-127.0.0.1}:5678:5678
# Übliche Topologien:
#   1) Host-Nginx auf derselben Maschine (Standard, siehe
#      infra/nginx/taxtronik.conf.example): NICHTS ändern — Upstream ist
#      127.0.0.1:5678, der Loopback-Publish reicht.
#   2) Verwaltetes DEPLOYMENT_METHOD=traefik: Das Setup erzeugt automatisch
#      den eigenen n8n-VHost und erreicht intern http://n8n:5678.
#   3) Anderer Reverse-Proxy läuft selbst als Container (NPM/eigenes Compose):
#      127.0.0.1 ist dann das Loopback des PROXY-Containers — n8n ist so nicht
#      erreichbar. Entweder den Proxy ans TaxTronik-Compose-Netz hängen und
#      direkt http://n8n:5678 als Upstream nutzen, oder unten N8N_BIND auf die
#      LAN-IP des Hosts setzen (nie 0.0.0.0 ohne Firewall!).
#   4) Zugriff von anderem Host: N8N_BIND=<LAN-IP> + Firewall-Regel.
# N8N_BIND=127.0.0.1
#
# Damit n8n hinter dem Proxy korrekte Webhook-URLs anzeigt/registriert, die
# öffentliche Adresse setzen (sonst zeigt n8n localhost-URLs an):
# N8N_HOST=n8n.example.de
# N8N_WEBHOOK_URL=https://n8n.example.de/
# N8N_PROXY_HOPS=1

# --- RFC-3161-Zeitstempel (Manipulationsevidenz) ------------------------------
# Default: GlobalSign — kostenlose, in der EU ansässige TSA. Ihre Antworten werden
# kryptografisch gegen den eingebetteten Root „GlobalSign Root CA - R6" geprüft
# (Signatur + Cert-Kette as-of genTime + EKU timeStamping), nicht nur strukturell.
# Pro Tenant in der Admin-UI ueberschreibbar. In Production ist eine externe TSA
# Pflicht; Self-Timestamp ist nur fuer Dev/Test gedacht.
# eIDAS-qualifiziert (kostenpflichtig): D-Trust https://tsa.d-trust.net/timestamp
TIMESTAMP_AUTHORITY_URL=http://timestamp.globalsign.com/tsa/r6advanced1
# Optional: PEM-Datei mit einem/mehreren zusätzlichen TSA-Trust-Roots (self-signed
# Root der eingesetzten TSA). Nur nötig, wenn NICHT GlobalSign R6 genutzt wird —
# z. B. D-Trust/Swisscom: ohne hinterlegten Root validiert die Verifikation nur
# „cryptoOk" (kein externer Vertrauensanker). Die Datei wird mit dem eingebauten
# Default gemergt. Der Verify-Report weist aus, wie viele Siegel trust-verankert sind.
# Im Docker-Stack PEM-Dateien in infra/compose/tsa-roots/ ablegen (oder das
# Host-Verzeichnis mit TSA_TRUSTED_ROOTS_HOST_DIR überschreiben) und hier den
# read-only Containerpfad wählen. Niemals einen ungeprüften Root aus der TSA-
# HTTP-Antwort selbst übernehmen.
# TSA_TRUSTED_ROOTS_HOST_DIR=./tsa-roots
# TSA_TRUSTED_ROOTS_FILE=/etc/taxtronik/tsa-roots/operator.pem

# --- Update-Benachrichtigung ---------------------------------------------------
# Die Admin-Seite prüft gegen ein vom Vendor signiertes Update-Manifest und
# zeigt verfügbare Releases an (kein Auto-Update — Einspielen bleibt beim
# Betreiber via update.sh). Veröffentlicht von release.yml bei jedem Tag.
# Leer lassen → Update-Check deaktiviert (Air-Gap-Betrieb).
# UPDATE_MANIFEST_URL=https://git.hirschmann-koxha.de/TaxTronik/updates/raw/branch/main/manifest.json
# Air-Gap-Alternative: Manifest und detached Signatur als lokale Dateien.
# UPDATE_MANIFEST_FILE=/mnt/release-media/manifest.json
# UPDATE_MANIFEST_SIGNATURE_FILE=/mnt/release-media/manifest.json.sig
# Ed25519-Public-Key des Vendors (raw 32 Byte, base64 — Ausgabe von
# scripts/release/generate-update-key.mjs). In Produktion Pflicht, sobald
# UPDATE_MANIFEST_URL gesetzt ist (Signaturprüfung ist fail-closed).
# UPDATE_PUBLIC_KEY=NE1YtBNNPFM545o1VqoBNTcKIPmZP0rmvLq22YyqKaU=

# --- Lizenzschlüssel (Iter. 7) -----------------------------------------------
# Signiertes JWT mit Ablaufdatum. In Iter. 1 noch nicht erzwungen.
LICENSE_KEY=
# Ed25519-Public-Key des Vendors zur Prüfung des LICENSE_KEY (optional).
