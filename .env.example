# =============================================================================
# taxtronik — Beispiel-Umgebungsvariablen
#
# In der Regel sollten Sie .env NICHT von Hand füllen. Stattdessen einmalig:
#     ./scripts/setup.sh        (Linux / macOS / Git-Bash)
#     .\scripts\setup.ps1       (Windows)
#
# Das Skript erzeugt alle leeren Secret-Felder automatisch mit kryptographisch
# zufälligen Werten und persistiert sie in `.env`. Vorhandene Werte werden
# nicht überschrieben.
#
# Das ENV-Schema in packages/config/src/env.ts validiert beim Start.
# =============================================================================

NODE_ENV=development

# --- Postgres -----------------------------------------------------------------
# Owner-Verbindung (für Migrationen). Passwort wird beim Setup generiert.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://taxtronik:${POSTGRES_PASSWORD}@localhost:5432/taxtronik?schema=public

# Application-Role mit eingeschränkten Rechten (RLS-Backstop). Passwort
# ebenfalls auto-generiert. Wird in postgres-init.sh als Rolle angelegt.
TAXTRONIK_APP_PASSWORD=
DATABASE_APP_URL=postgresql://taxtronik_app:${TAXTRONIK_APP_PASSWORD}@localhost:5432/taxtronik?schema=public

# --- Redis (BullMQ + Sessions) ------------------------------------------------
# Compose mappt Redis auf Host-Port 6380 (siehe docker-compose.yml: oft läuft
# schon ein lokales Redis auf 6379). Container-intern bleibt 6379.
REDIS_URL=redis://localhost:6380

# --- Auth.js v5 ---------------------------------------------------------------
# Wird vom Setup-Skript erzeugt (32 zufällige Bytes, base64).
AUTH_SECRET=
# Public-URL der STAFF-Surface (Mitarbeiter-Login).
NEXTAUTH_URL=http://localhost:3000
# Public-URL der MANDANTEN-Surface. Alle an Mandanten versendeten Links
# (Magic-Link, GwG-Onboarding, Portal-Formular, Vollmacht-Signatur) zeigen
# auf diese Domain. Bei getrennten Subdomains zwingend setzen, sonst landet
# der Mandant auf der Staff-Domain und das Portal-Cookie greift nicht.
# Leer = Fallback auf NEXTAUTH_URL (Single-Host-Deploy).
# Beispiel: PORTAL_PUBLIC_URL=https://mandanten.kanzlei.example.de
PORTAL_PUBLIC_URL=
# In Produktion Pflicht: `true` nur setzen, wenn der Reverse-Proxy
# `X-Forwarded-Host` filtert oder selbst setzt. Sonst Host-Header-Smuggling
# für Auth-Callback-URLs theoretisch möglich (S9).
# NEXTAUTH_TRUST_HOST=true

# H2/R2: Vertraue den X-Forwarded-For / X-Real-IP / CF-Connecting-IP-Headern.
# `true` nur, wenn der Reverse-Proxy diese Header korrekt setzt UND
# client-supplied Werte stripped. Sonst lassen sich Rate-Limits,
# Account-Lockouts und Audit-IPs (eIDAS-PoA-Beweis!) durch Header-Spoofing
# verfälschen. Default in docker-compose.app.yml ist `true` (Production
# steht typischerweise hinter nginx/caddy/traefik).
# TRUST_PROXY_REQUIRED=true

# --- Object-Store (SeaweedFS, S3-API) ----------------------------------------
# SeaweedFS S3-Gateway lauscht standardmäßig auf 8333. Access-Key ist ein
# stabiler Identifier (kein Geheimnis); Secret-Key wird beim Setup generiert.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=taxtronik
S3_SECRET_KEY=
# Host-Port-Mappings; Default passt für Linux. Auf Windows liegt 9333
# im Hyper-V/WSL-reservierten Bereich (9167–9766) — dann z. B.:
#   SEAWEED_MASTER_PORT=19333
# SEAWEED_S3_PORT muss zu S3_ENDPOINT oben passen.
# SEAWEED_S3_PORT=8333
# SEAWEED_MASTER_PORT=9333
# SEAWEED_FILER_PORT=8888
S3_BUCKET_GOBD=gobd
S3_BUCKET_GENERAL=general
S3_BUCKET_STAFF_PRIVATE=staff-private
S3_BUCKET_QUARANTINE=quarantine
S3_BUCKET_BACKUPS=backups

# --- ClamAV -------------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- SMTP-Relay (Kanzlei stellt) ---------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="taxtronik <noreply@example.local>"

# --- SSRF-Guard: Trusted-Internal-Hosts ---------------------------------------
# Der SSRF-Guard (`@taxtronik/http-utils`) verweigert Fetches an private/Loopback-
# Adressen. Hostnames hier eingetragen umgehen diesen Check — gedacht für
# Docker-Compose-Service-DNS (n8n, seaweedfs, host.docker.internal) und
# RSS-Feed-Proxies im internen Netz.
#
# Im Dev-Mode (NODE_ENV != production) sind localhost, 127.0.0.1, ::1 ohnehin
# automatisch erlaubt — diese Variable nur für Docker-Compose-Production setzen.
# INTERNAL_FETCH_HOSTS=n8n,seaweedfs,host.docker.internal

# --- n8n ----------------------------------------------------------------------
# Basis-URL für ausgehende Webhooks aus der App nach n8n.
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# HMAC-Secret für gegenseitige Authentifizierung App <-> n8n (auto-generiert).
N8N_HMAC_SECRET=
# Encryption-Key für gespeicherte n8n-Credentials (auto-generiert).
N8N_ENCRYPTION_KEY=
# Postgres-Passwort für n8n-DB (nur produktiv aktiv — Dev nutzt SQLite).
N8N_DB_PASSWORD=

# --- RFC-3161-Zeitstempel (Manipulationsevidenz) ------------------------------
# MVP: leer lassen → Self-Timestamp via lokalem Adapter.
# Produktion: URL einer akkreditierten TSA (z. B. D-Trust).
TIMESTAMP_AUTHORITY_URL=

# --- Lizenzschlüssel (Iter. 7) -----------------------------------------------
# Signiertes JWT mit Ablaufdatum. In Iter. 1 noch nicht erzwungen.
LICENSE_KEY=
