#!/usr/bin/env bash
# =============================================================================
# dc — docker-compose-Wrapper für taxtronik.
#
# Kapselt die immer gleichen Flags (-f base, -f app, --env-file), damit
# nicht bei jedem Aufruf drei Pfade getippt werden müssen. Ohne diesen
# Wrapper scheitern Compose-Befehle ohne --env-file an den ${VAR:?}-
# Pflicht-Checks (POSTGRES_PASSWORD etc.).
#
# Nutzung (aus /opt/taxtronik):
#   ./dc up -d                 # ganzen Stack hoch (Infra + App + Worker + n8n)
#   ./dc ps                    # Status
#   ./dc logs seaweedfs --tail 40
#   ./dc exec -T postgres psql -U taxtronik -d taxtronik -c '\dt'
#   ./dc down                  # alles stoppen (Volumes bleiben)
#   ./dc --infra up -d         # NUR Infra (Postgres/Redis/S3/ClamAV)
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE="$ROOT/infra/compose/docker-compose.yml"
APP="$ROOT/infra/compose/docker-compose.app.yml"
ENVFILE="$ROOT/.env"
S3_TEMPLATE="$ROOT/infra/scripts/seaweedfs-s3.template.json"
S3_GENERATED="$ROOT/infra/scripts/seaweedfs-s3.generated.json"

if [[ ! -f "$ENVFILE" ]]; then
  echo "FEHLER: $ENVFILE nicht gefunden." >&2
  exit 1
fi

# -----------------------------------------------------------------------------
# SeaweedFS-S3-Config IMMER vor compose rendern. Docker macht aus einem
# fehlenden Bind-Mount-Source ein leeres Verzeichnis — SeaweedFS stirbt dann
# mit „s3.json: is a directory". Hier deterministisch absichern:
#   - liegt fälschlich ein Verzeichnis dort → weg damit
#   - Datei aus Template + .env-Credentials (neu) rendern
# Idempotent, läuft bei jedem dc-Aufruf, kostet <10ms.
# -----------------------------------------------------------------------------
render_s3_config() {
  [[ -f "$S3_TEMPLATE" ]] || { echo "FEHLER: $S3_TEMPLATE fehlt." >&2; exit 1; }
  if [[ -d "$S3_GENERATED" ]]; then
    rmdir "$S3_GENERATED" 2>/dev/null || rm -rf "$S3_GENERATED"
  fi
  local ak sk
  ak="$(grep -E '^S3_ACCESS_KEY=' "$ENVFILE" | head -1 | cut -d= -f2-)"
  sk="$(grep -E '^S3_SECRET_KEY=' "$ENVFILE" | head -1 | cut -d= -f2-)"
  if [[ -z "$ak" || -z "$sk" ]]; then
    echo "FEHLER: S3_ACCESS_KEY/S3_SECRET_KEY nicht in .env." >&2
    exit 1
  fi
  sed -e "s|__S3_ACCESS_KEY__|${ak}|" -e "s|__S3_SECRET_KEY__|${sk}|" \
    "$S3_TEMPLATE" > "$S3_GENERATED"
  # 644 statt 600: SeaweedFS läuft im Container als unprivilegierter User
  # und muss die (read-only gemountete) Datei lesen. Kein zusätzliches
  # Risiko — dieselben Credentials stehen in der .env, der Server ist
  # on-prem, der Mount ist :ro.
  chmod 644 "$S3_GENERATED"
}
render_s3_config

# --infra: nur die Basis-Services, ohne app/worker/n8n
if [[ "${1:-}" == "--infra" ]]; then
  shift
  exec docker compose -f "$BASE" --env-file "$ENVFILE" "$@"
fi

exec docker compose -f "$BASE" -f "$APP" --env-file "$ENVFILE" "$@"
