{
  "name": "@taxtronik/worker",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*-db.test.{ts,tsx}\"",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/lib-storage": "^3.1168.0",
    "@peculiar/x509": "1.14.3",
    "@prisma/client": "^7.9.1",
    "@simplewebauthn/server": "13.3.3",
    "@taxtronik/config": "workspace:*",
    "@taxtronik/crypto": "workspace:*",
    "@taxtronik/db": "workspace:*",
    "@taxtronik/evidence": "workspace:*",
    "@taxtronik/gwg": "workspace:*",
    "@taxtronik/http-utils": "workspace:*",
    "@taxtronik/mail": "workspace:*",
    "@taxtronik/n8n-shared": "workspace:*",
    "@taxtronik/risk-layer": "workspace:*",
    "@taxtronik/rss": "workspace:*",
    "@taxtronik/storage": "workspace:*",
    "@taxtronik/tax": "workspace:*",
    "@taxtronik/tcms-client": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "nodemailer": "10.5.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "4.1.12"
  }
}
