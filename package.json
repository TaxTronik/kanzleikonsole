{
  "name": "taxtronik",
  "private": true,
  "version": "0.2.0",
  "description": "Kanzlei- und Mandanten-Dashboard für deutsche Steuerberater",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ops": "bash scripts/tests/ops-lib.test.sh && bash scripts/tests/migrate-deploy-recovery.test.sh",
    "e2e": "pnpm --filter @taxtronik/e2e e2e",
    "e2e:ui": "pnpm --filter @taxtronik/e2e e2e:ui",
    "e2e:headed": "pnpm --filter @taxtronik/e2e e2e:headed",
    "db:generate": "pnpm --filter @taxtronik/db generate",
    "db:migrate": "pnpm --filter @taxtronik/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @taxtronik/db migrate:deploy",
    "db:studio": "pnpm --filter @taxtronik/db studio",
    "db:seed": "pnpm --filter @taxtronik/db seed",
    "demo:retention": "pnpm --filter @taxtronik/web demo:retention",
    "verify:chain": "pnpm --filter @taxtronik/evidence verify",
    "verify:schema-drift": "pnpm --filter @taxtronik/db verify:schema-drift",
    "verify:rls": "pnpm --filter @taxtronik/db verify:rls",
    "verify:deploy-readiness": "pnpm --filter @taxtronik/storage verify:deploy",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "guard:datev": "sh scripts/check-no-real-datev.sh",
    "guard:paranoid-e2e": "sh scripts/check-paranoid-e2e.sh",
    "guard:no-focused-tests": "sh scripts/check-no-focused-tests.sh",
    "guard:ci-images": "sh scripts/check-ci-images-pinned.sh",
    "guard:docker-bases": "node scripts/check-docker-bases-pinned.mjs",
    "guard:ci-actions": "sh scripts/check-ci-actions-pinned.sh",
    "guard:supply-chain": "sh scripts/check-pnpm-supply-chain.sh"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/node": "^24.13.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
