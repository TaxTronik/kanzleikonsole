{
  "name": "taxtronik",
  "private": true,
  "version": "0.1.0",
  "description": "Kanzlei- und Mandanten-Dashboard für deutsche Steuerberater",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @taxtronik/e2e e2e",
    "e2e:ui": "pnpm --filter @taxtronik/e2e e2e:ui",
    "e2e:headed": "pnpm --filter @taxtronik/e2e e2e:headed",
    "db:generate": "pnpm --filter @taxtronik/db generate",
    "db:migrate": "pnpm --filter @taxtronik/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @taxtronik/db migrate:deploy",
    "db:studio": "pnpm --filter @taxtronik/db studio",
    "db:seed": "pnpm --filter @taxtronik/db seed",
    "verify:chain": "pnpm --filter @taxtronik/evidence verify",
    "verify:schema-drift": "pnpm --filter @taxtronik/db verify:schema-drift",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "guard:datev": "sh scripts/check-no-real-datev.sh",
    "guard:paranoid-e2e": "sh scripts/check-paranoid-e2e.sh"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
