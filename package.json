{
  "name": "taxtronik",
  "private": true,
  "version": "0.3.0",
  "description": "Kanzlei- und Mandanten-Dashboard für deutsche Steuerberater",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:complexity-baseline": "node scripts/check-complexity-baseline.mjs",
    "lint:react-compiler-baseline": "node scripts/check-react-compiler-baseline.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ops": "bash scripts/tests/ops-lib.test.sh && bash scripts/tests/migrate-deploy-recovery.test.sh && pnpm --filter @taxtronik/db test:migrate-deploy",
    "e2e": "pnpm --filter @taxtronik/e2e e2e",
    "e2e:ui": "pnpm --filter @taxtronik/e2e e2e:ui",
    "e2e:headed": "pnpm --filter @taxtronik/e2e e2e:headed",
    "a11y:e2e": "pnpm --filter @taxtronik/e2e a11y",
    "db:generate": "pnpm --filter @taxtronik/db generate",
    "db:migrate": "pnpm --filter @taxtronik/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @taxtronik/db migrate:deploy",
    "db:studio": "pnpm --filter @taxtronik/db studio",
    "db:seed": "pnpm --filter @taxtronik/db seed",
    "demo:retention": "pnpm --filter @taxtronik/web demo:retention",
    "verify:chain": "pnpm --filter @taxtronik/evidence verify",
    "verify:migration-ledger": "pnpm --filter @taxtronik/db verify:migration-ledger",
    "verify:migration-line-endings": "pnpm --filter @taxtronik/db verify:migration-line-endings",
    "verify:schema-drift": "pnpm --filter @taxtronik/db verify:schema-drift",
    "verify:rls": "pnpm --filter @taxtronik/db verify:rls",
    "verify:deploy-readiness": "pnpm --filter @taxtronik/storage verify:deploy",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" \"scripts/fachkatalog/**/*.mjs\" \"scripts/tests/fachkatalog.test.mjs\" \"scripts/check-doc-links.mjs\" \"scripts/tests/check-doc-links.test.mjs\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" \"scripts/fachkatalog/**/*.mjs\" \"scripts/tests/fachkatalog.test.mjs\" \"scripts/check-doc-links.mjs\" \"scripts/tests/check-doc-links.test.mjs\"",
    "docs:test": "node --test scripts/tests/check-doc-links.test.mjs",
    "docs:check": "pnpm docs:test && node scripts/check-doc-links.mjs",
    "guard:datev": "sh scripts/check-no-real-datev.sh",
    "guard:paranoid-e2e": "sh scripts/check-paranoid-e2e.sh",
    "guard:no-focused-tests": "sh scripts/check-no-focused-tests.sh",
    "guard:ci-images": "sh scripts/check-ci-images-pinned.sh",
    "guard:docker-bases": "node scripts/check-docker-bases-pinned.mjs",
    "guard:ci-actions": "sh scripts/check-ci-actions-pinned.sh",
    "guard:supply-chain": "sh scripts/check-pnpm-supply-chain.sh",
    "fachkatalog:generate": "node scripts/fachkatalog/cli.mjs generate",
    "fachkatalog:validate": "node scripts/fachkatalog/cli.mjs validate",
    "fachkatalog:index:check": "node scripts/fachkatalog/cli.mjs check-index",
    "fachkatalog:review-hash": "node scripts/fachkatalog/cli.mjs review-hash",
    "fachkatalog:diff": "node scripts/fachkatalog/diff-guard.mjs",
    "fachkatalog:test": "node --test scripts/tests/fachkatalog.test.mjs",
    "fachkatalog:check": "pnpm fachkatalog:test && node scripts/fachkatalog/cli.mjs check"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/node": "^24.13.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "4.3.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
