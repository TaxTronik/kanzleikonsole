# Lokale Operator-Backups (Postgres-Dumps)
/backups/
# Historischer relativer Browser-Backup-Pfad.
/apps/web/backups/

# Atomarer Last-Good-Releasevertrag der lokalen Installation.
/.taxtronik.state
# Atomarer Marker zwischen Migrationsstart und bestandenem Readiness-Gate.
/.taxtronik.migration-pending
# Einmalige Autorisierung nach explizitem Produktions-DB-Restore.
/.taxtronik.database-restored
# Marker eines bestätigten, aber noch nicht erfolgreich abgeschlossenen
# 1-Klick-Deployments. Wird nach bestandenem Readiness-Gate entfernt.
/.taxtronik.install-pending

# Setup-gerenderte Config-Dateien (enthalten Secrets aus .env)
infra/scripts/seaweedfs-s3.generated.json
# Aus der bestätigten Initialkonfiguration erzeugte Traefik-Routen (keine
# Secrets, aber installationsspezifische Hostnamen).
/.taxtronik.traefik-dynamic.yml

# S-4: Lizenz-Private-Keys (siehe scripts/license-keygen.ts).
licensing-private-*.pem

# U-3: Seed-generierte Admin-Credentials.
.admin-credentials.txt

# Lokale Brainstorming-/Backlog-Notizen (privat, nicht commiten).
IDEAS.md

# Demo-/Mock-Datensätze (lokal, nicht commiten — können personenbezogene
# Daten in DATEV-/Addison-Mustern enthalten).
DEMODATEN/

