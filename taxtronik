#!/usr/bin/env bash
# =============================================================================
# taxtronik — Operator-CLI (ein Einstieg fuer das ganze produktive Deployment).
#
#   ./taxtronik bootstrap            Prod-Erstinstall (1 Kommando bis laufende App)
#   ./taxtronik deploy               bauen/pullen + migrieren + starten + Smoke
#   ./taxtronik update               Backup + git pull + bauen/pullen + migrieren + starten
#   ./taxtronik backup               Postgres -> lokale Kopie + S3-Backup-Bucket
#   ./taxtronik backup-files         Kanzleidateien aus SeaweedFS -> backups/object-store
#   ./taxtronik backup-full          Versiegeltes Full-Backup inkl. Cold-Volumes
#   ./taxtronik backup-verify DIR    Signatur + SHA-256-Inventar pruefen
#   ./taxtronik backup-decrypt D Z [IDENTITY] [PUBLIC_KEY]
#   ./taxtronik backup-offsite DIR   Verifiziert in immutable Offsite-S3 laden
#   ./taxtronik restore --list       Backups auflisten / Restore starten
#   ./taxtronik rollback [<version>] zurueck auf vorherigen Stand (keine Migration)
#   ./taxtronik reset-admin-password Admin-Passwort neu setzen (Recovery)
#   ./taxtronik doctor [--fix]       .env vorab validieren / Secrets generieren
#   ./taxtronik up|down|ps|logs|exec|pull ...   docker-compose-Passthrough
#   ./taxtronik --infra up -d                     nur Infra (Postgres/Redis/S3/ClamAV)
#
# Server führt NUR Prod aus — .env auf dem Server ist immer eine Prod-.env.
# Dev-Setup (andere Maschine): scripts/setup.sh.
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$ROOT/scripts/ops-lib.sh"

usage() {
  cat <<'EOF'
taxtronik — Operator-CLI

Nutze:
  ./taxtronik bootstrap             Prod-Erstinstall (Infra, Images, Migration, Admin)
  ./taxtronik deploy                bauen/pullen + migrieren + starten + Health-Smoke
  ./taxtronik update                Backup + git pull + bauen/pullen + migrieren + starten
  ./taxtronik backup                Postgres-Backup nach backups/ + S3-Backup-Bucket
  ./taxtronik backup-files          Kanzleidateien aus SeaweedFS nach backups/object-store
  ./taxtronik backup-full           DB + n8n + Cold-Volumes + age-Recovery versiegeln
  ./taxtronik backup-verify DIR [PUBLIC_KEY]
                                    Signatur und alle Hashes pruefen
  ./taxtronik backup-decrypt D Z [IDENTITY] [PUBLIC_KEY]
                                    In leeres isoliertes Ziel entschluesseln
  ./taxtronik backup-offsite DIR    Geprueftes Full-Backup immutable offsite laden
  ./taxtronik restore --list        Backups im S3-Backup-Bucket auflisten
  ./taxtronik restore --latest --target-url <url> [--confirm-overwrite]
  ./taxtronik restore --key <s3-key> | --file <dump>
  ./taxtronik rollback [<version>]  zurueck auf frueheren Stand (ohne DB-Migration)
  ./taxtronik reset-admin-password  Admin-Passwort neu setzen (Recovery)
  ./taxtronik doctor [--fix]        .env-Validierung; --fix generiert fehlende Secrets
  ./taxtronik up|down|ps|logs|exec|pull ...   docker-compose-Passthrough (ganzer Stack)
  ./taxtronik --infra <cmd>                    nur Infra-Services
  ./taxtronik help                 diese Hilfe
EOF
}

# --infra als erstes Argument: nur Basis-Services (ohne app/worker/n8n).
if [[ "${1:-}" == "--infra" ]]; then
  shift
  compose --infra "$@"
  exit
fi

cmd="${1:-help}"
case "$cmd" in
  bootstrap) shift || true; cmd_bootstrap "$@" ;;
  deploy)    cmd_deploy ;;
  update)    cmd_update ;;
  backup)    cmd_backup ;;
  backup-files) cmd_backup_files ;;
  backup-full) cmd_backup_full ;;
  backup-verify) cmd_backup_verify "${2:-}" "${3:-}" ;;
  backup-decrypt) cmd_backup_decrypt "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
  backup-offsite) cmd_backup_offsite "${2:-}" ;;
  restore)   shift || true; cmd_restore "$@" ;;
  rollback)  shift || true; cmd_rollback "${1:-}" ;;
  reset-admin-password) cmd_reset_admin_password ;;
  doctor)    shift || true; doctor "$@" ;;
  up|down|stop|restart|ps|logs|exec|pull|top|config|port|images|stats)
    shift || true; compose "$cmd" "$@" ;;
  help|-h|--help) usage ;;
  *) echo "Unbekanntes Kommando: $cmd" >&2; echo >&2; usage >&2; exit 1 ;;
esac
