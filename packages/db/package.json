{
  "name": "@taxtronik/db",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./prisma-client": "./src/prisma-client.ts",
    "./prisma-adapter": "./src/prisma-adapter.ts",
    "./tenant-context": "./src/tenant-context.ts",
    "./risk-analysis": "./src/risk-analysis.ts",
    "./notification": "./src/notification.ts",
    "./staff-client-access": "./src/staff-client-access.ts",
    "./tenant-settings": "./src/tenant-settings.ts",
    "./tenant-modules": "./src/tenant-modules.ts",
    "./workflow-lifecycle": "./src/workflow-lifecycle.ts",
    "./workflow-feedback": "./src/workflow-feedback.ts",
    "./pg-tools": "./src/pg-tools.ts",
    "./restore-security": "./src/restore-security.ts",
    "./fido-mds-snapshot": "./src/fido-mds-snapshot.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run",
    "prisma": "prisma",
    "generate": "prisma generate",
    "migrate:deploy": "node scripts/migrate-deploy.mjs",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "seed": "tsx --env-file-if-exists=../../.env seeds/dev.ts",
    "provision": "tsx --env-file-if-exists=../../.env seeds/provision.ts",
    "provision:n8n": "tsx --env-file-if-exists=../../.env seeds/provision-n8n.ts",
    "reset-admin-password": "tsx --env-file-if-exists=../../.env ../../apps/web/scripts/reset-admin-password.ts",
    "verify:migration-ledger": "node --env-file-if-exists=../../.env scripts/verify-migration-ledger.mjs --after-deploy",
    "test:migration-ledger": "node --test scripts/migration-ledger.node-test.mjs",
    "test:migrate-deploy": "node --test scripts/migrate-deploy.node-test.mjs",
    "verify:migration-line-endings": "node scripts/check-migration-line-endings.mjs",
    "verify:invariants": "node --env-file-if-exists=../../.env scripts/check-db-invariants.mjs",
    "verify:schema-drift": "tsx --env-file-if-exists=../../.env scripts/verify-drift.ts",
    "verify:rls": "tsx --env-file-if-exists=../../.env scripts/verify-rls.ts",
    "verify:fk-indexes": "tsx --env-file-if-exists=../../.env scripts/verify-fk-indexes.ts",
    "secret-box:rewrap": "tsx --env-file-if-exists=../../.env scripts/rewrap-secret-box.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@taxtronik/config": "workspace:*",
    "@taxtronik/crypto": "workspace:*",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "4.1.11"
  }
}
