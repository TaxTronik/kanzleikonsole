model WorkflowInstance {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  clientId       String                   @map("client_id") @db.Uuid
  // Nullable: ein „eigener Workflow (einmalig)" wird OHNE Vorlage gestartet
  // (Name frei, Schritte ad-hoc via AddStepForm) — nur templatebasierte Instanzen
  // tragen eine templateId.
  templateId     String?                  @map("template_id") @db.Uuid
  name           String
  status         WorkflowInstanceStatus   @default(ACTIVE)
  startedAt      DateTime                 @default(now()) @map("started_at")
  completedAt    DateTime?                @map("completed_at")
  startedByStaff String                   @map("started_by_staff") @db.Uuid
  notes          String?
  pausedUntil    DateTime?                @map("paused_until") @db.Timestamptz(6)
  // Optionaler Sachverhalts-Bezug: ein aus dem Subsumtions-Tab gestarteter
  // Workflow gehört zu genau dieser Analyse (SET NULL überlebt Analyse-Löschung).
  analysisId     String?                  @map("analysis_id") @db.Uuid
  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workflow_instance_client_fkey")
  template       WorkflowTemplate?        @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "workflow_instance_template_fkey")
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workflow_instance_tenant_fkey")
  analysis       RiskAnalysis?            @relation(fields: [analysisId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "workflow_instance_analysis_fk")
  members        WorkflowInstanceMember[]
  items          WorkflowItem[]

  @@index([tenantId, clientId, status])
  @@index([tenantId, status, startedAt])
  @@index([tenantId, analysisId])
  @@index([tenantId, templateId])
  @@map("workflow_instance")
}

/// Mitglieder einer Workflow-Instanz — der „Pool" von Mitarbeitern, die am
/// Vorgang beteiligt sind. Pro Item kann der Bearbeiter (`assigneeStaffId`)
/// frei zugewiesen / übergeben werden — die Member-Liste ist die offizielle
/// Übersicht „wer arbeitet hier mit". Beim Start wählt der Starter Mitglieder
/// aus; spätere Änderungen via UI.
model WorkflowInstanceMember {
  instanceId String           @map("instance_id") @db.Uuid
  staffId    String           @map("staff_id") @db.Uuid
  role       String?
  addedAt    DateTime         @default(now()) @map("added_at") @db.Timestamptz(6)
  addedBy    String           @map("added_by") @db.Uuid
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wf_instance_member_instance_fk")

  @@id([instanceId, staffId], map: "wf_instance_member_pk")
  @@index([staffId], map: "wf_instance_member_staff_idx")
  @@map("workflow_instance_member")
}

model WorkflowItem {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId           String                   @map("instance_id") @db.Uuid
  position             Int
  title                String
  description          String?
  assigneeStaffId      String?                  @map("assignee_staff_id") @db.Uuid
  skillId              String?                  @map("skill_id") @db.Uuid
  dueDate              DateTime?                @map("due_date") @db.Date
  doneAt               DateTime?                @map("done_at")
  doneByStaff          String?                  @map("done_by_staff") @db.Uuid
  notes                String?
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  kind                 WorkflowStepKind         @default(TASK)
  config               Json                     @default("{}")
  n8nEvent             String?                  @map("n8n_event")
  startedAt            DateTime?                @map("started_at") @db.Timestamptz(6)
  documents            Document[]
  triggeredSubmissions FormSubmission[]
  triggeredRequests    Request[]
  instance             WorkflowInstance         @relation(fields: [instanceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workflow_item_instance_fkey")
  skill                StaffSkill?              @relation(fields: [skillId], references: [id], onUpdate: NoAction, map: "workflow_item_skill_fkey")
  comments             WorkflowItemComment[]
  emailRecipients      WorkflowEmailRecipient[]
  n8nDispatch          WorkflowN8nDispatch?

  @@index([instanceId, position])
  @@index([assigneeStaffId, doneAt])
  @@index([skillId])
  @@map("workflow_item")
}

/// Persistenter Versandzustand je Empfänger eines CLIENT_EMAIL-Schritts.
/// Erfolgreiche Empfänger bleiben bei einem Teilfehler als versendet markiert
/// und werden bei einem Retry nicht erneut angeschrieben.
model WorkflowEmailRecipient {
  id             String       @id(map: "wf_email_recipient_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId         String       @map("item_id") @db.Uuid
  recipientEmail String       @map("recipient_email") @db.Citext
  recipientName  String       @map("recipient_name")
  subject        String
  bodyText       String       @map("body_text")
  bodyHtml       String       @map("body_html")
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(6)
  sentAt         DateTime?    @map("sent_at") @db.Timestamptz(6)
  attemptCount   Int          @default(0) @map("attempt_count")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  item           WorkflowItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wf_email_recipient_item_fk")

  @@unique([itemId, recipientEmail], map: "wf_email_recipient_item_email_uq")
  @@index([itemId, sentAt], map: "wf_email_recipient_pending_idx")
  @@map("workflow_email_recipient")
}

/// Dauerhafte Workflow-Event-Absicht. Sie wird in derselben Transaktion wie
/// der fachliche Schritteffekt angelegt und durch App oder Worker mit einem
/// stabilen n8n-Outbox-Dedupe-Key verarbeitet.
model WorkflowN8nDispatch {
  id           String       @id(map: "wf_n8n_dispatch_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId       String       @unique(map: "wf_n8n_dispatch_item_uq") @map("item_id") @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  /// Staff-Akteur der ursprünglichen, dauerhaft gespeicherten Ausführungsabsicht.
  /// Bewusst ohne FK: Audit-/Recovery-Zuordnung muss ausgeschiedene Nutzer überleben.
  actorStaffId String       @map("actor_staff_id") @db.Uuid
  event        String
  payload      Json
  claimedAt    DateTime?    @map("claimed_at") @db.Timestamptz(6)
  enqueuedAt   DateTime?    @map("enqueued_at") @db.Timestamptz(6)
  outboxId     String?      @map("outbox_id") @db.Uuid
  attemptCount Int          @default(0) @map("attempt_count")
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  item         WorkflowItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wf_n8n_dispatch_item_fk")
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wf_n8n_dispatch_tenant_fk")

  @@index([enqueuedAt, claimedAt, createdAt], map: "wf_n8n_dispatch_pending_idx")
  @@map("workflow_n8n_dispatch")
}

/// Mehrfach-Kommentare pro Workflow-Schritt — anders als `notes` (ein Feld
/// pro Item) ist hier eine Diskussion über die Zeit möglich. Autor wird
/// nicht über FK auf staff_user gebunden, weil Mitarbeiter ausscheiden
/// können — der Name wird als Snapshot gespeichert.
model WorkflowItemComment {
  id            String       @id(map: "wf_item_comment_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String       @map("item_id") @db.Uuid
  authorStaffId String       @map("author_staff_id") @db.Uuid
  authorName    String       @map("author_name")
  body          String
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  item          WorkflowItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wf_item_comment_item_fk")

  @@index([itemId, createdAt], map: "wf_item_comment_item_idx")
  @@map("workflow_item_comment")
}

model FormTemplate {
