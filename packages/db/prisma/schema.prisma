model Invoice {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  clientId            String            @map("client_id") @db.Uuid
  number              String
  issueDate           DateTime          @map("issue_date") @db.Date
  dueDate             DateTime          @map("due_date") @db.Date
  status              InvoiceStatus     @default(DRAFT)
  format              InvoiceFormat     @default(PDF)
  subject             String
  netAmount           Decimal           @map("net_amount") @db.Decimal(12, 2)
  vatAmount           Decimal           @map("vat_amount") @db.Decimal(12, 2)
  totalAmount         Decimal           @map("total_amount") @db.Decimal(12, 2)
  // iter86: NULL bei Mischsätzen (Satz lebt an den Positionen); bei
  // einheitlichem Satz redundant gesetzt (Anzeige/CSV, Bestandsdaten).
  vatRate             Decimal?          @map("vat_rate") @db.Decimal(5, 2)
  // iter98: Leistungszeitraum (§ 14 Abs. 4 Nr. 6 UStG, § 31 Abs. 4 UStDV —
  // Monat genügt). NULL = kein separater Zeitraum → der Empfänger-Vorsteuer-
  // abzug knüpft dann an das Rechnungsdatum. In XRechnung als BG-14
  // (BT-73/BT-74), im ZUGFeRD-PDF als Klartext ausgewiesen.
  servicePeriodStart  DateTime?         @map("service_period_start") @db.Date
  servicePeriodEnd    DateTime?         @map("service_period_end") @db.Date
  // iter101: Befreiungsgrund für 0 %-Umsätze (§ 14 Abs. 4 Nr. 8 UStG; z. B.
  // „§ 19 UStG Kleinunternehmer", „steuerfrei nach § 4 Nr. …"). NULL = kein
  // 0 %-Umsatz. In XRechnung als BT-120 (Kategorie „E") ausgewiesen.
  vatExemptionReason  String?           @map("vat_exemption_reason")
  // Reverse-Charge (§ 13b UStG, EN16931 USt-Kategorie AE): der Leistungs-
  // empfänger schuldet die Steuer, Positionen sind 0 %. Nur DRAFT-setzbar,
  // danach festgeschrieben (iter107).
  reverseCharge       Boolean           @default(false) @map("reverse_charge")
  notes               String?
  sentAt              DateTime?         @map("sent_at")
  paidAt              DateTime?         @map("paid_at")
  documentId          String?           @map("document_id") @db.Uuid
  /// Kanonische separate XRechnung-XML zum selben Snapshot wie die
  /// ZUGFeRD-Hybrid-PDF. Eigener 1:1-Link statt Titelheuristik.
  xrechnungDocumentId String?           @unique(map: "invoice_xrechnung_document_unique") @map("xrechnung_document_id") @db.Uuid
  createdByStaff      String            @map("created_by_staff") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  categoryId          String?           @map("category_id") @db.Uuid
  // iter100: Storno-Verkettung. stornoOfId zeigt von der Stornorechnung
  // (TypeCode 381, negierte Beträge) auf die stornierte Originalrechnung.
  stornoOfId          String?           @map("storno_of_id") @db.Uuid
  stornoOf            Invoice?          @relation("InvoiceStorno", fields: [stornoOfId], references: [id], onUpdate: NoAction, onDelete: NoAction, map: "invoice_storno_of_fkey")
  stornoBy            Invoice[]         @relation("InvoiceStorno")
  category            InvoiceCategory?  @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  client              Client            @relation(fields: [clientId], references: [id])
  document            Document?         @relation("InvoicePrimaryDocument", fields: [documentId], references: [id])
  xrechnungDocument   Document?         @relation("InvoiceXrechnungDocument", fields: [xrechnungDocumentId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "invoice_xrechnung_document_fkey")
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  positions           InvoicePosition[]
  timeEntries         TimeEntry[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, dueDate])
  @@index([tenantId, categoryId], map: "invoice_tenant_category_idx")
  @@index([tenantId, documentId])
  // iter100: FK-Index auf die Storno-Verkettung (von iter100-Migration angelegt).
  @@index([stornoOfId], map: "invoice_storno_of_idx")
  // iter71: pg_trgm-GIN für die globale Suche (Rechnungsnr. + Betreff)
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "invoice_number_trgm_idx")
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "invoice_subject_trgm_idx")
  @@map("invoice")
}

/// Rechnungstypen für EXTERNAL-Modus (PDF-Upload aus zentraler Software).
/// Pro Typ kann ein E-Mail-Template-Slug hinterlegt sein — der Begleittext
/// der Mail an den Mandanten richtet sich nach dem Rechnungstyp.
// iter85 (GoB): Nummernkreis für die automatische, lückenlose Rechnungsnummern-
// Vergabe je Tenant+Jahr (Format YYYY-NNNN). Vergabe NUR über
// allocateInvoiceNumber (apps/web/src/server/invoicing/number.ts) — atomar
// unter Advisory-Lock in der Anlage-Tx; zählt nur bei erfolgreichem INSERT
// hoch, daher lückenlos. EXTERNAL-Rechnungen nutzen die Fremdsystem-Nummer
// und gehen an der Sequenz vorbei.
model InvoiceNumberSeq {
  tenantId String @map("tenant_id") @db.Uuid
  year     Int
  lastNo   Int    @default(0) @map("last_no")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, year])
  @@map("invoice_number_seq")
}

