/// Reine Kanzlei-Zusammenarbeit an einer Anforderung. Diese Zeilen werden nie
/// in Portal-Abfragen aufgenommen und lösen keine Mandanten-Mail aus.
model RequestInternalComment {
  id            String   @id(map: "request_internal_comment_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
