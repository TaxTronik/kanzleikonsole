/// Welche Aktion löst dieser Schritt aus, wenn er „dran" ist?
/// - TASK             : reine Checkliste (Häkchen). Default.
/// - DOCUMENT_UPLOAD  : Mitarbeiter lädt ein Dokument hoch; config.expectedClassification gibt die GoBD-Klasse vor.
/// - CLIENT_REQUEST   : Erzeugt eine Anforderung an den Mandanten (config: requestTitle, description, priority, dueAfterDays).
/// - CLIENT_FORM      : Erzeugt eine FormSubmission aus einer FormTemplate (config: formTemplateId). Magic-Link geht raus.
/// - CLIENT_EMAIL     : Sendet eine E-Mail an den Mandanten (config: subject, bodyMd).
/// - N8N_TRIGGER      : Feuert nur den n8n-Webhook (n8nEvent muss gesetzt sein).
enum WorkflowStepKind {
  TASK
  DOCUMENT_UPLOAD
  CLIENT_REQUEST
  CLIENT_FORM
  CLIENT_EMAIL
  N8N_TRIGGER
}

