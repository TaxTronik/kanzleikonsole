model Document {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String                 @map("tenant_id") @db.Uuid
  clientId                  String?                @map("client_id") @db.Uuid
  ownerStaffId              String?                @map("owner_staff_id") @db.Uuid
  title                     String
  classification            DocumentClassification
  mimeType                  String                 @map("mime_type")
  retentionUntil            DateTime?              @map("retention_until")
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")
  workflowItemId            String?                @map("workflow_item_id") @db.Uuid
  // Optionaler Sachverhalts-Bezug (Aktenregal-Tab): Dokument gehört zu genau
  // dieser RiskAnalysis. Analog workflowItemId. SET NULL bei Analyse-Löschung.
  analysisId                String?                @map("analysis_id") @db.Uuid
  acknowledgedAt            DateTime?              @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedByStaff       String?                @map("acknowledged_by_staff") @db.Uuid
  // Soft-Delete: GoBD-Objekte liegen unter COMPLIANCE, GwG-Objekte unter
  // GOVERNANCE plus bestätigtem Vernichtungsworkflow. Reguläres "Löschen"
  // blendet nur aus — physische Vernichtung erfolgt ausschließlich regelkonform.
  deletedAt                 DateTime?              @map("deleted_at") @db.Timestamptz(6)
  deletedByStaff            String?                @map("deleted_by_staff") @db.Uuid
  deleteReason              String?                @map("delete_reason")
  /// Zweiphasige GwG-Vernichtung: Zuerst wird die Absicht transaktional
  /// protokolliert, danach werden die Object-Store-Bytes idempotent gelöscht
  /// und erst dann die DB-Versionen kontrolliert entfernt. Ein Crash bleibt so
  /// als wiederaufnehmbarer PENDING-Zustand sichtbar statt als Halbzustand.
  gwgDestructionRequestedAt DateTime?              @map("gwg_destruction_requested_at") @db.Timestamptz(6)
  gwgDestructionRequestedBy String?                @map("gwg_destruction_requested_by") @db.Uuid
  gwgDestructionError       String?                @map("gwg_destruction_error")
  gwgDestroyedAt            DateTime?              @map("gwg_destroyed_at") @db.Timestamptz(6)
  /// Explizite Herkunft von über das anonyme GwG-Onboarding hochgeladenen
  /// Belegen. Ersetzt für Retention-Zwecke die bisherige lose JSON-ID-Liste.
  gwgOnboardingInviteId     String?                @map("gwg_onboarding_invite_id") @db.Uuid
  /// Anhang einer Wiedervorlage. Analog workflowItemId/analysisId; SET NULL,
  /// damit das Löschen der Aufgabe die Datei in der Akte belässt.
  reminderId                String?                @map("reminder_id") @db.Uuid
  /// Herkunft eines noch nicht abgesendeten Formular-Uploads. Die explizite
  /// Zuordnung verhindert, dass eine frei übermittelte Dokument-UUID zum
  /// Löschen oder Absenden in einem anderen Formular/Feld verwendet wird.
  formSubmissionId          String?                @map("form_submission_id") @db.Uuid
  formFieldKey              String?                @map("form_field_key")
  // Mandanten-Freigabe (Opt-in): NULL = privat (nur Kanzlei sieht es),
  // gesetzt = im Mandantenportal sichtbar. Vom Mandanten selbst hochgeladene
  // Dokumente (Portal-Upload, Anforderungs-Antwort) werden bei Anlage
  // automatisch geteilt; Staff-Uploads bleiben privat bis zur Freigabe.
  sharedWithClientAt        DateTime?              @map("shared_with_client_at") @db.Timestamptz(6)
  sharedByStaff             String?                @map("shared_by_staff") @db.Uuid
  // Organisatorischer Ordner (frei anlegbar, pro Mandant bzw. kanzlei-intern).
  // UNABHÄNGIG von classification — die treibt Retention/Bucket, der Ordner
  // ist reine Ablage-Struktur. SET NULL bei Ordner-Löschung (Dokument bleibt).
  folderId                  String?                @map("folder_id") @db.Uuid
  // onUpdate: NoAction — die Migration iter54_document_folders hat den FK
  // ohne ON UPDATE-Klausel angelegt (Postgres-Default NO ACTION). Ohne
  // explizite Annotation würde Prisma 7 ON UPDATE CASCADE annehmen und
  // Drift melden.
  folder                    DocumentFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Datei-Typ (7 Kern-Typen read-only + kanzlei-eigene). Der Typ trägt die
  // Schutzstufe (KEINE/GWG/GOBD), die Bucket + Object-Lock + Frist steuert.
  // `classification` bleibt als Back-Compat-Spalte; neue Logik leitet die
  // Stufe aus documentType ab (bzw. aus classification für Altbestand).
  documentTypeId            String?                @map("document_type_id") @db.Uuid
  // onUpdate: NoAction — analog zu folder oben (iter55_document_types).
  documentType              DocumentType?          @relation(fields: [documentTypeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  client                    Client?                @relation(fields: [clientId], references: [id])
  tenant                    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowItem              WorkflowItem?          @relation(fields: [workflowItemId], references: [id], onUpdate: NoAction, map: "document_workflow_item_fk")
  analysis                  RiskAnalysis?          @relation("AnalysisAttachedDocs", fields: [analysisId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "document_analysis_fk")
  reminder                  ClientReminder?        @relation("ReminderAttachments", fields: [reminderId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "document_reminder_fk")
  formSubmission            FormSubmission?        @relation("FormSubmissionUploads", fields: [formSubmissionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "document_form_submission_fkey")
  gwgOnboardingInvite       GwgOnboardingInvite?   @relation(fields: [gwgOnboardingInviteId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "document_gwg_invite_fk")
  versions                  DocumentVersion[]
  gwgIdDocuments            GwgIdDocument[]
  invoiceAttachments        Invoice[]              @relation("InvoicePrimaryDocument")
  xrechnungInvoice          Invoice?               @relation("InvoiceXrechnungDocument")
  requestResponses          RequestResponse[]
  riskAnalyses              RiskAnalysis[]         @relation("AnalysisSourceDoc")
  absences                  Absence[]
  taxFilings                TaxFiling[]
  taxNotices                TaxNotice[]
  researchShelfResult       RiskResearchResult?    @relation("ResearchResultShelfDocument")

  @@index([tenantId, clientId])
  @@index([tenantId, classification])
  @@index([tenantId, deletedAt])
  @@index([tenantId, folderId])
  @@index([tenantId, documentTypeId])
  @@index([clientId, sharedWithClientAt])
  @@index([clientId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workflowItemId], map: "document_workflow_item_idx")
  @@index([tenantId, analysisId])
  @@index([tenantId, reminderId], map: "document_reminder_idx")
  @@index([tenantId, formSubmissionId, formFieldKey], map: "document_form_submission_idx")
  @@index([gwgOnboardingInviteId], map: "document_gwg_invite_idx")
  // iter71: pg_trgm-GIN für die globale Suche (Dokument-Titel)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "document_title_trgm_idx")
  @@map("document")
}

/// Datei-Typen pro Kanzlei. 7 Kern-Typen werden je Tenant geseedet
/// (builtin = true, read-only, gesetzlich korrekte Stufe). Die Kanzlei kann
/// eigene Typen ergänzen und ihnen eine der drei Schutzstufen zuweisen.
/// Die Stufe (nicht der Typname) treibt Bucket/Object-Lock/Aufbewahrung.
model DocumentType {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  name              String
  tier              DocumentProtectionTier
  /// Aufbewahrungsintervall des Typs: GOBD 6/8/10 Jahre, GWG technisch 5,
  /// NONE null. Der fachliche Fristbeginn kann zusätzlich ereignisabhängig sein.
  retentionYears    Int?                   @map("retention_years")
  builtin           Boolean                @default(false)
  // Für die 7 Kern-Typen = zugehöriger DocumentClassification-Enum-Wert
  // (Mapping Altbestand ↔ Typ); null bei eigenen Typen.
  classificationKey String?                @map("classification_key")
  active            Boolean                @default(true)
  sortOrder         Int                    @default(0) @map("sort_order")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByStaff    String?                @map("created_by_staff") @db.Uuid
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  // onUpdate: NoAction — iter55_document_types hat den FK ohne ON UPDATE
  // angelegt; explizite Annotation hält Drift-Check stabil.
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documents         Document[]

  // Index-Namen sind in iter55_document_types ohne den Prisma-Konventions-
  // Suffix `_id` angelegt — explizit gemappt, damit der Drift-Check stabil
  // bleibt (Migrationen werden nicht umbenannt, weil sie bereits in
  // bestehenden Installationen appliziert sind).
  @@unique([tenantId, name], map: "document_type_tenant_name_key")
  @@index([tenantId, active], map: "document_type_tenant_active_idx")
  @@map("document_type")
}

/// Schutzstufe — Treiber für Bucket + Object-Lock-Modus. Die konkrete
/// 6-/8-/10-Jahresfrist liegt am DocumentType.
enum DocumentProtectionTier {
  NONE
  GWG
  GOBD

  @@map("document_protection_tier")
}

/// Frei anlegbare Ablage-Ordner. Baum via parentId (self-relation).
/// clientId = null → kanzlei-interner Bereich (mandantenlose Dokumente).
/// Ordner sind reine Organisation: Löschen eines Ordners löscht NIE
/// Dokumente (Aufbewahrung!) — Inhalte werden in den Parent reparentiert.
model DocumentFolder {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  clientId       String?          @map("client_id") @db.Uuid
  parentId       String?          @map("parent_id") @db.Uuid
  name           String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByStaff String?          @map("created_by_staff") @db.Uuid
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  // onUpdate: NoAction — iter54_document_folders hat alle drei FKs ohne
  // ON UPDATE-Klausel angelegt; explizit angeben hält den Drift-Check stabil.
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent         DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children       DocumentFolder[] @relation("FolderTree")
  documents      Document[]

  @@index([tenantId, clientId])
  @@index([parentId])
  @@map("document_folder")
}

model DocumentVersion {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String    @map("document_id") @db.Uuid
  versionNo        Int       @map("version_no")
  storageBucket    String    @map("storage_bucket")
  storageKey       String    @map("storage_key")
  storageVersionId String?   @map("storage_version_id")
  sha256           Bytes
  sizeBytes        BigInt    @map("size_bytes")
  immutable        Boolean   @default(false)
  scanStatus       String    @default("PENDING") @map("scan_status")
  scanCompletedAt  DateTime? @map("scan_completed_at")
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@index([storageBucket, storageKey, storageVersionId], map: "document_version_storage_identity_idx")
  @@map("document_version")
}

model AuditLog {
  id           BigInt         @id @default(autoincrement())
  tenantId     String         @map("tenant_id") @db.Uuid
  // RF-6 (iter77): timestamptz — occurredAt ist hash-relevant (toISOString),
  // timestamp ohne TZ kippte beim Verify in fremder Prozess-TZ.
  occurredAt   DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  action       String
  resourceType String         @map("resource_type")
  resourceId   String?        @map("resource_id")
  before       Json?
  after        Json?
  ip           String?        @db.Inet
  userAgent    String?        @map("user_agent")
  prevHash     Bytes          @map("prev_hash")
  thisHash     Bytes          @map("this_hash")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction)

  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId])
  // RF-16 (iter77): Vorgänger-Lookup in record() (ORDER BY id DESC pro Tenant)
  @@index([tenantId, id])
  @@map("audit_log")
}

model AuditAnchor {
  id                 BigInt   @id @default(autoincrement())
  tenantId           String   @map("tenant_id") @db.Uuid
  fromAuditId        BigInt   @map("from_audit_id")
  topAuditId         BigInt   @map("top_audit_id")
  topHash            Bytes    @map("top_hash")
  previousAnchorHash Bytes    @map("previous_anchor_hash")
  anchorHash         Bytes    @map("anchor_hash")
  tsaRequestBlob     Bytes    @map("tsa_request_blob")
  tsaResponseBlob    Bytes    @map("tsa_response_blob")
  tsaSerial          String?  @map("tsa_serial")
  tsaGenTime         DateTime @map("tsa_gen_time") @db.Timestamptz(6)
  trustAnchored      Boolean  @default(false) @map("trust_anchored")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction)

  @@unique([tenantId, topAuditId])
  @@unique([tenantId, previousAnchorHash])
  @@index([tenantId, id])
  @@index([tenantId, tsaGenTime])
