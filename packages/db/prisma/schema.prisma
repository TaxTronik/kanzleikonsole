  @@map("document_version")
}

model AuditLog {
  id           BigInt         @id @default(autoincrement())
  tenantId     String         @map("tenant_id") @db.Uuid
  // RF-6 (iter77): timestamptz — occurredAt ist hash-relevant (toISOString),
  // timestamp ohne TZ kippte beim Verify in fremder Prozess-TZ.
  occurredAt   DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  action       String
  resourceType String         @map("resource_type")
  resourceId   String?        @map("resource_id")
  before       Json?
  after        Json?
  ip           String?        @db.Inet
  userAgent    String?        @map("user_agent")
  prevHash     Bytes          @map("prev_hash")
  thisHash     Bytes          @map("this_hash")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction)

  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId])
  // RF-16 (iter77): Vorgänger-Lookup in record() (ORDER BY id DESC pro Tenant)
  @@index([tenantId, id])
  @@map("audit_log")
}

model Request {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  clientId              String            @map("client_id") @db.Uuid
  title                 String
  description           String
  priority              RequestPriority   @default(NORMAL)
  status                RequestStatus     @default(OPEN)
  dueAt                 DateTime?         @map("due_at")
  createdByStaff        String            @map("created_by_staff") @db.Uuid
  closedAt              DateTime?         @map("closed_at")
  closedByStaff         String?           @map("closed_by_staff") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  formSubmissionId      String?           @map("form_submission_id") @db.Uuid
  workflowItemId        String?           @map("workflow_item_id") @db.Uuid
  // U-5: Auto-Requests aus gwg-expiry-check verlinken sauber auf das ID-
  // Dokument, dessen Erneuerung sie anstoßen. Vorher musste der Worker mit
  // einer Titel-Substring-Heuristik (`contains: ownerName`) entscheiden, ob
  // bereits ein offener Auto-Request existiert — zwei BeneficialOwners mit
  // ähnlichen Namen („Müller" / „Müller-Schmidt") fielen unter denselben
  // Match und der zweite Request wurde nie angelegt.
  linkedGwgIdDocumentId String?           @map("linked_gwg_id_document_id") @db.Uuid
  client                Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formSubmission        FormSubmission?   @relation(fields: [formSubmissionId], references: [id], onUpdate: NoAction, map: "request_form_submission_fk")
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowItem          WorkflowItem?     @relation(fields: [workflowItemId], references: [id], onUpdate: NoAction, map: "request_workflow_item_fk")
  linkedGwgIdDocument   GwgIdDocument?    @relation(fields: [linkedGwgIdDocumentId], references: [id], onUpdate: NoAction, map: "request_gwg_id_doc_fk")
  responses             RequestResponse[]

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@index([workflowItemId], map: "request_workflow_item_idx")
  @@index([linkedGwgIdDocumentId], map: "request_gwg_id_doc_idx")
  // iter71: pg_trgm-GIN für die globale Suche
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "request_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "request_description_trgm_idx")
  @@map("request")
}

