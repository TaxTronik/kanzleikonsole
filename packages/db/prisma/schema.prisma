model AuditArchive {
  id              BigInt           @id @default(autoincrement())
  tenantId        String           @map("tenant_id") @db.Uuid
  fromAuditId     BigInt           @map("from_audit_id")
  toAuditId       BigInt           @map("to_audit_id")
  // RF-6 (iter77): timestamptz, siehe AuditLog.occurredAt
  fromOccurredAt  DateTime         @map("from_occurred_at") @db.Timestamptz(6)
  toOccurredAt    DateTime         @map("to_occurred_at") @db.Timestamptz(6)
  entryCount      Int              @map("entry_count")
  firstPrevHash   Bytes            @map("first_prev_hash")
  lastThisHash    Bytes            @map("last_this_hash")
  fileSha256      Bytes            @map("file_sha256")
  fileSizeBytes   BigInt           @map("file_size_bytes")
  storageBucket   String           @map("storage_bucket")
  storageKey      String           @map("storage_key")
  tsaResponseBlob Bytes?           @map("tsa_response_blob")
  tsaSerial       String?          @map("tsa_serial")
  mode            AuditArchiveMode @default(SOFT)
  // RF-6 (iter77): timestamptz, siehe AuditLog.occurredAt
  archivedAt      DateTime         @default(now()) @map("archived_at") @db.Timestamptz(6)
  archivedBy      String           @default("system") @map("archived_by")

  @@unique([tenantId, fromAuditId])
  @@index([tenantId, archivedAt])
  @@map("audit_archive")
}

model Appointment {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  ownerStaffId   String               @map("owner_staff_id") @db.Uuid
  createdByStaff String               @map("created_by_staff") @db.Uuid
  clientId       String?              @map("client_id") @db.Uuid
  kind           AppointmentKind      @default(CLIENT_MEETING)
  status         AppointmentStatus    @default(PLANNED)
  title          String
  notes          String?
  location       String?
  startsAt       DateTime             @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime             @map("ends_at") @db.Timestamptz(6)
  fromRequestId  String?              @map("from_request_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client         Client?              @relation(fields: [clientId], references: [id], onUpdate: NoAction)
  createdBy      StaffUser            @relation("appointment_creator", fields: [createdByStaff], references: [id], onUpdate: NoAction)
  fromRequest    AppointmentRequest?  @relation("appointment_from_request", fields: [fromRequestId], references: [id], onUpdate: NoAction, map: "appointment_from_request_fkey")
  owner          StaffUser            @relation("appointment_owner", fields: [ownerStaffId], references: [id], onUpdate: NoAction)
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  acceptedFor    AppointmentRequest[] @relation("appointment_accepted")

  @@index([tenantId, clientId], map: "appointment_tenant_client_idx")
  @@index([tenantId, ownerStaffId], map: "appointment_tenant_owner_idx")
  @@index([tenantId, startsAt], map: "appointment_tenant_starts_idx")
  @@map("appointment")
}

model AppointmentRequest {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                   @map("tenant_id") @db.Uuid
  clientId              String                   @map("client_id") @db.Uuid
  createdByContact      String?                  @map("created_by_contact") @db.Uuid
  preferredStaffId      String?                  @map("preferred_staff_id") @db.Uuid
  subject               String
  notes                 String?
  proposedSlots         Json                     @map("proposed_slots")
  status                AppointmentRequestStatus @default(PENDING)
  acceptedSlot          Json?                    @map("accepted_slot")
  acceptedAppointmentId String?                  @map("accepted_appointment_id") @db.Uuid
  rejectionReason       String?                  @map("rejection_reason")
  decidedByStaff        String?                  @map("decided_by_staff") @db.Uuid
  decidedAt             DateTime?                @map("decided_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  derivedAppointments   Appointment[]            @relation("appointment_from_request")
  acceptedAppointment   Appointment?             @relation("appointment_accepted", fields: [acceptedAppointmentId], references: [id], onUpdate: NoAction, map: "appointment_request_accepted_appointment_fkey")
  client                Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByContactRel   ClientContact?           @relation(fields: [createdByContact], references: [id], onUpdate: NoAction, map: "appointment_request_contact_fkey")
  decidedBy             StaffUser?               @relation("appointment_request_decided", fields: [decidedByStaff], references: [id], onUpdate: NoAction, map: "appointment_request_decided_by_fkey")
  preferredStaff        StaffUser?               @relation("appointment_request_preferred", fields: [preferredStaffId], references: [id], onUpdate: NoAction, map: "appointment_request_preferred_staff_fkey")
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, clientId], map: "appointment_request_client_idx")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "appointment_request_tenant_status_idx")
  @@map("appointment_request")
}

model ClientHandover {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  clientId             String         @map("client_id") @db.Uuid
  label                String
  contents             String?
  status               HandoverStatus @default(RECEIVED)
  receivedAt           DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  startedAt            DateTime?      @map("started_at") @db.Timestamptz(6)
  readyAt              DateTime?      @map("ready_at") @db.Timestamptz(6)
  pickedUpAt           DateTime?      @map("picked_up_at") @db.Timestamptz(6)
  createdByStaff       String         @map("created_by_staff") @db.Uuid
  notifiedContactEmail String?        @map("notified_contact_email")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client               Client         @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_user           StaffUser      @relation(fields: [createdByStaff], references: [id], onUpdate: NoAction)
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clientId, status], map: "client_handover_client_status_idx")
  @@index([tenantId, status], map: "client_handover_tenant_status_idx")
  @@map("client_handover")
}

