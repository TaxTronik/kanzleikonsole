/// Ein konkreter Webhook-Knoten eines n8n-Workflows. Produktions- und
/// Test-URL werden getrennt gespeichert, damit Dev/Test niemals versehentlich
/// einen produktiven Workflow auslöst.
model N8nWebhookEndpoint {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  connectionId      String                 @map("connection_id") @db.Uuid
  name              String
  productionUrl     String                 @map("production_url")
  testUrl           String?                @map("test_url")
  workflowId        String?                @map("workflow_id")
  workflowName      String?                @map("workflow_name")
  workflowNodeId    String?                @map("workflow_node_id")
  source            N8nEndpointSource      @default(CUSTOM)
  enabled           Boolean                @default(true)
  /// Debug-Schalter: echte Event-Zustellungen gehen an die Test-URL
  /// (/webhook-test) statt an die Produktions-URL — zum Anpassen/Debuggen
  /// des Workflows im laufenden Betrieb, ohne die Route zu löschen.
  testMode          Boolean                @default(false) @map("test_mode")
  verifiedAt        DateTime?              @map("verified_at") @db.Timestamptz(6)
  verificationOk    Boolean?               @map("verification_ok")
  verificationError String?                @map("verification_error")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "n8n_webhook_endpoint_tenant_fkey")
  connection        N8nConnection          @relation(fields: [connectionId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "n8n_webhook_endpoint_connection_fkey")
  subscriptions     N8nEventSubscription[]
  deliveries        N8nDelivery[]

  @@unique([id, tenantId], map: "n8n_webhook_endpoint_id_tenant_key")
  @@unique([connectionId, name], map: "n8n_webhook_endpoint_connection_name_key")
  @@index([tenantId, enabled], map: "n8n_webhook_endpoint_tenant_enabled_idx")
  @@map("n8n_webhook_endpoint")
}

/// Explizite Zuordnung eines TaxTronik-Events zu einem konkreten n8n-Webhook.
/// Ein Event darf mehrere Endpoints bedienen (Fan-out), ein Endpoint mehrere
/// Events abonnieren. Fachliche Filter bleiben im n8n-Workflow.
model N8nEventSubscription {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
