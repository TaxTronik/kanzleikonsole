// =============================================================================
// taxtronik — Prisma-Schema
//
// Source-of-Truth für die Datenbank-Struktur und den Prisma-Client (Types).
// RLS-Policies, Audit-Trigger und GwG-Schranken-Trigger werden in der
// Migrations-SQL definiert (siehe prisma/migrations/.../migration.sql),
// weil Prisma diese nicht aus dem Schema ableiten kann.
//
// Schema ist drift-frei gegenüber den Migrationen — siehe
// `pnpm verify:schema-drift` und ADR 0012. Annotationen wie @db.Timestamptz
// und @relation(map:...) / @@index(map:...) wurden via `prisma db pull` aus
// der migrierten DB übernommen, damit die Drift-Check auch nicht-strukturelle
// Diffs (Constraint-Namen, Timestamp-TZ) abdeckt.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm, pgcrypto]
}

model Tenant {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                       String                      @unique
  name                       String
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  appointments               Appointment[]
  appointmentRequests        AppointmentRequest[]
  auditLogs                  AuditLog[]
  auditSeals                 AuditSeal[]
  backupRecords              BackupRecord[]
  bwaPeriods                 BwaPeriod[]
  bwaPlans                   BwaPlan[]
  clients                    Client[]
  clientContacts             ClientContact[]
  clientCustomFieldDefs      ClientCustomFieldDef[]
  clientCustomFieldValues    ClientCustomFieldValue[]
  clientHandovers            ClientHandover[]
  clientMasterChangeRequests ClientMasterChangeRequest[]
  clientReminders            ClientReminder[]
  documents                  Document[]
  documentFolders            DocumentFolder[]
  documentTypes              DocumentType[]
  dsgvoRequests              DsgvoRequest[]
  emailTemplates             EmailTemplate[]
  formSubmissions            FormSubmission[]
  formTemplates              FormTemplate[]
  gwgChecks                  GwgCheck[]
  gwgInvites                 GwgOnboardingInvite[]
  invoices                   Invoice[]
  invoiceCategories          InvoiceCategory[]
  kbArticles                 KbArticle[]
  kbCategories               KbCategory[]
  magicLinks                 MagicLink[]
  n8nOutbox                  N8nOutbox[]
  notifications              Notification[]
  pendingBinders             PendingBinder[]
  phoneNotes                 PhoneNote[]
  poas                       PowerOfAttorney[]
  requests                   Request[]
  requestTemplates           RequestTemplate[]
  riskAnalyses               RiskAnalysis[]
  riskMarkings               RiskMarking[]
  riskResearchRequests       RiskResearchRequest[]
  riskResearchResults        RiskResearchResult[]
  riskPromptTemplates        RiskPromptTemplate[]
  rssFeeds                   RssFeed[]
  serviceProviders           ServiceProvider[]
  staffBookmarks             StaffBookmark[]
  staffNotes                 StaffNote[]
  staffSkills                StaffSkill[]
  staff                      StaffUser[]
  stateMachines              StateMachine[]
  stateMachineStates         StateMachineState[]
  stateMachineTransitions    StateMachineTransition[]
  taxDeadlines               TaxDeadline[]
  taxFilings                 TaxFiling[]
  taxNotices                 TaxNotice[]
  taxScheduleConfigs         TaxScheduleConfig[]
  settings                   TenantSetting[]
  workflowInstances          WorkflowInstance[]
  workflowTemplates          WorkflowTemplate[]

  @@map("tenant")
}

model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_setting")
}

model StaffUser {
  id                           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                     String                      @map("tenant_id") @db.Uuid
  email                        String                      @db.Citext
  fullName                     String                      @map("full_name")
  passwordHash                 String                      @map("password_hash")
  totpSecretEnc                String?                     @map("totp_secret_enc")
  totpEnrolledAt               DateTime?                   @map("totp_enrolled_at")
  // M-3: Setup-Fenster-TTL. Wird beim ersten Secret-Set gesetzt; nach 60 min
  // ohne Confirm wird der Setup-Versuch abgelehnt.
  totpSetupStartedAt           DateTime?                   @map("totp_setup_started_at")
  totpBackupCodes              Json?                       @map("totp_backup_codes")
  active                       Boolean                     @default(true)
  lockedUntil                  DateTime?                   @map("locked_until")
  lastLoginAt                  DateTime?                   @map("last_login_at")
  createdAt                    DateTime                    @default(now()) @map("created_at")
  updatedAt                    DateTime                    @updatedAt @map("updated_at")
  dashboardLayout              Json?                       @map("dashboard_layout")
  taxNewsNotify                Boolean                     @default(false) @map("tax_news_notify")
  failedLoginCount             Int                         @default(0) @map("failed_login_count")
  appointmentsCreated          Appointment[]               @relation("appointment_creator")
  appointmentsOwned            Appointment[]               @relation("appointment_owner")
  appointmentRequestsDecided   AppointmentRequest[]        @relation("appointment_request_decided")
  appointmentRequestsPreferred AppointmentRequest[]        @relation("appointment_request_preferred")
  client_handover              ClientHandover[]
  client_master_change_request ClientMasterChangeRequest[]
  responsibilities             ClientResponsibility[]
  notifications                Notification[]
  phone_note                   PhoneNote[]
  rssFeeds                     RssFeed[]
  sickLeaves                   SickLeave[]
  bookmarks                    StaffBookmark[]
  notes                        StaffNote[]
  roles                        StaffRole[]
  skillAssignments             StaffSkillAssignment[]
  tenant                       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeEntries                  TimeEntry[]
  vacationRequests             VacationRequest[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("staff_user")
}

model VacationRequest {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  staffId      String         @map("staff_id") @db.Uuid
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime       @map("end_date") @db.Date
  workdays     Int
  reason       String?
  status       VacationStatus @default(PENDING)
  decidedBy    String?        @map("decided_by") @db.Uuid
  decidedAt    DateTime?      @map("decided_at")
  decisionNote String?        @map("decision_note")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  staff        StaffUser      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, startDate])
  @@index([tenantId, status])
  @@map("vacation_request")
}

model SickLeave {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  documentId String?   @map("document_id") @db.Uuid
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  document   Document? @relation(fields: [documentId], references: [id])
  staff      StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, startDate])
  @@map("sick_leave")
}

model GwgCheck {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  clientId         String               @map("client_id") @db.Uuid
  status           GwgStatus            @default(DRAFT)
  riskLevel        GwgRiskLevel?        @map("risk_level")
  riskScore        Int?                 @map("risk_score")
  riskBreakdown    Json?                @map("risk_breakdown")
  riskAnswers      Json?                @map("risk_answers")
  validUntil       DateTime?            @map("valid_until")
  verifiedAt       DateTime?            @map("verified_at")
  verifiedBy       String?              @map("verified_by") @db.Uuid
  rejectedReason   String?              @map("rejected_reason")
  notes            String?
  /// GwG § 8 Abs. 4 S. 4 (iter81): Vernichtungsvermerk. Gesetzt, wenn die
  /// Aufzeichnungen des Checks vernichtet wurden (Berechtigte gelöscht,
  /// Ausweis-Details genullt, riskAnswers/notes entfernt). Der Skelett-
  /// Datensatz bleibt als Nachweis, DASS geprüft wurde.
  destroyedAt      DateTime?            @map("destroyed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  beneficialOwners GwgBeneficialOwner[]
  // RF-15 (iter79): NoAction statt Cascade — ein Client-Hard-Delete darf
  // GwG-Akten (5-Jahres-Pflicht, § 8 GwG) nicht mitlöschen. NoAction (statt
  // Restrict), damit die Tenant-Kaskade weiterhin funktioniert.
  client           Client               @relation(fields: [clientId], references: [id], onDelete: NoAction)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idDocuments      GwgIdDocument[]

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@map("gwg_check")
}

model GwgIdDocument {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gwgCheckId     String            @map("gwg_check_id") @db.Uuid
  type           GwgIdDocumentType
  ownerName      String            @map("owner_name")
  documentId     String?           @map("document_id") @db.Uuid
  number         String?
  issuedBy       String?           @map("issued_by")
  issueDate      DateTime?         @map("issue_date") @db.Date
  expiryDate     DateTime?         @map("expiry_date") @db.Date
  verifiedAt     DateTime?         @map("verified_at")
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  document       Document?         @relation(fields: [documentId], references: [id])
  check          GwgCheck          @relation(fields: [gwgCheckId], references: [id], onDelete: Cascade)
  linkedRequests Request[]

  @@index([gwgCheckId])
  @@map("gwg_id_document")
}

model GwgBeneficialOwner {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gwgCheckId   String    @map("gwg_check_id") @db.Uuid
  fullName     String    @map("full_name")
  birthDate    DateTime? @map("birth_date") @db.Date
  birthPlace   String?   @map("birth_place")
  residence    String?
  nationality  String?
  ownershipPct Decimal?  @map("ownership_pct") @db.Decimal(5, 2)
  isPep        Boolean   @default(false) @map("is_pep")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  check        GwgCheck  @relation(fields: [gwgCheckId], references: [id], onDelete: Cascade)

  @@index([gwgCheckId])
  @@map("gwg_beneficial_owner")
}

model ServiceProvider {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  category         String
  hasDataAccess    Boolean   @default(false) @map("has_data_access")
  contactEmail     String?   @map("contact_email")
  contractFromDate DateTime? @map("contract_from_date") @db.Date
  contractToDate   DateTime? @map("contract_to_date") @db.Date
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("service_provider")
}

model PowerOfAttorney {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  clientId              String    @map("client_id") @db.Uuid
  signerContactId       String?   @map("signer_contact_id") @db.Uuid
  signerEmail           String    @map("signer_email") @db.Citext
  signerName            String    @map("signer_name")
  subject               String
  scope                 String
  validFrom             DateTime  @map("valid_from") @db.Date
  validUntil            DateTime? @map("valid_until") @db.Date
  status                PoaStatus @default(DRAFT)
  signingTokenHash      String?   @map("signing_token_hash")
  signingTokenExpiresAt DateTime? @map("signing_token_expires_at")
  signingOtpHash        String?   @map("signing_otp_hash")
  signingOtpExpiresAt   DateTime? @map("signing_otp_expires_at")
  signedAt              DateTime? @map("signed_at")
  signedByIp            String?   @map("signed_by_ip") @db.Inet
  signedByUserAgent     String?   @map("signed_by_user_agent")
  documentId            String?   @map("document_id") @db.Uuid
  createdByStaff        String    @map("created_by_staff") @db.Uuid
  revokedAt             DateTime? @map("revoked_at")
  revokedReason         String?   @map("revoked_reason")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  signingOtpAttempts    Int       @default(0) @map("signing_otp_attempts")
  // Audit 2026-06 Befund 2: lebenszyklus-weiter Fehlversuchszähler. Anders als
  // signingOtpAttempts wird er beim OTP-Re-Issue NICHT zurückgesetzt — nur beim
  // Versand eines neuen Signatur-Tokens (sendForSignatureAction). Deckelt die
  // Gesamtversuche pro Token-Lebenszyklus (vorher ~50 über Re-Issue-Resets).
  signingOtpAttemptsTotal Int     @default(0) @map("signing_otp_attempts_total")
  // RF-15 (iter79): NoAction statt Cascade — signierte Vollmachten dürfen
  // einen Client-Hard-Delete nicht mitsterben (Aufbewahrung/Beweiswert).
  client                Client    @relation(fields: [clientId], references: [id], onDelete: NoAction)
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([signingTokenHash])
  @@map("power_of_attorney")
}

model N8nOutbox {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?         @map("tenant_id") @db.Uuid
  event       String
  payload     Json
  occurredAt  DateTime        @default(now()) @map("occurred_at")
  attempts    Int             @default(0)
  status      N8nOutboxStatus @default(PENDING)
  lastError   String?         @map("last_error")
  deliveredAt DateTime?       @map("delivered_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("n8n_outbox")
}

model KbCategory {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  slug      String
  parentId  String?      @map("parent_id") @db.Uuid
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  articles  KbArticle[]
  parent    KbCategory?  @relation("KbCategoryHierarchy", fields: [parentId], references: [id])
  children  KbCategory[] @relation("KbCategoryHierarchy")
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("kb_category")
}

model KbArticle {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String                   @map("tenant_id") @db.Uuid
  categoryId String?                  @map("category_id") @db.Uuid
  title      String
  slug       String
  body       String
  search_vec Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('german'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('german'::regconfig, COALESCE(body, ''::text)), 'B'::\"char\"))"))
  authorId   String                   @map("author_id") @db.Uuid
  published  Boolean                  @default(true)
  viewCount  Int                      @default(0) @map("view_count")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")
  category   KbCategory?              @relation(fields: [categoryId], references: [id])
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, categoryId])
  @@index([tenantId, published])
  @@index([search_vec], type: Gin)
  @@map("kb_article")
}

model Invoice {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  clientId       String            @map("client_id") @db.Uuid
  number         String
  issueDate      DateTime          @map("issue_date") @db.Date
  dueDate        DateTime          @map("due_date") @db.Date
  status         InvoiceStatus     @default(DRAFT)
  format         InvoiceFormat     @default(PDF)
  subject        String
  netAmount      Decimal           @map("net_amount") @db.Decimal(12, 2)
  vatAmount      Decimal           @map("vat_amount") @db.Decimal(12, 2)
  totalAmount    Decimal           @map("total_amount") @db.Decimal(12, 2)
  vatRate        Decimal           @map("vat_rate") @db.Decimal(5, 2)
  notes          String?
  sentAt         DateTime?         @map("sent_at")
  paidAt         DateTime?         @map("paid_at")
  documentId     String?           @map("document_id") @db.Uuid
  createdByStaff String            @map("created_by_staff") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  categoryId     String?           @map("category_id") @db.Uuid
  category       InvoiceCategory?  @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  client         Client            @relation(fields: [clientId], references: [id])
  document       Document?         @relation(fields: [documentId], references: [id])
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  positions      InvoicePosition[]
  timeEntries    TimeEntry[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, dueDate])
  @@index([tenantId, categoryId], map: "invoice_tenant_category_idx")
  // iter71: pg_trgm-GIN für die globale Suche (Rechnungsnr. + Betreff)
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "invoice_number_trgm_idx")
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "invoice_subject_trgm_idx")
  @@map("invoice")
}

/// Rechnungstypen für EXTERNAL-Modus (PDF-Upload aus zentraler Software).
/// Pro Typ kann ein E-Mail-Template-Slug hinterlegt sein — der Begleittext
/// der Mail an den Mandanten richtet sich nach dem Rechnungstyp.
model InvoiceCategory {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String
  slug              String
  emailTemplateSlug String?   @map("email_template_slug")
  active            Boolean   @default(true)
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invoices          Invoice[]
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, slug], map: "invoice_category_tenant_slug_key")
  @@index([tenantId, active], map: "invoice_category_tenant_active_idx")
  @@map("invoice_category")
}

model InvoicePosition {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  position    Int
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  unit        String  @default("Stück")
  netAmount   Decimal @map("net_amount") @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@map("invoice_position")
}

model TimeEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  clientId    String?   @map("client_id") @db.Uuid
  description String
  startedAt   DateTime  @map("started_at")
  endedAt     DateTime? @map("ended_at")
  billable    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  invoiceId   String?   @map("invoice_id") @db.Uuid
  hourlyRate  Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  staff       StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, startedAt])
  @@index([tenantId, clientId, startedAt])
  @@index([tenantId, clientId, billable, invoiceId])
  @@map("time_entry")
}

model BwaPeriod {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  clientId     String        @map("client_id") @db.Uuid
  periodType   BwaPeriodType @map("period_type")
  periodKey    String        @map("period_key")
  fromDate     DateTime      @map("from_date") @db.Date
  toDate       DateTime      @map("to_date") @db.Date
  source       BwaSource
  sourceRef    String?       @map("source_ref")
  importedById String        @map("imported_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  basedPlans   BwaPlan[]     @relation("BwaPlanBasePeriod")
  positions    BwaPosition[]

  @@unique([tenantId, clientId, periodKey])
  @@index([tenantId, clientId, fromDate])
  @@map("bwa_period")
}

model BwaPlan {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  name          String
  year          Int
  basePeriodId  String?       @map("base_period_id") @db.Uuid
  notes         String?
  status        String        @default("DRAFT")
  createdBy     String        @map("created_by") @db.Uuid
  createdByType String        @map("created_by_type")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")
  updatedBy     String?       @map("updated_by") @db.Uuid
  updatedByType String?       @map("updated_by_type")
  basePeriod    BwaPeriod?    @relation("BwaPlanBasePeriod", fields: [basePeriodId], references: [id], onUpdate: NoAction, map: "bwa_plan_base_period_fk")
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bwa_plan_client_fk")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bwa_plan_tenant_fk")
  lines         BwaPlanLine[]

  @@index([tenantId, clientId, year(sort: Desc)], map: "bwa_plan_tenant_client_year_idx")
  @@map("bwa_plan")
}

model BwaPlanLine {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId String  @map("plan_id") @db.Uuid
  axis   String
  amount Decimal @db.Decimal(14, 2)
  note   String?
  plan   BwaPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bwa_plan_line_plan_fk")

