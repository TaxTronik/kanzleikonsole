model TaxDeadline {
  id                                   String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                             String                        @map("tenant_id") @db.Uuid
  clientId                             String                        @map("client_id") @db.Uuid
  configId                             String?                       @map("config_id") @db.Uuid
  kind                                 TaxScheduleKind
  period                               String
  dueDate                              DateTime                      @map("due_date") @db.Date
  status                               TaxDeadlineStatus             @default(PLANNED)
  requestId                            String?                       @unique(map: "tax_deadline_request_unique") @map("request_id") @db.Uuid
  amountDue                            Decimal?                      @map("amount_due") @db.Decimal(12, 2)
  notes                                String?
  completedAt                          DateTime?                     @map("completed_at")
  completedByStaff                     String?                       @map("completed_by_staff") @db.Uuid
  /// Interne Vorwarnung versendet (Auto-Anforderungs-Pipeline, Stufe 3a).
  staffNotifiedAt                      DateTime?                     @map("staff_notified_at") @db.Timestamptz(6)
  /// Auto-Anforderung durch Mitarbeiter gestoppt (aufhebbar); ohne FK wie
  /// completedByStaff.
  autoRequestSuppressedAt              DateTime?                     @map("auto_request_suppressed_at") @db.Timestamptz(6)
  autoRequestSuppressedByStaff         String?                       @map("auto_request_suppressed_by_staff") @db.Uuid
  /// Kurzlebiger transaktionaler CAS-Claim für die Auto-Anforderung. Bei
  /// Rollback verschwindet er zusammen mit dem gesamten Erzeugungsversuch.
  autoRequestClaimedAt                 DateTime?                     @map("auto_request_claimed_at") @db.Timestamptz(6)
  /// Zustellung der zu diesem Termin angelegten Portal-Anforderung. Der
  /// Status beschreibt ausschließlich den technischen Benachrichtigungsweg;
  /// er ist weder Request-Status noch Zugangs-/Kenntnisnahmenachweis.
  autoRequestNotificationStatus        TaxDeadlineNotificationStatus @default(NOT_REQUIRED) @map("auto_request_notification_status")
  autoRequestNotificationAttemptCount  Int                           @default(0) @map("auto_request_notification_attempt_count")
  autoRequestNotificationLastAttemptAt DateTime?                     @map("auto_request_notification_last_attempt_at") @db.Timestamptz(6)
  autoRequestNotificationNextAttemptAt DateTime?                     @map("auto_request_notification_next_attempt_at") @db.Timestamptz(6)
  autoRequestNotificationAcceptedAt    DateTime?                     @map("auto_request_notification_accepted_at") @db.Timestamptz(6)
  autoRequestNotificationLastError     String?                       @map("auto_request_notification_last_error")
  autoRequestNotificationEscalatedAt   DateTime?                     @map("auto_request_notification_escalated_at") @db.Timestamptz(6)
  createdAt                            DateTime                      @default(now()) @map("created_at")
  updatedAt                            DateTime                      @updatedAt @map("updated_at")
  client                               Client                        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tax_deadline_client_fkey")
  config                               TaxScheduleConfig?            @relation(fields: [configId], references: [id], onUpdate: NoAction, map: "tax_deadline_config_fkey")
  tenant                               Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tax_deadline_tenant_fkey")
  autoRequest                          Request?                      @relation("TaxDeadlineAutoRequest")
  request                              Request?                      @relation("TaxDeadlineRequestPointer", fields: [requestId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "tax_deadline_request_fk")

  @@unique([tenantId, clientId, kind, period])
  @@index([tenantId, dueDate])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, configId])
  @@index([tenantId, autoRequestNotificationStatus, autoRequestNotificationNextAttemptAt], map: "tax_deadline_notification_retry_idx")
  @@map("tax_deadline")
}

/// Unveränderbarer technischer Benachrichtigungsnachweis für einen im Zuge
/// einer Neu-Materialisierung entfernten Steuertermin. Namen und Titel werden
/// bewusst nicht dupliziert; die Herkunft bleibt über pseudonyme IDs erhalten.
model TaxDeadlineNotificationHistory {
  id                        String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String                        @map("tenant_id") @db.Uuid
  originalDeadlineId        String                        @unique(map: "tax_deadline_notification_history_deadline_key") @map("original_deadline_id") @db.Uuid
  requestId                 String                        @map("request_id") @db.Uuid
  notificationStatus        TaxDeadlineNotificationStatus @map("notification_status")
  notificationAttemptCount  Int                           @map("notification_attempt_count")
  notificationLastAttemptAt DateTime?                     @map("notification_last_attempt_at") @db.Timestamptz(6)
  notificationNextAttemptAt DateTime?                     @map("notification_next_attempt_at") @db.Timestamptz(6)
  notificationAcceptedAt    DateTime?                     @map("notification_accepted_at") @db.Timestamptz(6)
  notificationErrorRecorded Boolean                       @map("notification_error_recorded")
  notificationLastErrorSha256 Bytes?                      @map("notification_last_error_sha256")
  notificationEscalatedAt   DateTime?                     @map("notification_escalated_at") @db.Timestamptz(6)
  archiveReason             String                        @map("archive_reason")
  archivedAt                DateTime                      @default(dbgenerated("transaction_timestamp()")) @map("archived_at") @db.Timestamptz(6)
  tenant                    Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tax_deadline_notification_history_tenant_fk")
  request                   Request                       @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tax_deadline_notification_history_request_fk")

  @@index([tenantId, archivedAt(sort: Desc)], map: "tax_deadline_notification_history_tenant_archived_idx")
  @@index([tenantId, requestId], map: "tax_deadline_notification_history_request_idx")
  @@map("tax_deadline_notification_history")
}

