model DsgvoRequest {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  type             DsgvoRequestType
  status           DsgvoRequestStatus @default(RECEIVED)
  subjectType      DsgvoSubjectType   @map("subject_type")
  subjectRefId     String?            @map("subject_ref_id") @db.Uuid
  subjectEmail     String             @map("subject_email") @db.Citext
  subjectName      String             @map("subject_name")
  description      String
  resultDocumentId String?            @map("result_document_id") @db.Uuid
  /// Tag, an dem der Antrag tatsächlich eingegangen ist; ab hier läuft die
  /// Monatsfrist nach Art. 12 Abs. 3 DSGVO.
  receivedAt       DateTime           @map("received_at") @db.Date
  dueDate          DateTime?          @map("due_date") @db.Date
  /// Hash des tatsächlich erzeugten Auskunfts-/Portabilitätspakets. So kann
  /// ein Antrag nicht allein per Statusklick als erledigt markiert werden.
  resultSha256     Bytes?             @map("result_sha256")
  resultPreparedAt DateTime?          @map("result_prepared_at")
  resultPreparedBy String?            @map("result_prepared_by") @db.Uuid
