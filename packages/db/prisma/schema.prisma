// S-3: TaxNewsItem ist BEWUSST OHNE tenantId — gemeinsamer Cache pro Feed-URL,
// jeder Tenant filtert sein Dashboard via `WHERE source IN (eigene rss_feed.url)`.
// Begründung: On-Prem-Single-Tenant ist die designierte Deploy-Form von
// taxtronik; ein geteilter Cache spart Worker-Roundtrips und Storage. Für ein
// Multi-Tenant-Hosting müsste hier (a) tenantId nachgezogen werden ODER (b) ein
// klares Trust-Modell „Tenants teilen sich Feed-Caches gutgläubig" dokumentiert
// werden. Bis dahin: KEIN Multi-Tenant-Deploy ohne diesen Pfad anzufassen.
model TaxNewsItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      String
  guid        String
  title       String
  summary     String?
  link        String
  publishedAt DateTime? @map("published_at")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")

  @@unique([source, guid])
  @@index([fetchedAt(sort: Desc)], map: "tax_news_item_fetched_idx")
  @@index([publishedAt(sort: Desc)], map: "tax_news_item_published_idx")
  @@map("tax_news_item")
}

