  @@index([requestId, createdAt], map: "request_internal_comment_request_idx")
  @@map("request_internal_comment")
}

/// Ein Analyse-Lauf der Risk-Layer-Engine (§4, TCMS) über einen Text/ein
/// Dokument. Tenant-scoped (RLS). `rawResult` hält das vollständige Engine-JSON
/// für Audit/Replay (kein Re-Inferieren nötig); die TCMS-/Graph-relevanten
/// Felder (Normketten, Governance) liegen erstklassig pro RiskMarking.
/// `createdById` ist — wie request.created_by_staff — eine reine Mitarbeiter-
/// UUID ohne FK (Mitarbeiter werden deaktiviert, nicht gelöscht).
model RiskAnalysis {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  clientId          String?               @map("client_id") @db.Uuid
  documentId        String?               @map("document_id") @db.Uuid
  // Der analysierte Sachverhalt im Klartext. Nötig, um eine gespeicherte
  // Analyse WIEDER mit dem Highlight-Overlay (Zeichen-Offsets) zu öffnen und um
  // die LLM-Phase 2 zu fahren. Mandanten-Arbeitsprodukt, RLS-geschützt.
  sourceText        String                @map("source_text")
  // Formatierter Sachverhalt als Tiptap/ProseMirror-JSON. sourceText ist die
  // daraus abgeleitete Plaintext-Serialisierung (Engine/Offsets/Hash). null =
  // Alt-Analyse ohne Rich-Doc (Review fällt auf Plaintext-Ansicht zurück).
  sourceDoc         Json?                 @map("source_doc")
  title             String?
  textHash          String                @map("text_hash")
  katalogVersion    String                @map("katalog_version")
  engineVersion     String                @map("engine_version")
  createdById       String                @map("created_by_id") @db.Uuid
  // Engine-rawResult liegt im Object-Store (SeaweedFS, gzip) — reines Audit/
  // Replay-Kaltarchiv, zur Laufzeit ungelesen. Nur die Referenz bleibt in PG.
  rawResultBucket   String?               @map("raw_result_bucket")
  rawResultKey      String?               @map("raw_result_key")
  // Revisionssichere Archivierung (GoBD/§147 AO): self-contained Snapshot
  // (Sachverhalt + Markierungen + Hash) gzip im GoBD-Bucket (Object-Lock).
  // Archivierte Analysen sind schreibgeschützt (Mutationen abgelehnt).
  archivedAt        DateTime?             @map("archived_at") @db.Timestamptz(6)
  archiveBucket     String?               @map("archive_bucket")
  archiveKey        String?               @map("archive_key")
  // Vertrauliche Analyse: Wer keine Schreibrechte am Mandanten hat (also nur
  // eine einzelne Markierung zur Recherche zugewiesen bekam), sieht NICHT den
  // ganzen Sachverhalt, sondern ausschliesslich die ihm zugewiesenen
  // Textstellen. Setzen/Loesen darf nur, wer ohnehin schreiben darf.
  vertraulich       Boolean               @default(false)
  // Gesetzt, sobald die asynchrone LLM-Phase die Analyse angereichert hat.
  llmEnrichedAt     DateTime?             @map("llm_enriched_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "risk_analysis_client_fk")
  document          Document?             @relation("AnalysisSourceDoc", fields: [documentId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "risk_analysis_document_fk")
  markings          RiskMarking[]
  researchRequests  RiskResearchRequest[]
  workflowInstances WorkflowInstance[]
  documents         Document[]            @relation("AnalysisAttachedDocs")

  @@index([tenantId, clientId])
  @@index([tenantId, documentId])
  @@index([tenantId, createdAt])
  @@map("risk_analysis")
}

/// Eine erkannte ODER berater-gesetzte Stelle im analysierten Text. Trägt
/// Verortung, Provenienz (Vertrauensstufe), die erstklassigen TCMS-Felder
/// (normAnker/normketten + Governance-Matrix) und den Bearbeitungs-Status.
/// Delegation („Recherche") verweist auf eine interne Wiedervorlage
/// (ClientReminder, NICHT mandantengerichteter Request) — kein eigener
/// Aufgaben-Store. `verantwortlichId` ist eine reine Mitarbeiter-UUID (kein FK).
model RiskMarking {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  analysisId          String                @map("analysis_id") @db.Uuid
  start               Int
  end                 Int
  matchedText         String                @map("matched_text")
  herkunft            RiskHerkunft
  // Detektionsstatus der Engine (treffer/luecke/kandidat/unknown_risiko); für
  // berater-gesetzte Markierungen `berater`. Treibt die Statistik-Leiste + Filter
  // (zählbar nach Berater-Edits, anders als die statische Engine-summary). Freier
  // Text, damit neue Engine-Status nicht an einem Enum scheitern.
  engineStatus        String?               @map("engine_status")
  // Aus `ist_streitig` der Engine: die Stelle ist fachlich umstritten.
  streitig            Boolean               @default(false)
  begriffId           String?               @map("begriff_id")
  begriff             String
  normAnker           String[]              @map("norm_anker")
  // Norm-Referenzen mit stabiler Engine-ID + Titel ([{zitat,id,titel}]). Die ID
  // löst über /v1/normgraph/aufloesen den Gesetzestext auf (Norm-Expandable im UI).
  // normAnker (Zitate) bleibt für Anzeige-Fallback + Recherche-Heuristik bestehen.
  normRefs            Json?                 @map("norm_refs")
  normketten          Json?
  // Nur Berater-Markierungen: frei gewählte Highlight-Farbe (Swatch) + Kategorie.
  farbe               String?
  label               String?
  governanceTyp       GovernanceTyp?        @map("governance_typ")
  schadensintensitaet RiskStufe?            @map("schadensintensitaet")
  wahrscheinlichkeit  RiskWk?               @map("wahrscheinlichkeit")
  kaskadenreichweite  Int?                  @map("kaskadenreichweite")
  kontrolle           String?
  verantwortlichId    String?               @map("verantwortlich_id") @db.Uuid
  status              RiskStatus            @default(OFFEN)
  notiz               String?
  reminderId          String?               @map("reminder_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analysis            RiskAnalysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  // Delegation = interne Wiedervorlage (NICHT mandantengerichteter Request —
  // der wäre im Portal sichtbar). assignee/„an" liegt auf verantwortlichId.
  reminder            ClientReminder?       @relation(fields: [reminderId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "risk_marking_reminder_fk")
  researchRequests    RiskResearchRequest[]
  researchResults     RiskResearchResult[]

  @@index([tenantId, analysisId])
  @@index([tenantId, status])
  @@index([tenantId, reminderId])
  @@map("risk_marking")
}

/// Ein an n8n relayter Rechercheauftrag zu einer Markierung. Der ausgehende
/// Payload ist ANONYMISIERT (§ 203 StGB) — `mapping` (Platzhalter→Original) wird
/// NIE an n8n gesendet, dient nur der De-Anonymisierung der Antwort und ist
/// daher sensibel (RLS-geschützt). Korrelation über die id (opaker Token).
model RiskResearchRequest {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  analysisId         String                @map("analysis_id") @db.Uuid
  markingId          String?               @map("marking_id") @db.Uuid
  /// Titel der Recherche (auto "Recherche vom …" oder vom Berater vergeben).
  title              String?
  prompt             String?
  includeSachverhalt Boolean               @default(false) @map("include_sachverhalt")
  anonymizedPayload  Json                  @map("anonymized_payload")
  mapping            Json                  @map("mapping")
  status             ResearchRequestStatus @default(SENT)
  createdById        String                @map("created_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analysis           RiskAnalysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  marking            RiskMarking?          @relation(fields: [markingId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "risk_research_request_marking_fk")
  results            RiskResearchResult[]

  @@index([tenantId, analysisId])
  @@index([tenantId, markingId])
  @@map("risk_research_request")
}

/// Eine von n8n zurückgelieferte Recherche-Antwort. Landet in der Ablage
/// „Rechercheergebnisse"; via Korrelation (researchRequestId) automatisch einer
/// Markierung zugeordnet, sonst heuristisch vorgeschlagen. `body` ist bereits
/// de-anonymisiert (Platzhalter→Original aus dem mapping des Requests).
model RiskResearchResult {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  researchRequestId String?              @map("research_request_id") @db.Uuid
  markingId         String?              @map("marking_id") @db.Uuid
  shelfDocumentId   String?              @unique @map("shelf_document_id") @db.Uuid
  archivedAt        DateTime?            @map("archived_at") @db.Timestamptz(6)
  title             String?
  body              String
  source            String?
  status            ResearchResultStatus @default(NEU)
  receivedAt        DateTime             @default(now()) @map("received_at") @db.Timestamptz(6)
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request           RiskResearchRequest? @relation(fields: [researchRequestId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "risk_research_result_request_fk")
  marking           RiskMarking?         @relation(fields: [markingId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "risk_research_result_marking_fk")
  shelfDocument     Document?            @relation("ResearchResultShelfDocument", fields: [shelfDocumentId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "risk_research_result_shelf_document_fk")

  @@index([tenantId, status])
  @@index([tenantId, markingId])
  @@index([tenantId, researchRequestId])
  @@index([tenantId, archivedAt])
  @@map("risk_research_result")
}

/// Wiederverwendbare Prompt-Vorlage für Recherche-Aufträge (kanzleiweit). Wird im
/// Composer ausgewählt und füllt das Prompt-Feld. `createdById` ist — wie bei
/// RiskAnalysis — eine reine Mitarbeiter-UUID ohne FK.
model RiskPromptTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
