/// Journal für Storage-Objekte, deren nachgelagerter DB-Commit scheiterte oder
/// mehrdeutig quittiert wurde. Der Worker prueft nach einer Sicherheitsfrist
/// zuerst auf persistierte DocumentVersion-Referenzen. Nur echte Orphans werden
/// geloescht; Object-Lock-Objekte zudem erst nach Ablauf der Retention.
model StorageOrphan {
  id               String                   @id(map: "storage_orphan_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  source           String
  storageBucket    String                   @map("storage_bucket")
  storageKey       String                   @map("storage_key")
  storageVersionId String                   @default("") @map("storage_version_id")
  sha256           Bytes
  sizeBytes        BigInt                   @map("size_bytes")
  immutable        Boolean
  retentionUntil   DateTime?                @map("retention_until") @db.Timestamptz(6)
  failure          String?
  cleanupClaimedAt DateTime?                @map("cleanup_claimed_at") @db.Timestamptz(6)
  cleanupAttempts  Int                      @default(0) @map("cleanup_attempts")
  cleanupError     String?                  @map("cleanup_error")
  resolution       StorageOrphanResolution?
  cleanedAt        DateTime?                @map("cleaned_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "storage_orphan_tenant_fk")

  @@unique([storageBucket, storageKey, storageVersionId], map: "storage_orphan_object_uq")
  @@index([tenantId, cleanedAt, cleanupClaimedAt, createdAt], map: "storage_orphan_cleanup_idx")
  @@map("storage_orphan")
}

model GwgOnboardingInvite {
