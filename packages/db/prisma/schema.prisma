model Client {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                      @map("tenant_id") @db.Uuid
  kind                 ClientKind
  name                 String
  datevNo              String?                     @map("datev_no")
  allowActive          Boolean                     @default(false) @map("allow_active")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  street               String?
  postalCode           String?                     @map("postal_code")
  city                 String?
  countryIso           String?                     @map("country_iso")
  vatId                String?                     @map("vat_id")
  invoiceEmail         String?                     @map("invoice_email") @db.Citext
  addisonNo            String?                     @map("addison_no")
  priority             ClientPriority?             @map("priority")
  internalNotes        String?                     @map("internal_notes")
  // Zugriffs-Ventil: im OPEN-Zugriffsmodell (Default) dürfen alle aktiven
  // Mitarbeiter an jedem Mandanten arbeiten. Ein als `vertraulich` markierter
  // Mandant bleibt aber auf Admin/Partner + die zugeordneten Berufsträger/
  // Hauptbearbeiter beschränkt (Konflikt-/Geheimhaltungsfälle). Nur Admin/Partner
  // setzt das Flag. Siehe canAccessClient (rbac.ts) + access-policy.ts.
  vertraulich          Boolean                     @default(false) @map("vertraulich")
  // Mandatsende (GwG § 8 Abs. 4): die 5-Jahres-Aufbewahrungsfrist für GwG-Belege
  // beginnt mit dem Schluss des Kalenderjahres, in dem die Geschäftsbeziehung
  // endet. Gesetzt = Mandat beendet, startet die Löschuhr. Siehe server/gwg/
  // retention.ts + die GwG-Lösch-Review-Queue.
  mandateEndedAt       DateTime?                   @map("mandate_ended_at") @db.Timestamptz(6)
  // DSGVO Art. 17: Vernichtungsvermerk der Mandanten-Anonymisierung (Pendant zu
  // gwg_check.destroyed_at). Gesetzt = die personenbezogenen Stammdaten der
  // natürlichen Person wurden nach Ablauf ALLER Aufbewahrungsfristen (GoBD 10 J.,
  // GwG 5 J. — ab Jahresende des Mandatsendes, die längste gewinnt) anonymisiert;
  // der Datensatz ist nur noch ein Skelett. Siehe server/dsgvo/client-retention.ts
  // + die Review-Queue /staff/admin/dsgvo-retention.
  anonymizedAt         DateTime?                   @map("anonymized_at")
  appointments         Appointment[]
  appointmentRequests  AppointmentRequest[]
  bwaPeriods           BwaPeriod[]
  bwaPlans             BwaPlan[]
  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts             ClientContact[]
  customFieldValues    ClientCustomFieldValue[]
  handovers            ClientHandover[]
  masterChangeRequests ClientMasterChangeRequest[]
  reminders            ClientReminder[]
  responsibilities     ClientResponsibility[]
  documents            Document[]
  documentFolders      DocumentFolder[]
  formSubmissions      FormSubmission[]
  gwgChecks            GwgCheck[]
  gwgInvites           GwgOnboardingInvite[]
  invoices             Invoice[]
  pendingBinders       PendingBinder[]
  phoneNotes           PhoneNote[]
  poas                 PowerOfAttorney[]
  requests             Request[]
  riskAnalyses         RiskAnalysis[]
  taxDeadlines         TaxDeadline[]
  taxFilings           TaxFiling[]
  taxNotices           TaxNotice[]
  taxScheduleConfigs   TaxScheduleConfig[]
  workflowInstances    WorkflowInstance[]

  @@unique([tenantId, datevNo])
  @@index([tenantId])
  @@index([tenantId, priority], map: "client_tenant_priority_idx")
  // iter71: pg_trgm-GIN für die globale Suche (ILIKE '%q%' index-gestützt)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_name_trgm_idx")
  @@index([datevNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_datev_no_trgm_idx")
  @@index([addisonNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_addison_no_trgm_idx")
  @@index([vatId(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_vat_id_trgm_idx")
  @@map("client")
}

