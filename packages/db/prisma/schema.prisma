// =============================================================================
// taxtronik — Prisma-Schema
//
// Source-of-Truth für die Datenbank-Struktur und den Prisma-Client (Types).
// RLS-Policies, Audit-Trigger und GwG-Schranken-Trigger werden in der
// Migrations-SQL definiert (siehe prisma/migrations/.../migration.sql),
// weil Prisma diese nicht aus dem Schema ableiten kann.
//
// Schema ist drift-frei gegenüber den Migrationen — siehe
// `pnpm verify:schema-drift` und ADR 0012. Annotationen wie @db.Timestamptz
// und @relation(map:...) / @@index(map:...) wurden via `prisma db pull` aus
// der migrierten DB übernommen, damit die Drift-Check auch nicht-strukturelle
// Diffs (Constraint-Namen, Timestamp-TZ) abdeckt.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm, pgcrypto]
}

model Tenant {
  id                             String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                           String                           @unique
  name                           String
  createdAt                      DateTime                         @default(now()) @map("created_at")
  updatedAt                      DateTime                         @updatedAt @map("updated_at")
  appointments                   Appointment[]
  appointmentRequests            AppointmentRequest[]
  auditAnchors                   AuditAnchor[]
  auditLogs                      AuditLog[]
  auditSeals                     AuditSeal[]
  backupRecords                  BackupRecord[]
  bwaPeriods                     BwaPeriod[]
  bwaPlans                       BwaPlan[]
  clients                        Client[]
  clientContacts                 ClientContact[]
  clientCustomFieldDefs          ClientCustomFieldDef[]
  clientCustomFieldValues        ClientCustomFieldValue[]
  clientHandovers                ClientHandover[]
  clientConsents                 ClientConsent[]
  clientMasterChangeRequests     ClientMasterChangeRequest[]
  clientReminders                ClientReminder[]
  deadlineDailyReviews           DeadlineDailyReview[]
  documents                      Document[]
  documentFolders                DocumentFolder[]
  documentTypes                  DocumentType[]
  dsgvoRequests                  DsgvoRequest[]
  elsterKontoabfragen            ElsterKontoabfrage[]
  emailTemplates                 EmailTemplate[]
  formSubmissions                FormSubmission[]
  formTemplates                  FormTemplate[]
  gwgChecks                      GwgCheck[]
  gwgInvites                     GwgOnboardingInvite[]
  invoices                       Invoice[]
  invoiceCategories              InvoiceCategory[]
  invoiceNumberSeqs              InvoiceNumberSeq[]
  kbArticles                     KbArticle[]
  kbCategories                   KbCategory[]
  magicLinks                     MagicLink[]
  n8nConnection                  N8nConnection?
  n8nCallbackReceipts            N8nCallbackReceipt[]
  n8nDeliveries                  N8nDelivery[]
  n8nEventSubscriptions          N8nEventSubscription[]
  n8nOutbox                      N8nOutbox[]
  n8nWebhookEndpoints            N8nWebhookEndpoint[]
  notifications                  Notification[]
  pendingBinders                 PendingBinder[]
  phoneNotes                     PhoneNote[]
  poas                           PowerOfAttorney[]
  requests                       Request[]
  requestTemplates               RequestTemplate[]
  riskAnalyses                   RiskAnalysis[]
  riskMarkings                   RiskMarking[]
  riskResearchRequests           RiskResearchRequest[]
  riskResearchResults            RiskResearchResult[]
  riskPromptTemplates            RiskPromptTemplate[]
  rssFeeds                       RssFeed[]
  serviceProviders               ServiceProvider[]
  storageOrphans                 StorageOrphan[]
  staffBookmarks                 StaffBookmark[]
  staffNotes                     StaffNote[]
  staffSkills                    StaffSkill[]
  staff                          StaffUser[]
  taxDeadlines                   TaxDeadline[]
  taxDeadlineNotificationHistory TaxDeadlineNotificationHistory[]
  taxFilings                     TaxFiling[]
  taxNotices                     TaxNotice[]
  taxScheduleConfigs             TaxScheduleConfig[]
  settings                       TenantSetting[]
  workflowInstances              WorkflowInstance[]
  workflowN8nDispatches          WorkflowN8nDispatch[]
  workflowTemplates              WorkflowTemplate[]
  clientReminderNotes            ClientReminderNote[]

  @@map("tenant")
}

model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_setting")
}

model StaffUser {
  id                           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                     String                      @map("tenant_id") @db.Uuid
  email                        String                      @db.Citext
  fullName                     String                      @map("full_name")
  passwordHash                 String                      @map("password_hash")
  totpSecretEnc                String?                     @map("totp_secret_enc")
  totpEnrolledAt               DateTime?                   @map("totp_enrolled_at")
  // M-3: Setup-Fenster-TTL. Wird beim ersten Secret-Set gesetzt; nach 60 min
  // ohne Confirm wird der Setup-Versuch abgelehnt.
  totpSetupStartedAt           DateTime?                   @map("totp_setup_started_at")
  totpBackupCodes              Json?                       @map("totp_backup_codes")
  active                       Boolean                     @default(true)
  lockedUntil                  DateTime?                   @map("locked_until")
  lastLoginAt                  DateTime?                   @map("last_login_at")
  createdAt                    DateTime                    @default(now()) @map("created_at")
  updatedAt                    DateTime                    @updatedAt @map("updated_at")
  dashboardLayout              Json?                       @map("dashboard_layout")
  taxNewsNotify                Boolean                     @default(false) @map("tax_news_notify")
  /// Benachrichtigungs-Modus fuer Wiedervorlagen-Aktivitaet (Chat, Uploads,
  /// Nachfassen). Zuweisungen, Faelligkeiten und @-Erwaehnungen kommen IMMER
  /// durch — die sind Arbeitsauftrag bzw. gezielte Ansprache, kein Rauschen.
  reminderNotifyMode           ReminderNotifyMode          @default(ALL) @map("reminder_notify_mode")
  failedLoginCount             Int                         @default(0) @map("failed_login_count")
  appointmentsCreated          Appointment[]               @relation("appointment_creator")
  appointmentsOwned            Appointment[]               @relation("appointment_owner")
  appointmentRequestsDecided   AppointmentRequest[]        @relation("appointment_request_decided")
  appointmentRequestsPreferred AppointmentRequest[]        @relation("appointment_request_preferred")
  client_handover              ClientHandover[]
  client_master_change_request ClientMasterChangeRequest[]
  responsibilities             ClientResponsibility[]
  notifications                Notification[]
  phone_note                   PhoneNote[]
  rssFeeds                     RssFeed[]
  absences                     Absence[]
  bookmarks                    StaffBookmark[]
  notes                        StaffNote[]
  roles                        StaffRole[]
  permissions                  StaffPermission[]
  skillAssignments             StaffSkillAssignment[]
  tenant                       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeEntries                  TimeEntry[]
  vacationRequests             VacationRequest[]
  reminderAssignments          ClientReminderAssignee[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("staff_user")
}

model VacationRequest {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  staffId      String         @map("staff_id") @db.Uuid
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime       @map("end_date") @db.Date
  workdays     Int
  reason       String?
  status       VacationStatus @default(PENDING)
  decidedBy    String?        @map("decided_by") @db.Uuid
  decidedAt    DateTime?      @map("decided_at")
  decisionNote String?        @map("decision_note")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  staff        StaffUser      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, startDate])
  @@index([tenantId, status])
  @@map("vacation_request")
}

// iter87: generalisiert aus SickLeave — eine Meldung je Abwesenheit. `kind`
// unterscheidet Krankheit von sonstigen Abwesenheiten (Fortbildung etc.);
// `notes` (Grund) ist vertraulich: sichtbar nur für die meldende Person und
// Entscheidungsträger (ABSENCE_DECIDE bzw. Admin/Partner). Kalender zeigen
// nur „abw." ohne Art/Grund.
model Absence {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  staffId    String      @map("staff_id") @db.Uuid
  kind       AbsenceKind @default(SICKNESS)
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime?   @map("end_date") @db.Date
  documentId String?     @map("document_id") @db.Uuid
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  document   Document?   @relation(fields: [documentId], references: [id])
  staff      StaffUser   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, startDate])
  @@index([tenantId, documentId])
  @@map("absence")
}

model GwgCheck {
  id                         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String                @map("tenant_id") @db.Uuid
  clientId                   String                @map("client_id") @db.Uuid
  status                     GwgStatus             @default(DRAFT)
  changeScope                GwgChangeScope        @default(INITIAL) @map("change_scope")
  predecessorCheckId         String?               @map("predecessor_check_id") @db.Uuid
  riskLevel                  GwgRiskLevel?         @map("risk_level")
  riskScore                  Int?                  @map("risk_score")
  riskBreakdown              Json?                 @map("risk_breakdown")
  riskAnswers                Json?                 @map("risk_answers")
  validUntil                 DateTime?             @map("valid_until")
  verifiedAt                 DateTime?             @map("verified_at")
  verifiedBy                 String?               @map("verified_by") @db.Uuid
  rejectedReason             String?               @map("rejected_reason")
  notes                      String?
  /// Snapshot der Identifizierungsangaben juristischer Personen/
  /// Personengesellschaften (§ 11 Abs. 4 Nr. 2 GwG). Die Angaben leben am
  /// Check statt am Client, damit eine abgeschlossene Prüfung unverändert
  /// erhalten bleibt und eine Wiederholungsprüfung einen neuen Snapshot erhält.
  legalForm                  String?               @map("legal_form")
  registerNumber             String?               @map("register_number")
  registerAuthority          String?               @map("register_authority")
  noRegisterEntry            Boolean               @default(false) @map("no_register_entry")
  representativeNames        String[]              @default([]) @map("representative_names")
  ownershipStructureNotes    String?               @map("ownership_structure_notes")
  /// Nur bereits vor Einfuehrung der stabilen 1:1-Identitaetszuordnung
  /// verifizierte Bestandschecks werden durch die Migration auf false gesetzt.
  /// Neue und offene Checks bleiben fail-closed und muessen vor VERIFIED eine
  /// explizit bestaetigte Subject-Fremdschluessel-Zuordnung besitzen.
  identityAssignmentRequired Boolean               @default(true) @map("identity_assignment_required")
  /// Explizite Übergabe der durch Mitarbeitende vorbereiteten Prüfung an den
  /// verantwortlichen Berufsträger. DRAFT bleibt während der Bearbeitung;
  /// IN_REVIEW beginnt erst mit dieser nachvollziehbaren Übergabe.
  reviewSubmittedAt          DateTime?             @map("review_submitted_at") @db.Timestamptz(6)
  reviewSubmittedBy          String?               @map("review_submitted_by") @db.Uuid
  /// GwG § 8 Abs. 1 und 4 (iter81): Vernichtungsvermerk. Gesetzt, wenn die
  /// Aufzeichnungen des Checks vernichtet wurden (Berechtigte gelöscht,
  /// Ausweis-Details genullt, riskAnswers/notes entfernt). Der Skelett-
  /// Datensatz bleibt als Nachweis, DASS geprüft wurde.
  destroyedAt                DateTime?             @map("destroyed_at")
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")
  beneficialOwners           GwgBeneficialOwner[]
  representatives            GwgRepresentative[]
  // RF-15 (iter79): NoAction statt Cascade — ein Client-Hard-Delete darf
  // GwG-Akten (5-Jahres-Pflicht, § 8 GwG) nicht mitlöschen. NoAction (statt
  // Restrict), damit die Tenant-Kaskade weiterhin funktioniert.
  client                     Client                @relation(fields: [clientId], references: [id], onDelete: NoAction)
  tenant                     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idDocuments                GwgIdDocument[]
  onboardingInvites          GwgOnboardingInvite[]
  predecessor                GwgCheck?             @relation("gwg_check_lineage", fields: [predecessorCheckId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "gwg_check_predecessor_fkey")
  successors                 GwgCheck[]            @relation("gwg_check_lineage")

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([predecessorCheckId])
  @@map("gwg_check")
}

model GwgIdDocument {
  id                            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gwgCheckId                    String              @map("gwg_check_id") @db.Uuid
  type                          GwgIdDocumentType
  ownerName                     String              @map("owner_name")
  documentId                    String?             @map("document_id") @db.Uuid
  /// Persistente Gruppe fuer zusammengehoerige Dateien, beispielsweise
  /// Vorder- und Rueckseite desselben Ausweises. Legacy-Zeilen erhalten je
  /// eine eigene Gruppe und werden nie heuristisch zusammengefuehrt.
  documentSetId                 String              @default(dbgenerated("gen_random_uuid()")) @map("document_set_id") @db.Uuid
  /// Echte 1:1-Zuordnung: genau hoechstens eine der drei Subject-Referenzen
  /// darf gesetzt sein. ownerName bleibt nur der unveraenderliche Anzeigesnapshot.
  naturalClientSubjectId        String?             @map("natural_client_subject_id") @db.Uuid
  beneficialOwnerSubjectId      String?             @map("beneficial_owner_subject_id") @db.Uuid
  representativeSubjectId       String?             @map("representative_subject_id") @db.Uuid
  identityAssignmentConfirmedAt DateTime?           @map("identity_assignment_confirmed_at") @db.Timestamptz(6)
  identityAssignmentConfirmedBy String?             @map("identity_assignment_confirmed_by") @db.Uuid
  number                        String?
  issuedBy                      String?             @map("issued_by")
  issueDate                     DateTime?           @map("issue_date") @db.Date
  expiryDate                    DateTime?           @map("expiry_date") @db.Date
  verifiedAt                    DateTime?           @map("verified_at")
  notes                         String?
  createdAt                     DateTime            @default(now()) @map("created_at")
  document                      Document?           @relation(fields: [documentId], references: [id])
  check                         GwgCheck            @relation(fields: [gwgCheckId], references: [id], onDelete: Cascade)
  naturalClientSubject          Client?             @relation("gwg_natural_client_subject", fields: [naturalClientSubjectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  beneficialOwnerSubject        GwgBeneficialOwner? @relation(fields: [beneficialOwnerSubjectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  representativeSubject         GwgRepresentative?  @relation(fields: [representativeSubjectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  linkedRequests                Request[]

  // PostgreSQL erlaubt mehrere NULL-Werte: Ein konkreter Aktenbeleg kann je
  // Check aber nur genau einem Ausweissatz/Nachweis zugeordnet sein.
  @@unique([gwgCheckId, documentId])
  @@index([gwgCheckId])
  @@index([gwgCheckId, documentSetId])
  @@index([documentId])
  @@index([naturalClientSubjectId])
  @@index([beneficialOwnerSubjectId])
  @@index([representativeSubjectId])
  @@map("gwg_id_document")
}

/// Stabil identifizierbarer Vertreter im Snapshot einer GwG-Pruefung.
/// `representativeNames` bleibt vorerst als Legacy-/Anzeige-Snapshot bestehen;
/// neue Identitaetszuordnungen referenzieren ausschliesslich diese UUID.
model GwgRepresentative {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gwgCheckId              String              @map("gwg_check_id") @db.Uuid
  fullName                String              @map("full_name")
  position                Int
  /// Explizite Rollenidentität: derselbe Mensch kann Vertreter und zugleich
  /// wirtschaftlich Berechtigter sein. Keine heuristische Namensverknüpfung.
  linkedBeneficialOwnerId String?             @map("linked_beneficial_owner_id") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  check                   GwgCheck            @relation(fields: [gwgCheckId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  linkedBeneficialOwner   GwgBeneficialOwner? @relation("gwg_owner_representative_identity", fields: [linkedBeneficialOwnerId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "gwg_representative_linked_owner_fk")
  idDocuments             GwgIdDocument[]

  // Homonyme Vertreter sind fachlich verschiedene Personen und behalten
  // deshalb getrennte UUIDs. Die Position bildet nur die stabile Reihenfolge.
  @@unique([gwgCheckId, position])
  @@unique([gwgCheckId, linkedBeneficialOwnerId], map: "gwg_representative_owner_identity_uq")
  @@index([gwgCheckId])
  @@index([linkedBeneficialOwnerId])
  @@map("gwg_representative")
}

model GwgBeneficialOwner {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gwgCheckId          String              @map("gwg_check_id") @db.Uuid
  fullName            String              @map("full_name")
  birthDate           DateTime?           @map("birth_date") @db.Date
  birthPlace          String?             @map("birth_place")
  residence           String?
  nationality         String?
  ownershipPct        Decimal?            @map("ownership_pct") @db.Decimal(5, 2)
  isPep               Boolean             @default(false) @map("is_pep")
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at")
  check               GwgCheck            @relation(fields: [gwgCheckId], references: [id], onDelete: Cascade)
  idDocuments         GwgIdDocument[]
  representativeRoles GwgRepresentative[] @relation("gwg_owner_representative_identity")

  @@index([gwgCheckId])
  @@map("gwg_beneficial_owner")
}

model ServiceProvider {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  category         String
  hasDataAccess    Boolean   @default(false) @map("has_data_access")
  contactEmail     String?   @map("contact_email")
  contractFromDate DateTime? @map("contract_from_date") @db.Date
  contractToDate   DateTime? @map("contract_to_date") @db.Date
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("service_provider")
}

model PowerOfAttorney {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  clientId                 String    @map("client_id") @db.Uuid
  signerContactId          String?   @map("signer_contact_id") @db.Uuid
  signerEmail              String    @map("signer_email") @db.Citext
  signerName               String    @map("signer_name")
  subject                  String
  scope                    String
  validFrom                DateTime  @map("valid_from") @db.Date
  validUntil               DateTime? @map("valid_until") @db.Date
  status                   PoaStatus @default(DRAFT)
  /// DB-seitig gesetzter Zeitpunkt des ersten beweisgebundenen Versands.
  sentAt                   DateTime? @map("sent_at") @db.Timestamptz(6)
  signingTokenHash         String?   @map("signing_token_hash")
  signingTokenExpiresAt    DateTime? @map("signing_token_expires_at")
  signingOtpHash           String?   @map("signing_otp_hash")
  signingOtpExpiresAt      DateTime? @map("signing_otp_expires_at")
  signedAt                 DateTime? @map("signed_at")
  signedByIp               String?   @map("signed_by_ip") @db.Inet
  signedByUserAgent        String?   @map("signed_by_user_agent")
  // SHA-256 des beim Versand erzeugten Inhalts-Manifests plus Referenz auf die
  // konkret bestätigte Dokumentversion. Beim Signieren aus dem verifizierten
  // Versand-Snapshot übernommen.
  signedContentSha256      Bytes?    @map("signed_content_sha256")
  signedDocumentVersionId  String?   @map("signed_document_version_id") @db.Uuid
  // Unveränderlicher Versand-Snapshot. Die Signaturseite und der öffentliche
  // PDF-Endpunkt verwenden ausschließlich diese Fassung; beim Abschluss wird
  // ihr Hash in signedContentSha256 übernommen.
  signingContentSnapshot   String?   @map("signing_content_snapshot")
  signingContentSha256     Bytes?    @map("signing_content_sha256")
  signingDocumentVersionId String?   @map("signing_document_version_id") @db.Uuid
  documentId               String?   @map("document_id") @db.Uuid
  createdByStaff           String    @map("created_by_staff") @db.Uuid
  revokedAt                DateTime? @map("revoked_at")
  revokedReason            String?   @map("revoked_reason")
  /// Muss vom PostgreSQL-Server stammen: Prisma materialisiert `now()` sonst
  /// clientseitig, wodurch geringe Host-/DB-Uhrabweichungen sent_at < created_at erzeugen.
  createdAt                DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  signingOtpAttempts       Int       @default(0) @map("signing_otp_attempts")
  // Audit 2026-06 Befund 2: lebenszyklus-weiter Fehlversuchszähler. Anders als
  // signingOtpAttempts wird er beim OTP-Re-Issue NICHT zurückgesetzt — nur beim
  // Versand eines neuen Signatur-Tokens (sendForSignatureAction). Deckelt die
  // Gesamtversuche pro Token-Lebenszyklus (vorher ~50 über Re-Issue-Resets).
  signingOtpAttemptsTotal  Int       @default(0) @map("signing_otp_attempts_total")
  // RF-15 (iter79): NoAction statt Cascade — signierte Vollmachten dürfen
  // einen Client-Hard-Delete nicht mitsterben (Aufbewahrung/Beweiswert).
  client                   Client    @relation(fields: [clientId], references: [id], onDelete: NoAction)
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([signingTokenHash])
  @@map("power_of_attorney")
}

model N8nOutbox {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?         @map("tenant_id") @db.Uuid
  event       String
  payload     Json
  occurredAt  DateTime        @default(now()) @map("occurred_at")
  attempts    Int             @default(0)
  status      N8nOutboxStatus @default(PENDING)
  lastError   String?         @map("last_error")
  deliveredAt DateTime?       @map("delivered_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  dedupeKey   String?         @unique(map: "n8n_outbox_dedupe_key_uq") @map("dedupe_key") @db.VarChar(200)
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries  N8nDelivery[]

  @@index([status, createdAt])
  @@index([status, updatedAt], map: "n8n_outbox_status_updated_idx")
  @@index([tenantId])
  @@map("n8n_outbox")
}

/// Eine tenant-spezifische n8n-Instanz. `tenantId` ist unique: im ersten
/// Release gibt es genau eine Sicherheits-/API-Domäne pro Kanzlei. Mehrere
/// konkrete Workflow-Webhooks hängen als benannte Endpoints darunter.
model N8nConnection {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String               @unique(map: "n8n_connection_tenant_id_key") @map("tenant_id") @db.Uuid
  name                   String
  kind                   N8nConnectionKind    @default(BUNDLED)
  routingMode            N8nRoutingMode       @default(LEGACY) @map("routing_mode")
  uiBaseUrl              String?              @map("ui_base_url")
  apiBaseUrl             String?              @map("api_base_url")
  webhookBaseUrl         String?              @map("webhook_base_url")
  callbackBaseUrl        String?              @map("callback_base_url")
  apiKeyEncrypted        String?              @map("api_key_encrypted")
  signingSecretEncrypted String?              @map("signing_secret_encrypted")
  callbackKeyId          String               @unique(map: "n8n_connection_callback_key_id_key") @default(dbgenerated("gen_random_uuid()")) @map("callback_key_id") @db.Uuid
  callbackTokenHash      String?              @map("callback_token_hash")
  callbackScopes         String[]             @default([]) @map("callback_scopes")
