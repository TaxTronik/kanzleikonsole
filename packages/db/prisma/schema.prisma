model TaxNotice {
  id                                        String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                                  String                                @map("tenant_id") @db.Uuid
  clientId                                  String                                @map("client_id") @db.Uuid
  kind                                      TaxNoticeKind
  period                                    String
  noticeDate                                DateTime                              @map("notice_date") @db.Date
  /// Fachliche Bedeutung von noticeDate. Altbestand bleibt ausdrücklich
  /// ungeprüft; ein Bescheiddatum darf nur als interner Risikotermin dienen.
  dateBasis                                 TaxNoticeDateBasis                    @default(LEGACY_UNVERIFIED) @map("date_basis")
  /// Post (Inland/Ausland), elektronische Übermittlung und Datenabruf nutzen
  /// die jeweilige Bekanntgabefiktion; die übrigen Wege brauchen den rechtlich
  /// maßgeblichen Bekanntgabetag in receivedAt. Bei DATA_RETRIEVAL ist dies der
  /// Bereitstellungstag; die historische Benachrichtigung steht separat.
  deliveryMethod                            String                                @default("POST") @map("delivery_method")
  deliveryEvidenceStatus                    TaxNoticeEvidenceStatus               @default(CLAIMED) @map("delivery_evidence_status")
  deliveryEvidenceNote                      String?                               @map("delivery_evidence_note")
  legalRemedyInstructionValid               Boolean                               @default(true) @map("legal_remedy_instruction_valid")
  legalRemedyInstructionStatus              TaxNoticeLegalRemedyInstructionStatus @default(UNKLAR) @map("legal_remedy_instruction_status")
  legalRemedyInstructionNote                String?                               @map("legal_remedy_instruction_note")
  /// Dokumentierter tatsächlicher Zugangstag. Ein früherer Eingang verkürzt
  /// die Fiktion nicht; ein späterer wird erst nach fachlicher Feststellung
  /// als Rechtsdatum verwendet.
  receivedAt                                DateTime?                             @map("received_at") @db.Date
  accessStatus                              TaxNoticeAccessStatus                 @default(UNCONTESTED) @map("access_status")
  accessEvidenceStatus                      TaxNoticeEvidenceStatus?              @map("access_evidence_status")
  accessEvidenceNote                        String?                               @map("access_evidence_note")
  recipientName                             String?                               @map("recipient_name")
  recipientCountryCode                      String                                @default("ZZ") @map("recipient_country_code") @db.VarChar(2)
  recipientRegion                           String?                               @map("recipient_region")
  recipientLocality                         String?                               @map("recipient_locality")
  recipientLocalHolidayDates                DateTime[]                            @default([]) @map("recipient_local_holiday_dates") @db.Date
  recipientBavariaAssumptionApplies         Boolean?                              @map("recipient_bavaria_assumption_applies")
  authorityName                             String?                               @map("authority_name")
  authorityCountryCode                      String                                @default("DE") @map("authority_country_code") @db.VarChar(2)
  authorityRegion                           String?                               @map("authority_region")
  authorityLocality                         String?                               @map("authority_locality")
  authorityLocalHolidayDates                DateTime[]                            @default([]) @map("authority_local_holiday_dates") @db.Date
  authorityBavariaAssumptionApplies         Boolean?                              @map("authority_bavaria_assumption_applies")
  recipientHolidayContextStatus             TaxNoticeHolidayContextStatus         @default(UNKNOWN) @map("recipient_holiday_context_status")
  authorityHolidayContextStatus             TaxNoticeHolidayContextStatus         @default(UNKNOWN) @map("authority_holiday_context_status")
  holidayContextNote                        String?                               @map("holiday_context_note")
  /// Erlass-/Bescheiddatum bei DATA_RETRIEVAL. Es entscheidet nach Art. 97
  /// § 28 Abs. 2 EGAO über § 122a AO a.F. oder die Neufassung ab 2026.
  retrievalIssuedAt                         DateTime?                             @map("retrieval_issued_at") @db.Date
  /// Versandtag der elektronischen Bereitstellungsbenachrichtigung nach
  /// § 122a Abs. 4 AO a.F.; für bis 31.12.2025 erlassene Bescheide erforderlich.
  retrievalNotificationDate                 DateTime?                             @map("retrieval_notification_date") @db.Date
  /// Nur für migrierten Altbestand: Das alte Modell kannte keinen separaten
  /// Erlass-/Benachrichtigungstag. true kennzeichnet, dass die vorhandene
  /// Altfälligkeit erhalten bleibt, ohne unbekannte Daten als Tatsache auszugeben.
  retrievalNotificationLegacyFallback       Boolean                               @default(false) @map("retrieval_notification_legacy_fallback")
  /// Kennzeichnet den altrechtlichen Ausnahmefall: Zugang der elektronischen
  /// Benachrichtigung ist bestritten oder wurde erst verspätet empfangen.
  retrievalNotificationDisputedOrLate       Boolean                               @default(false) @map("retrieval_notification_disputed_or_late")
  /// Tatsächlicher Abruftag; bei markiertem altrechtlichem Ausnahmefall ist er
  /// statt der Benachrichtigungsfiktion fristauslösend. Fehlt auch er, ist der
  /// Verwaltungsakt noch nicht bekanntgegeben und appealDeadline bleibt null.
  retrievedAt                               DateTime?                             @map("retrieved_at") @db.Date
  /// 2026 verlangt das konservative Produktmodell eine nachweisbare aktive
  /// Einwilligung; ab 2027 wird stattdessen ein Postantrag/Widerruf bewertet.
  retrievalConsentStatus                    TaxNoticeRetrievalConsentStatus       @default(NOT_APPLICABLE) @map("retrieval_consent_status")
  retrievalPostalRequestStatus              TaxNoticePostalRequestStatus          @default(NOT_APPLICABLE) @map("retrieval_postal_request_status")
  retrievalPostalRequestReceivedAt          DateTime?                             @map("retrieval_postal_request_received_at") @db.Date
  retrievalEligibility2027Status            TaxNoticeRetrievalEligibilityStatus   @default(NOT_APPLICABLE) @map("retrieval_eligibility_2027_status")
  retrievalNotificationStatus               TaxNoticeDeliveryNotificationStatus   @default(NOT_RECORDED) @map("retrieval_notification_status")
  retrievalReinstatementReviewRequired      Boolean                               @default(false) @map("retrieval_reinstatement_review_required")
  /// Von der Engine ermittelter Bekanntgabetag. Er wird getrennt vom
  /// Ausgangsdatum persistiert, damit jeder Rechenschritt prüfbar bleibt.
  calculatedNotificationDate                DateTime?                             @map("calculated_notification_date") @db.Date
  appealDeadline                            DateTime?                             @map("appeal_deadline") @db.Date
  internalRiskDeadline                      DateTime?                             @map("internal_risk_deadline") @db.Date
  /// Reines Vergleichsszenario für einen behaupteten späteren Zugang; niemals
  /// ohne fachliche Würdigung als Rechtsfrist ausgeben.
  alternativeClaimedAccessDeadline          DateTime?                             @map("alternative_claimed_access_deadline") @db.Date
  deadlineCalculationStatus                 TaxNoticeDeadlineCalculationStatus    @default(LEGACY_UNVERIFIED) @map("deadline_calculation_status")
  deadlineCalculationVersion                String?                               @map("deadline_calculation_version")
  manualReviewRequired                      Boolean                               @default(true) @map("manual_review_required")
  manualReviewReason                        String?                               @map("manual_review_reason")
  status                                    TaxNoticeStatus                       @default(NEU)
  fileNumber                                String?                               @map("file_number")
  assessedAmount                            Decimal?                              @map("assessed_amount") @db.Decimal(12, 2)
  prepaidAmount                             Decimal?                              @map("prepaid_amount") @db.Decimal(12, 2)
  refundAmount                              Decimal?                              @map("refund_amount") @db.Decimal(12, 2)
  payAmount                                 Decimal?                              @map("pay_amount") @db.Decimal(12, 2)
  expectedAmount                            Decimal?                              @map("expected_amount") @db.Decimal(12, 2)
  reviewNotes                               String?                               @map("review_notes")
  reviewedAt                                DateTime?                             @map("reviewed_at")
  reviewedBy                                String?                               @map("reviewed_by") @db.Uuid
  appealFiledAt                             DateTime?                             @map("appeal_filed_at")
  /// Person, die die fristwahrende Einspruchseinlegung dokumentiert hat.
  appealFiledBy                             String?                               @map("appeal_filed_by") @db.Uuid
  appealReason                              String?                               @map("appeal_reason")
  /// Bekanntgabetag des Teilabhilfebescheids und Person, die dieses
  /// Fachereignis dokumentiert hat. Der Nachweis bleibt bei Folgestatus erhalten.
  partialReliefReceivedAt                   DateTime?                             @map("partial_relief_received_at") @db.Date
  partialReliefReceivedBy                   String?                               @map("partial_relief_received_by") @db.Uuid
  appealResolvedAt                          DateTime?                             @map("appeal_resolved_at")
  /// Tatsächlicher Bekanntgabetag der Einspruchsentscheidung. Nur dieses
  /// Datum ist der belastbare Beginn der Klagefrist (§ 47 Abs. 1 FGO).
  appealDecisionReceivedAt                  DateTime?                             @map("appeal_decision_received_at") @db.Date
  appealDecisionLegalRemedyInstructionValid Boolean?                              @map("appeal_decision_legal_remedy_instruction_valid")
  /// Klagefrist zum FG (§ 47 Abs. 1 FGO, 1 Monat ab Bekanntgabe der
  /// Einspruchsentscheidung). Gesetzt beim Übergang nach ZURUECKGEWIESEN oder
  /// TEILEINSPRUCHSENTSCHEIDUNG; wird im Fristenkontrollbuch überwacht.
  klageDeadline                             DateTime?                             @map("klage_deadline") @db.Date
  /// #11: tatsächliche Klageeinreichung (wer/wann) — für den Fristenkontrollbuch-
  /// Erledigungsnachweis. Gesetzt beim Statuswechsel auf KLAGE; ersetzt die
  /// bisherige Behelfsnutzung von appealResolvedAt/reviewedBy.
  klageFiledAt                              DateTime?                             @map("klage_filed_at")
  klageFiledBy                              String?                               @map("klage_filed_by") @db.Uuid
  /// Abschluss ohne (weitere) Klage bzw. nach Abschluss des Rechtsbehelfswegs.
  /// Der Klagefrist-Nachweis bleibt daneben unverändert erhalten.
  legalFinalAt                              DateTime?                             @map("legal_final_at")
  legalFinalBy                              String?                               @map("legal_final_by") @db.Uuid
  /// Nachvollziehbare fachliche Abschlussentscheidung; der Status allein darf
  /// eine offene Einspruchs-/Klagefrist nicht schließen.
  legalFinalReason                          String?                               @map("legal_final_reason")
  documentId                                String?                               @map("document_id") @db.Uuid
  deadlineId                                String?                               @map("deadline_id") @db.Uuid
  createdByStaff                            String                                @map("created_by_staff") @db.Uuid
  createdAt                                 DateTime                              @default(now()) @map("created_at")
  updatedAt                                 DateTime                              @updatedAt @map("updated_at")
  filingId                                  String?                               @map("filing_id") @db.Uuid
  client                                    Client                                @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tax_notice_client_fkey")
  document                                  Document?                             @relation(fields: [documentId], references: [id], onUpdate: NoAction, map: "tax_notice_document_fkey")
  filing                                    TaxFiling?                            @relation("FilingNotices", fields: [filingId], references: [id], onUpdate: NoAction, map: "tax_notice_filing_fk")
  tenant                                    Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tax_notice_tenant_fkey")

  // Kein @@unique auf (tenant, client, kind, period): Änderungsbescheide (§§ 164,
  // 172 ff. AO) betreffen dieselbe Steuerart/Periode und lösen je eine eigene
  // Einspruchsfrist aus — mehrere Bescheide müssen erfassbar sein (1:n
  // Filing→Notices). Nicht-uniquer Index bleibt für den Lesepfad erhalten.
  @@index([tenantId, clientId, kind, period])
  @@index([tenantId, clientId])
  @@index([tenantId, status, appealDeadline])
  @@index([tenantId, documentId])
  @@map("tax_notice")
}

/// Unveränderbarer Tagesabschluss der zentralen Fristenkontrolle. Der Snapshot
/// schließt keine Fachfrist, sondern dokumentiert, welche fälligen/überfälligen
/// Einträge geprüft und welche offenen Risiken eskaliert wurden.
model DeadlineDailyReview {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  reviewDate      DateTime @map("review_date") @db.Date
  /// DB-seitiger Beginn der REPEATABLE-READ-Transaktion, deren konsistenten
  /// Lesestand entriesSnapshot dokumentiert. Ein Clientwert wird verworfen.
  snapshotAt      DateTime @default(dbgenerated("transaction_timestamp()")) @map("snapshot_at") @db.Timestamptz(6)
  reviewedAt      DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy      String   @map("reviewed_by") @db.Uuid
  openCount       Int      @map("open_count")
  overdueCount    Int      @map("overdue_count")
  dueTodayCount   Int      @map("due_today_count")
  escalationNote  String?  @map("escalation_note")
  entriesSnapshot Json     @map("entries_snapshot")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "deadline_daily_review_tenant_fk")

  @@unique([tenantId, reviewDate], map: "deadline_daily_review_tenant_date_key")
  @@index([tenantId, reviewDate(sort: Desc)], map: "deadline_daily_review_tenant_date_idx")
  @@map("deadline_daily_review")
}

/// ELSTER-Kontoabfrage-Vorgang (Stufe 2 über die eric-bridge). Jeder Abruf ist
/// ein Vorgang beim ELSTER-Server → Ergebnisse werden persistiert (Historie,
/// kein unnötiger Doppelabruf). Die Portalzertifikat-PIN wird NIE gespeichert.
model ElsterKontoabfrage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  /// I = Istbuchungen, O = offene Beträge, ZS = Sollstellungen.
  art             String
  /// Steuerart (ESt/KSt/USt/…) — null bei O-Abfrage.
  steuerart       String?
  /// ZS: vierstelliges Jahr; I: Wertstellungsdatum TTMMJJJJ.
  zeitraum        String?
  /// Explizit erklärter Echtfall (sonst Testmerker-Übertragung).
  echtfall        Boolean  @default(false)
  ok              Boolean
  returnCode      Int      @map("return_code")
  /// NutzdatenTicket der Bridge — Audit-/GoBD-Bezug zum ELSTER-Vorgang.
  nutzdatenTicket String?  @map("nutzdaten_ticket")
  /// Ergebnis-Payload der Bridge (ELSTER-Antwort), null bei Fehler.
  result          String?
  errorText       String?  @map("error_text")
  requestedBy     String   @map("requested_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "elster_kontoabfrage_client_fkey")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "elster_kontoabfrage_tenant_fkey")

  @@index([tenantId, clientId, createdAt])
  @@map("elster_kontoabfrage")
}

/// Datenschutz-Einwilligungen des Mandanten (DSGVO Art. 6/7 + § 11 StBerG).
/// Append-only Historie: jeder Datensatz ist ein vollständiger Snapshot des
/// Einwilligungsstands; der neueste je Mandant ist maßgeblich. Ein Widerruf
/// (Art. 7 Abs. 3 DSGVO) ist ein neuer Snapshot mit den zurückgezogenen
/// Optionen auf false. `noticeSnapshot` friert den EXAKT gezeigten Hinweistext
/// ein (Nachweis, welche Fassung der Mandant akzeptiert hat).
model ClientConsent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  /// Version des Standard-Hinweistextes (server/privacy/notice.ts).
  noticeVersion   Int      @map("notice_version")
  /// Gerenderter Volltext der Datenschutzhinweise (Teil A), den der Mandant
  /// gesehen/akzeptiert hat — inkl. Kanzlei-Angaben + Empfängerliste.
  noticeSnapshot  String   @map("notice_snapshot")
  /// Granulare freiwillige Einwilligungen (Teil B): Kommunikationskanäle,
  /// Marketing, benannte Dritte, Spezialdienstleister. Struktur:
  /// server/privacy/consent.ts (ConsentSelections).
  consents        Json
  /// Erfassungsquelle: STAFF (Kanzlei-seitig) oder PORTAL (Mandant selbst).
  source          String
  /// Name der unterzeichnenden vertretungsberechtigten Person (immer gesetzt).
  signedByName    String   @map("signed_by_name")
  /// Optional: verknüpfte Kontaktperson (bei Portal/bekanntem Kontakt).
  signedByContact String?  @map("signed_by_contact") @db.Uuid
  /// True, wenn dieser Snapshot ein (Teil-)Widerruf ist (für die Anzeige).
  isRevocation    Boolean  @default(false) @map("is_revocation")
  note            String?
  /// Staff-User, der es erfasst hat (null bei Portal-Selbsterfassung).
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_consent_client_fkey")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_consent_tenant_fkey")

  @@index([tenantId, clientId, createdAt])
  @@map("client_consent")
}

model StaffSkill {
