  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_reminder_note_tenant_fk")

  @@index([reminderId, createdAt], map: "client_reminder_note_reminder_idx")
  @@map("client_reminder_note")
}

