  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "n8n_event_subscription_tenant_fkey")
  endpoint   N8nWebhookEndpoint @relation(fields: [endpointId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "n8n_event_subscription_endpoint_fkey")

  @@unique([endpointId, event], map: "n8n_event_subscription_endpoint_event_key")
  @@index([tenantId, event, enabled], map: "n8n_event_subscription_route_idx")
  @@map("n8n_event_subscription")
}

/// Ein konkreter Zustellversuch eines Outbox-Events an genau einen Endpoint.
/// URL und Name sind Snapshots: spätere Endpoint-Änderungen dürfen bereits
/// eingeplante Events nicht unbemerkt an ein anderes Ziel umleiten.
model N8nDelivery {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String?             @map("tenant_id") @db.Uuid
  outboxId             String              @map("outbox_id") @db.Uuid
  endpointId           String?             @map("endpoint_id") @db.Uuid
  connectionIdSnapshot String?             @map("connection_id_snapshot") @db.Uuid
  endpointNameSnapshot String              @map("endpoint_name_snapshot")
  targetUrl            String?             @map("target_url")
  status               N8nDeliveryStatus   @default(PENDING)
  leaseToken           String?             @map("lease_token") @db.Uuid
  leaseExpiresAt       DateTime?           @map("lease_expires_at") @db.Timestamptz(6)
  attempts             Int                 @default(0)
  httpStatus           Int?                @map("http_status")
  latencyMs            Int?                @map("latency_ms")
  lastError            String?             @map("last_error")
  firstAttemptAt       DateTime?           @map("first_attempt_at") @db.Timestamptz(6)
  lastAttemptAt        DateTime?           @map("last_attempt_at") @db.Timestamptz(6)
  deliveredAt          DateTime?           @map("delivered_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "n8n_delivery_tenant_fkey")
  outbox               N8nOutbox           @relation(fields: [outboxId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "n8n_delivery_outbox_fkey")
  endpoint             N8nWebhookEndpoint? @relation(fields: [endpointId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: NoAction, map: "n8n_delivery_endpoint_fkey")

  @@unique([outboxId, endpointId], map: "n8n_delivery_outbox_endpoint_key")
  @@index([status, createdAt], map: "n8n_delivery_status_created_idx")
  @@index([status, leaseExpiresAt], map: "n8n_delivery_status_lease_idx")
  @@index([tenantId, createdAt], map: "n8n_delivery_tenant_created_idx")
  @@index([tenantId, status, createdAt, id], map: "n8n_delivery_tenant_status_created_id_idx")
  @@index([endpointId, status], map: "n8n_delivery_endpoint_status_idx")
  @@map("n8n_delivery")
}

