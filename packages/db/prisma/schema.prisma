model Client {
  id                      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String                      @map("tenant_id") @db.Uuid
  kind                    ClientKind
  name                    String
  datevNo                 String?                     @map("datev_no")
  allowActive             Boolean                     @default(false) @map("allow_active")
  /// Expliziter, historischer Abschluss des Erst-Onboardings. Der Zustand
  /// bleibt auch dann abgeschlossen, wenn später eine Wiederholungsprüfung
  /// oder ein Kontaktwechsel ansteht.
  onboardingCompletedAt   DateTime?                   @map("onboarding_completed_at") @db.Timestamptz(6)
  onboardingCompletedBy   String?                     @map("onboarding_completed_by") @db.Uuid
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  street                  String?
  postalCode              String?                     @map("postal_code")
  city                    String?
  countryIso              String?                     @map("country_iso")
  vatId                   String?                     @map("vat_id")
  /// Steuernummer im 13-stelligen ELSTER-Bundesformat — Basis der ELSTER-
  /// Kontoabfrage (Soll-/Iststellungen). EINE pro Mandant: Tochtergesellschaften/
  /// Betriebsstätten mit eigener StNr sind eigene Mandanten.
  steuernummer            String?                     @map("steuernummer")
  invoiceEmail            String?                     @map("invoice_email") @db.Citext
  addisonNo               String?                     @map("addison_no")
  priority                ClientPriority?             @map("priority")
  internalNotes           String?                     @map("internal_notes")
  // Zugriffs-Ventil: im OPEN-Zugriffsmodell (Default) dürfen alle aktiven
  // Mitarbeiter an jedem Mandanten arbeiten. Ein als `vertraulich` markierter
  // Mandant bleibt aber auf Admin/Partner + die zugeordneten Berufsträger/
  // Hauptbearbeiter beschränkt (Konflikt-/Geheimhaltungsfälle). Nur Admin/Partner
  // setzt das Flag. Siehe canAccessClient (rbac.ts) + access-policy.ts.
  vertraulich             Boolean                     @default(false) @map("vertraulich")
  // Mandatsende (GwG § 8 Abs. 4): die 5-Jahres-Aufbewahrungsfrist für GwG-Belege
  // beginnt mit dem Schluss des Kalenderjahres, in dem die Geschäftsbeziehung
  // endet. Gesetzt = Mandat beendet, startet die Löschuhr. Siehe server/gwg/
  // retention.ts + die GwG-Lösch-Review-Queue.
  mandateEndedAt          DateTime?                   @map("mandate_ended_at") @db.Timestamptz(6)
  // DSGVO Art. 17: Vernichtungsvermerk der Mandanten-Anonymisierung (Pendant zu
  // gwg_check.destroyed_at). Gesetzt = die personenbezogenen Stammdaten der
  // natürlichen Person wurden nach Ablauf ALLER Aufbewahrungsfristen (GoBD 10 J.,
  // GwG 5 J. — ab Jahresende des Mandatsendes, die längste gewinnt) anonymisiert;
  // der Datensatz ist nur noch ein Skelett. Siehe server/dsgvo/client-retention.ts
  // + die Review-Queue /staff/admin/dsgvo-retention.
  anonymizedAt            DateTime?                   @map("anonymized_at")
  // Letzter kontrollierter Retentionlauf für natürliche PoA-Unterzeichner von
  // JURPERS/PERSGES. Die Gesellschaft bleibt bestehen; nur die nach Fristablauf
  // nicht mehr erforderlichen Signer-/Snapshotdaten werden redigiert.
  poaSignerDataRedactedAt DateTime?                   @map("poa_signer_data_redacted_at") @db.Timestamptz(6)
  appointments            Appointment[]
  appointmentRequests     AppointmentRequest[]
  clientConsents          ClientConsent[]
  bwaPeriods              BwaPeriod[]
  bwaPlans                BwaPlan[]
  tenant                  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts                ClientContact[]
  customFieldValues       ClientCustomFieldValue[]
  handovers               ClientHandover[]
  masterChangeRequests    ClientMasterChangeRequest[]
  reminders               ClientReminder[]
  responsibilities        ClientResponsibility[]
  documents               Document[]
  documentFolders         DocumentFolder[]
  elsterKontoabfragen     ElsterKontoabfrage[]
  formSubmissions         FormSubmission[]
  gwgChecks               GwgCheck[]
  gwgIdentityDocuments    GwgIdDocument[]             @relation("gwg_natural_client_subject")
  gwgInvites              GwgOnboardingInvite[]
  invoices                Invoice[]
  notifications           Notification[]
  pendingBinders          PendingBinder[]
  phoneNotes              PhoneNote[]
  poas                    PowerOfAttorney[]
  requests                Request[]
  riskAnalyses            RiskAnalysis[]
  taxDeadlines            TaxDeadline[]
  taxFilings              TaxFiling[]
  taxNotices              TaxNotice[]
  taxScheduleConfigs      TaxScheduleConfig[]
  workflowInstances       WorkflowInstance[]

  @@unique([tenantId, datevNo])
  @@index([tenantId])
  @@index([tenantId, onboardingCompletedAt], map: "client_tenant_onboarding_completed_idx")
  @@index([tenantId, priority], map: "client_tenant_priority_idx")
  // iter71: pg_trgm-GIN für die globale Suche (ILIKE '%q%' index-gestützt)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_name_trgm_idx")
  @@index([datevNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_datev_no_trgm_idx")
  @@index([addisonNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_addison_no_trgm_idx")
  @@index([vatId(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_vat_id_trgm_idx")
  @@map("client")
}

/// Wiedervorlage: am Mandanten ein Datum + Stichwort hinterlegen. Erscheint
/// am fälligen Tag als Reminder im Dashboard. Klassiker des Steuerberater-
/// Tagesgeschäfts.
/// Interne Aufgabe/Wiedervorlage. `clientId` ist optional: eine Aufgabe muss
/// keinen Mandantenbezug haben (Kanzlei-Interna). Zuständige liegen in
/// `assignees` (mehrere möglich — EINE Aufgabe, wer abhakt, erledigt sie für
/// alle); `predecessor` verkettet Nachfragen zur vorigen Wiedervorlage.
model ClientReminder {
  id             String                   @id(map: "client_reminder_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  /// null = interne Aufgabe ohne Mandantenbezug.
  clientId       String?                  @map("client_id") @db.Uuid
  dueDate        DateTime                 @map("due_date") @db.Date
  subject        String
  notes          String?
  // Dringlichkeit — die delegierende Person kann sie nachtraeglich anheben
  // ("bumpen"), ohne die Wiedervorlage neu anzulegen. Gleiche Skala wie bei
  // Anforderungen, damit die Uebersichten dieselben Labels/Farben nutzen.
  priority       RequestPriority          @default(NORMAL)
  /// Vorgänger in der Kette (Nachfrage/Folgeauftrag). SET NULL, damit das
  /// Löschen einer alten Stufe die Folgestufe nicht mitreisst.
  predecessorId  String?                  @map("predecessor_id") @db.Uuid
  /// Optionale Herkunft: eine Telefonnotiz kann bewusst mehrere eigenständige
  /// Wiedervorlagen erzeugen. Kein Unique-Constraint auf diesem Fremdschlüssel.
  phoneNoteId    String?                  @map("phone_note_id") @db.Uuid
  createdByStaff String                   @map("created_by_staff") @db.Uuid
  doneAt         DateTime?                @map("done_at") @db.Timestamptz(6)
  doneByStaff    String?                  @map("done_by_staff") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  client         Client?                  @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_reminder_client_fk")
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_reminder_tenant_fk")
  predecessor    ClientReminder?          @relation("ReminderChain", fields: [predecessorId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "client_reminder_predecessor_fk")
  successors     ClientReminder[]         @relation("ReminderChain")
  phoneNote      PhoneNote?               @relation("PhoneNoteReminders", fields: [phoneNoteId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "client_reminder_phone_note_fk")
  assignees      ClientReminderAssignee[]
  discussion     ClientReminderNote[]
  attachments    Document[]               @relation("ReminderAttachments")
  riskMarkings   RiskMarking[]

  // Meine Wiedervorlagen (/staff/reminders): die "von mir delegiert"-Sicht
  // filtert auf createdByStaff — dafuer gab es bisher keinen Index.
  @@index([createdByStaff, doneAt], map: "client_reminder_creator_idx")
  @@index([tenantId, dueDate, doneAt], map: "client_reminder_due_idx")
  // iter72: deckt die Mandanten-Detailseite (where clientId, order doneAt,dueDate)
  // — bisher kein clientId-führender Index → Scan aller Tenant-Wiedervorlagen.
  @@index([clientId, doneAt, dueDate], map: "client_reminder_client_idx")
  @@index([predecessorId], map: "client_reminder_predecessor_idx")
  @@index([phoneNoteId], map: "client_reminder_phone_note_idx")
  @@map("client_reminder")
}

/// Zuständige einer Wiedervorlage. Mehrere möglich; die Aufgabe bleibt EINE —
/// wer abhakt, erledigt sie für alle. Ersetzt die frühere Einzelspalte
/// `assignee_staff_id` (eine Quelle statt zweier).
model ClientReminderAssignee {
  reminderId String         @map("reminder_id") @db.Uuid
  staffId    String         @map("staff_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  reminder   ClientReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_reminder_assignee_reminder_fk")
  staff      StaffUser      @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_reminder_assignee_staff_fk")

  @@id([reminderId, staffId], map: "client_reminder_assignee_pk")
  // "Was liegt bei mir": Einstieg über die Person, offene zuerst.
  @@index([staffId], map: "client_reminder_assignee_staff_idx")
  @@map("client_reminder_assignee")
}

/// Wortmeldung an einer Wiedervorlage — kurze Rückfragen ohne neue Frist.
