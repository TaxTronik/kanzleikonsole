    "asn1js": "^3.0.10",
    "pkijs": "^3.4.0"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
