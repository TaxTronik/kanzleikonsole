{
  "name": "@taxtronik/evidence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service.ts",
    "./canonical-json": "./src/canonical-json.ts",
    "./ports/timestamp": "./src/ports/timestamp.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
