{
  "name": "@taxtronik/evidence",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./archive": "./src/archive.ts",
    "./chain": "./src/chain.ts",
    "./service": "./src/service.ts",
    "./canonical-json": "./src/canonical-json.ts",
    "./ports/timestamp": "./src/ports/timestamp.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*-db.test.{ts,tsx}\"",
    "test:db": "vitest run --config vitest.db.config.ts",
    "verify": "tsx --env-file-if-exists=../../.env src/cli/verify.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@prisma/client": "7.9.1",
    "@taxtronik/db": "workspace:*",
    "@taxtronik/http-utils": "workspace:*",
    "asn1js": "^3.0.10",
    "pkijs": "^3.4.3"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "4.1.12"
  }
}
